draw site2_b1 width 0.06 line {51.625 -40.490 -47.272} (chain='C' and resno=62 and atomname='SD') color blue
draw site2_b2 width 0.06 line {51.625 -40.490 -47.272} (chain='C' and resno=63 and atomname='O') color blue
draw site2_b3 width 0.06 line {51.625 -40.490 -47.272} (chain='C' and resno=72 and atomname='O') color blue
draw site2_b4 width 0.06 line {51.625 -40.490 -47.272} (chain='C' and resno=64 and atomname='OE1') color blue
set echo site2_label {51.625 -40.490 -47.272}
