# 2QJB_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.230 A | donors C:GLN86:O;C:CYS87:O;C:ASP89:OD1;C:ARG88:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bvp RMSD 0.261 A | donors C:MET62:SD;C:ILE63:O;C:THR72:O;C:GLU64:OE1 | metals: cobalt,copper,manganese,nickel
# Site 3 (green): bva RMSD 0.406 A | donors C:GLN112:OE1;C:GLN109:O;C:TYR110:O;C:LEU111:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2QJB_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.230 A) ----
select (resno=86 or resno=87 or resno=88 or resno=89) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=86 or resno=87 or resno=88 or resno=89) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {49.802 -49.444 -52.931} color red
draw site1_b1 width 0.06 line {49.802 -49.444 -52.931} (chain='C' and resno=86 and atomname='O') color red
draw site1_b2 width 0.06 line {49.802 -49.444 -52.931} (chain='C' and resno=87 and atomname='O') color red
draw site1_b3 width 0.06 line {49.802 -49.444 -52.931} (chain='C' and resno=89 and atomname='OD1') color red
draw site1_b4 width 0.06 line {49.802 -49.444 -52.931} (chain='C' and resno=88 and atomname='O') color red
set echo site1_label {49.802 -49.444 -52.931}
echo pyv 0.230
color echo black
font echo 18

