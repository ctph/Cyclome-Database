# 4OM5_D: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.309 A | donors D:THR56:O;D:CYS54:O;D:ASN19:O;D:ASN55:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.376 A | donors D:PRO8:O;D:ASN4:O;D:ASN60:O;D:LEU6:O | metals: cobalt,copper,manganese,nickel,samarium

load "4OM5_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.309 A) ----
select (resno=19 or resno=54 or resno=55 or resno=56) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=19 or resno=54 or resno=55 or resno=56) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {8.305 28.980 14.591} color red
draw site1_b1 width 0.06 line {8.305 28.980 14.591} (chain='D' and resno=56 and atomname='O') color red
draw site1_b2 width 0.06 line {8.305 28.980 14.591} (chain='D' and resno=54 and atomname='O') color red
draw site1_b3 width 0.06 line {8.305 28.980 14.591} (chain='D' and resno=19 and atomname='O') color red
draw site1_b4 width 0.06 line {8.305 28.980 14.591} (chain='D' and resno=55 and atomname='O') color red
set echo site1_label {8.305 28.980 14.591}
echo pyv 0.309
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.376 A) ----
select (resno=4 or resno=6 or resno=8 or resno=60) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=6 or resno=8 or resno=60) and chain='D' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {18.444 24.399 19.173} color blue
draw site2_b1 width 0.06 line {18.444 24.399 19.173} (chain='D' and resno=8 and atomname='O') color blue
draw site2_b2 width 0.06 line {18.444 24.399 19.173} (chain='D' and resno=4 and atomname='O') color blue
draw site2_b3 width 0.06 line {18.444 24.399 19.173} (chain='D' and resno=60 and atomname='O') color blue
draw site2_b4 width 0.06 line {18.444 24.399 19.173} (chain='D' and resno=6 and atomname='O') color blue
set echo site2_label {18.444 24.399 19.173}
echo tet 0.376
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
