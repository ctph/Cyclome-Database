# 1YWH_M: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.162 A | donors M:CYS241:O;M:HIS160:NE2;M:MET219:O;M:MET219:SD | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): bva RMSD 0.182 A | donors M:SER245:OG;M:HIS251:NE2;M:GLY152:O;M:HIS249:NE2 | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1YWH_M.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.162 A) ----
select (resno=160 or resno=219 or resno=241) and chain='M'
wireframe 0.18
color wireframe cpk
select (resno=160 or resno=219 or resno=241) and chain='M' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {82.195 -11.782 -1.620} color red
draw site1_b1 width 0.06 line {82.195 -11.782 -1.620} (chain='M' and resno=241 and atomname='O') color red
draw site1_b2 width 0.06 line {82.195 -11.782 -1.620} (chain='M' and resno=160 and atomname='NE2') color red
draw site1_b3 width 0.06 line {82.195 -11.782 -1.620} (chain='M' and resno=219 and atomname='O') color red
draw site1_b4 width 0.06 line {82.195 -11.782 -1.620} (chain='M' and resno=219 and atomname='SD') color red
set echo site1_label {82.195 -11.782 -1.620}
echo tet 0.162
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.182 A) ----
select (resno=152 or resno=245 or resno=249 or resno=251) and chain='M'
wireframe 0.18
color wireframe cpk
select (resno=152 or resno=245 or resno=249 or resno=251) and chain='M' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {74.019 -1.237 2.281} color blue
draw site2_b1 width 0.06 line {74.019 -1.237 2.281} (chain='M' and resno=245 and atomname='OG') color blue
draw site2_b2 width 0.06 line {74.019 -1.237 2.281} (chain='M' and resno=251 and atomname='NE2') color blue
draw site2_b3 width 0.06 line {74.019 -1.237 2.281} (chain='M' and resno=152 and atomname='O') color blue
draw site2_b4 width 0.06 line {74.019 -1.237 2.281} (chain='M' and resno=249 and atomname='NE2') color blue
set echo site2_label {74.019 -1.237 2.281}
echo bva 0.182
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
