# 2H64_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.252 A | donors B:GLU64:OE1;B:THR72:OG1;B:ASP66:OD2;B:GLU65:O | metals: cobalt,copper,manganese,nickel

load "2H64_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.252 A) ----
select (resno=64 or resno=65 or resno=66 or resno=72) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=64 or resno=65 or resno=66 or resno=72) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-39.820 -38.425 42.446} color red
draw site1_b1 width 0.06 line {-39.820 -38.425 42.446} (chain='B' and resno=64 and atomname='OE1') color red
draw site1_b2 width 0.06 line {-39.820 -38.425 42.446} (chain='B' and resno=72 and atomname='OG1') color red
draw site1_b3 width 0.06 line {-39.820 -38.425 42.446} (chain='B' and resno=66 and atomname='OD2') color red
draw site1_b4 width 0.06 line {-39.820 -38.425 42.446} (chain='B' and resno=65 and atomname='O') color red
set echo site1_label {-39.820 -38.425 42.446}
echo bvp 0.252
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
