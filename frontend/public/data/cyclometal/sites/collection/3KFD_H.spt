# 3KFD_H: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.229 A | donors H:ASP92:OD2;H:SER114:OG;H:SER114:O;H:ASP92:O | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): pyv RMSD 0.264 A | donors H:VAL64:O;H:ALA63:O;H:MET100:SD;H:PHE111:O | metals: cobalt,copper,manganese,nickel

load "3KFD_H.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.229 A) ----
select (resno=92 or resno=114) and chain='H'
wireframe 0.18
color wireframe cpk
select (resno=92 or resno=114) and chain='H' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.303 -74.612 48.852} color red
draw site1_b1 width 0.06 line {-0.303 -74.612 48.852} (chain='H' and resno=92 and atomname='OD2') color red
draw site1_b2 width 0.06 line {-0.303 -74.612 48.852} (chain='H' and resno=114 and atomname='OG') color red
draw site1_b3 width 0.06 line {-0.303 -74.612 48.852} (chain='H' and resno=114 and atomname='O') color red
draw site1_b4 width 0.06 line {-0.303 -74.612 48.852} (chain='H' and resno=92 and atomname='O') color red
set echo site1_label {-0.303 -74.612 48.852}
echo tet 0.229
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.264 A) ----
select (resno=63 or resno=64 or resno=100 or resno=111) and chain='H'
wireframe 0.18
color wireframe cpk
select (resno=63 or resno=64 or resno=100 or resno=111) and chain='H' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {3.177 -84.218 52.067} color blue
draw site2_b1 width 0.06 line {3.177 -84.218 52.067} (chain='H' and resno=64 and atomname='O') color blue
draw site2_b2 width 0.06 line {3.177 -84.218 52.067} (chain='H' and resno=63 and atomname='O') color blue
draw site2_b3 width 0.06 line {3.177 -84.218 52.067} (chain='H' and resno=100 and atomname='SD') color blue
draw site2_b4 width 0.06 line {3.177 -84.218 52.067} (chain='H' and resno=111 and atomname='O') color blue
set echo site2_label {3.177 -84.218 52.067}
echo pyv 0.264
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
