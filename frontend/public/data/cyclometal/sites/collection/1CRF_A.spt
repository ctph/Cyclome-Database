# 1CRF_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.167 A | donors A:ASN60:OD1;A:ASN60:OXT;A:ASN55:O;A:ASN19:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bva RMSD 0.282 A | donors A:CYS54:O;A:ASN60:OD1;A:CYS59:O;A:ASN55:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1CRF_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.167 A) ----
select (resno=19 or resno=55 or resno=60) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=19 or resno=55 or resno=60) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {8.227 -4.092 -4.462} color red
draw site1_b1 width 0.06 line {8.227 -4.092 -4.462} (chain='A' and resno=60 and atomname='OD1') color red
draw site1_b2 width 0.06 line {8.227 -4.092 -4.462} (chain='A' and resno=60 and atomname='OXT') color red
draw site1_b3 width 0.06 line {8.227 -4.092 -4.462} (chain='A' and resno=55 and atomname='O') color red
draw site1_b4 width 0.06 line {8.227 -4.092 -4.462} (chain='A' and resno=19 and atomname='O') color red
set echo site1_label {8.227 -4.092 -4.462}
echo bvp 0.167
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.282 A) ----
select (resno=54 or resno=55 or resno=59 or resno=60) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=54 or resno=55 or resno=59 or resno=60) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {6.516 -3.216 -4.412} color blue
draw site2_b1 width 0.06 line {6.516 -3.216 -4.412} (chain='A' and resno=54 and atomname='O') color blue
draw site2_b2 width 0.06 line {6.516 -3.216 -4.412} (chain='A' and resno=60 and atomname='OD1') color blue
draw site2_b3 width 0.06 line {6.516 -3.216 -4.412} (chain='A' and resno=59 and atomname='O') color blue
draw site2_b4 width 0.06 line {6.516 -3.216 -4.412} (chain='A' and resno=55 and atomname='O') color blue
set echo site2_label {6.516 -3.216 -4.412}
echo bva 0.282
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
