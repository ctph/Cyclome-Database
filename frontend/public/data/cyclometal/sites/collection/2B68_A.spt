color wireframe red
draw site1_center sphere diameter 1.4 {10.405 -2.165 -12.993} color red
draw site1_b1 width 0.06 line {10.405 -2.165 -12.993} (chain='A' and resno=15 and atomname='O') color red
draw site1_b2 width 0.06 line {10.405 -2.165 -12.993} (chain='A' and resno=21 and atomname='O') color red
