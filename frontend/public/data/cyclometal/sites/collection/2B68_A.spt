load "2B68_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.385 A) ----
select (resno=12 or resno=15 or resno=20 or resno=21) and chain='A'
