color wireframe cpk
select (resno=33 or resno=36 or resno=38) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-12.952 6.321 -0.971} color red
draw site1_b1 width 0.06 line {-12.952 6.321 -0.971} (chain='B' and resno=38 and atomname='O') color red
draw site1_b2 width 0.06 line {-12.952 6.321 -0.971} (chain='B' and resno=36 and atomname='OG1') color red
draw site1_b3 width 0.06 line {-12.952 6.321 -0.971} (chain='B' and resno=33 and atomname='OD1') color red
draw site1_b4 width 0.06 line {-12.952 6.321 -0.971} (chain='B' and resno=36 and atomname='O') color red
set echo site1_label {-12.952 6.321 -0.971}
echo pyv 0.267
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
