# Site 1 (red): pyv RMSD 0.267 A | donors B:ASP38:O;B:THR36:OG1;B:ASN33:OD1;B:THR36:O | metals: cobalt,copper,manganese,nickel

load "6LSQ_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.267 A) ----
select (resno=33 or resno=36 or resno=38) and chain='B'
