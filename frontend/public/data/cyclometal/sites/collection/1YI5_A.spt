color wireframe blue
draw site2_center sphere diameter 1.4 {128.812 217.178 97.128} color blue
draw site2_b1 width 0.06 line {128.812 217.178 97.128} (chain='A' and resno=21 and atomname='OG1') color blue
draw site2_b2 width 0.06 line {128.812 217.178 97.128} (chain='A' and resno=25 and atomname='O') color blue
draw site2_b3 width 0.06 line {128.812 217.178 97.128} (chain='A' and resno=149 and atomname='O') color blue
draw site2_b4 width 0.06 line {128.812 217.178 97.128} (chain='A' and resno=20 and atomname='O') color blue
set echo site2_label {128.812 217.178 97.128}
echo pyv 0.285
color echo black
font echo 18

# ---- Site 3: tet (RMSD 0.421 A) ----
select (resno=145 or resno=150 or resno=191 or resno=193) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=145 or resno=150 or resno=191 or resno=193) and chain='A' and carbon
color wireframe green
draw site3_center sphere diameter 1.4 {118.063 216.085 100.080} color green
draw site3_b1 width 0.06 line {118.063 216.085 100.080} (chain='A' and resno=145 and atomname='O') color green
draw site3_b2 width 0.06 line {118.063 216.085 100.080} (chain='A' and resno=193 and atomname='O') color green
draw site3_b3 width 0.06 line {118.063 216.085 100.080} (chain='A' and resno=150 and atomname='O') color green
draw site3_b4 width 0.06 line {118.063 216.085 100.080} (chain='A' and resno=191 and atomname='O') color green
set echo site3_label {118.063 216.085 100.080}
