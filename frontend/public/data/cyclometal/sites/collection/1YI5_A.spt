# 1YI5_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.156 A | donors A:VAL197:O;A:GLU196:O;A:GLU196:OE2;A:SER198:OG | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.285 A | donors A:THR21:OG1;A:ARG25:O;A:GLU149:O;A:PRO20:O | metals: cobalt,copper,manganese,nickel
# Site 3 (green): tet RMSD 0.421 A | donors A:HIS145:O;A:GLU193:O;A:ILE150:O;A:ALA191:O | metals: cobalt,copper,manganese,nickel,samarium

load "1YI5_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.156 A) ----
select (resno=196 or resno=197 or resno=198) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=196 or resno=197 or resno=198) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {102.755 218.992 95.646} color red
draw site1_b1 width 0.06 line {102.755 218.992 95.646} (chain='A' and resno=197 and atomname='O') color red
draw site1_b2 width 0.06 line {102.755 218.992 95.646} (chain='A' and resno=196 and atomname='O') color red
draw site1_b3 width 0.06 line {102.755 218.992 95.646} (chain='A' and resno=196 and atomname='OE2') color red
draw site1_b4 width 0.06 line {102.755 218.992 95.646} (chain='A' and resno=198 and atomname='OG') color red
set echo site1_label {102.755 218.992 95.646}
echo bvp 0.156
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.285 A) ----
select (resno=20 or resno=21 or resno=25 or resno=149) and chain='A'
wireframe 0.18
color wireframe cpk
