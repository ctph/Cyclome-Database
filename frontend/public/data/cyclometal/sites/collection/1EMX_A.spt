# 1EMX_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.191 A | donors A:CYS22:O;A:LEU24:O;A:GLY9:O;A:TRP25:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1EMX_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.191 A) ----
select (resno=9 or resno=22 or resno=24 or resno=25) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=9 or resno=22 or resno=24 or resno=25) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-2.906 4.908 0.209} color red
draw site1_b1 width 0.06 line {-2.906 4.908 0.209} (chain='A' and resno=22 and atomname='O') color red
draw site1_b2 width 0.06 line {-2.906 4.908 0.209} (chain='A' and resno=24 and atomname='O') color red
draw site1_b3 width 0.06 line {-2.906 4.908 0.209} (chain='A' and resno=9 and atomname='O') color red
draw site1_b4 width 0.06 line {-2.906 4.908 0.209} (chain='A' and resno=25 and atomname='O') color red
set echo site1_label {-2.906 4.908 0.209}
echo bva 0.191
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
