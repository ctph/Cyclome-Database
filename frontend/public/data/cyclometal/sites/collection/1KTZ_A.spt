# 1KTZ_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.260 A | donors A:ASN14:OD1;A:ASN14:O;A:CYS16:SG;A:CYS15:O | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): pyv RMSD 0.349 A | donors A:GLU13:OE2;A:ASN14:O;A:CYS16:SG;A:ASN14:OD1 | metals: cobalt,copper,manganese,nickel

load "1KTZ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.260 A) ----
select (resno=14 or resno=15 or resno=16) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=14 or resno=15 or resno=16) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {39.018 88.537 105.085} color red
draw site1_b1 width 0.06 line {39.018 88.537 105.085} (chain='A' and resno=14 and atomname='OD1') color red
draw site1_b2 width 0.06 line {39.018 88.537 105.085} (chain='A' and resno=14 and atomname='O') color red
draw site1_b3 width 0.06 line {39.018 88.537 105.085} (chain='A' and resno=16 and atomname='SG') color red
draw site1_b4 width 0.06 line {39.018 88.537 105.085} (chain='A' and resno=15 and atomname='O') color red
set echo site1_label {39.018 88.537 105.085}
echo tet 0.260
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.349 A) ----
select (resno=13 or resno=14 or resno=16) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=13 or resno=14 or resno=16) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {39.707 90.123 103.674} color blue
draw site2_b1 width 0.06 line {39.707 90.123 103.674} (chain='A' and resno=13 and atomname='OE2') color blue
draw site2_b2 width 0.06 line {39.707 90.123 103.674} (chain='A' and resno=14 and atomname='O') color blue
draw site2_b3 width 0.06 line {39.707 90.123 103.674} (chain='A' and resno=16 and atomname='SG') color blue
draw site2_b4 width 0.06 line {39.707 90.123 103.674} (chain='A' and resno=14 and atomname='OD1') color blue
set echo site2_label {39.707 90.123 103.674}
echo pyv 0.349
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
