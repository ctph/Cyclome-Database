# 1OZZ_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.274 A | donors A:CYS42:O;A:GLU43:OE1;A:HIS31:ND1;A:ASP1:OD2 | metals: cobalt,copper,manganese,nickel

load "1OZZ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.274 A) ----
select (resno=1 or resno=31 or resno=42 or resno=43) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=1 or resno=31 or resno=42 or resno=43) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.765 -4.324 3.456} color red
draw site1_b1 width 0.06 line {4.765 -4.324 3.456} (chain='A' and resno=42 and atomname='O') color red
draw site1_b2 width 0.06 line {4.765 -4.324 3.456} (chain='A' and resno=43 and atomname='OE1') color red
draw site1_b3 width 0.06 line {4.765 -4.324 3.456} (chain='A' and resno=31 and atomname='ND1') color red
draw site1_b4 width 0.06 line {4.765 -4.324 3.456} (chain='A' and resno=1 and atomname='OD2') color red
set echo site1_label {4.765 -4.324 3.456}
echo pyv 0.274
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
