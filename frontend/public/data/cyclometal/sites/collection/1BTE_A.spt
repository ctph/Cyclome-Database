color wireframe red
draw site1_center sphere diameter 1.4 {12.814 37.184 9.759} color red
draw site1_b1 width 0.06 line {12.814 37.184 9.759} (chain='A' and resno=69 and atomname='O') color red
draw site1_b2 width 0.06 line {12.814 37.184 9.759} (chain='A' and resno=85 and atomname='O') color red
draw site1_b3 width 0.06 line {12.814 37.184 9.759} (chain='A' and resno=70 and atomname='O') color red
draw site1_b4 width 0.06 line {12.814 37.184 9.759} (chain='A' and resno=68 and atomname='O') color red
draw site1_b5 width 0.06 line {12.814 37.184 9.759} (chain='A' and resno=71 and atomname='O') color red
set echo site1_label {12.814 37.184 9.759}
