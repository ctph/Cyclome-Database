load "1BTE_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tpv (RMSD 0.372 A) ----
select (resno=68 or resno=69 or resno=70 or resno=71 or resno=85) and chain='A'
