# Site 1 (red): tet RMSD 0.437 A | donors A:VAL13:O;A:ILE6:O;A:LYS8:O;A:TYR14:OH | metals: cobalt,copper,manganese,nickel,samarium

load "1SN4_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.437 A) ----
select (resno=6 or resno=8 or resno=13 or resno=14) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=8 or resno=13 or resno=14) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {12.840 14.437 16.727} color red
draw site1_b1 width 0.06 line {12.840 14.437 16.727} (chain='A' and resno=13 and atomname='O') color red
draw site1_b2 width 0.06 line {12.840 14.437 16.727} (chain='A' and resno=6 and atomname='O') color red
draw site1_b3 width 0.06 line {12.840 14.437 16.727} (chain='A' and resno=8 and atomname='O') color red
draw site1_b4 width 0.06 line {12.840 14.437 16.727} (chain='A' and resno=14 and atomname='OH') color red
set echo site1_label {12.840 14.437 16.727}
echo tet 0.437
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
