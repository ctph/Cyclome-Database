# 4ABJ_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.229 A | donors A:MET183:SD;A:ASN182:O;A:THR230:OG1;A:LEU104:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tpv RMSD 0.467 A | donors A:SER115:O;A:GLN56:OE1;A:SER55:O;A:LEU113:O;A:GLN56:O | metals: cobalt,copper,manganese

load "4ABJ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.229 A) ----
select (resno=104 or resno=182 or resno=183 or resno=230) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=104 or resno=182 or resno=183 or resno=230) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {10.460 -10.431 5.587} color red
draw site1_b1 width 0.06 line {10.460 -10.431 5.587} (chain='A' and resno=183 and atomname='SD') color red
draw site1_b2 width 0.06 line {10.460 -10.431 5.587} (chain='A' and resno=182 and atomname='O') color red
draw site1_b3 width 0.06 line {10.460 -10.431 5.587} (chain='A' and resno=230 and atomname='OG1') color red
draw site1_b4 width 0.06 line {10.460 -10.431 5.587} (chain='A' and resno=104 and atomname='O') color red
set echo site1_label {10.460 -10.431 5.587}
echo bvp 0.229
color echo black
font echo 18

# ---- Site 2: tpv (RMSD 0.467 A) ----
select (resno=55 or resno=56 or resno=113 or resno=115) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=55 or resno=56 or resno=113 or resno=115) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-8.084 5.350 14.969} color blue
draw site2_b1 width 0.06 line {-8.084 5.350 14.969} (chain='A' and resno=115 and atomname='O') color blue
draw site2_b2 width 0.06 line {-8.084 5.350 14.969} (chain='A' and resno=56 and atomname='OE1') color blue
draw site2_b3 width 0.06 line {-8.084 5.350 14.969} (chain='A' and resno=55 and atomname='O') color blue
draw site2_b4 width 0.06 line {-8.084 5.350 14.969} (chain='A' and resno=113 and atomname='O') color blue
draw site2_b5 width 0.06 line {-8.084 5.350 14.969} (chain='A' and resno=56 and atomname='O') color blue
set echo site2_label {-8.084 5.350 14.969}
echo tpv 0.467
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
