# 1PNH_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.250 A | donors A:LEU5:O;A:GLY19:O;A:GLU27:O;A:CYS8:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.476 A | donors A:LEU5:O;A:GLY19:O;A:GLU27:O;A:CYS8:O | metals: cobalt,copper,manganese,nickel

load "1PNH_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.250 A) ----
select (resno=5 or resno=8 or resno=19 or resno=27) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=8 or resno=19 or resno=27) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-11.788 -6.415 -6.067} color red
draw site1_b1 width 0.06 line {-11.788 -6.415 -6.067} (chain='A' and resno=5 and atomname='O') color red
draw site1_b2 width 0.06 line {-11.788 -6.415 -6.067} (chain='A' and resno=19 and atomname='O') color red
draw site1_b3 width 0.06 line {-11.788 -6.415 -6.067} (chain='A' and resno=27 and atomname='O') color red
draw site1_b4 width 0.06 line {-11.788 -6.415 -6.067} (chain='A' and resno=8 and atomname='O') color red
set echo site1_label {-11.788 -6.415 -6.067}
echo bvp 0.250
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.476 A) ----
select (resno=5 or resno=8 or resno=19 or resno=27) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=8 or resno=19 or resno=27) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-11.604 -6.091 -6.089} color blue
draw site2_b1 width 0.06 line {-11.604 -6.091 -6.089} (chain='A' and resno=5 and atomname='O') color blue
draw site2_b2 width 0.06 line {-11.604 -6.091 -6.089} (chain='A' and resno=19 and atomname='O') color blue
draw site2_b3 width 0.06 line {-11.604 -6.091 -6.089} (chain='A' and resno=27 and atomname='O') color blue
draw site2_b4 width 0.06 line {-11.604 -6.091 -6.089} (chain='A' and resno=8 and atomname='O') color blue
set echo site2_label {-11.604 -6.091 -6.089}
echo pyv 0.476
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
