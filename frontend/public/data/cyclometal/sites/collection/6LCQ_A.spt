# 6LCQ_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.345 A | donors A:ASP31:O;A:GLY32:O;A:GLU33:OE1;A:ASP31:OD2 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): spy RMSD 0.486 A | donors A:PHE44:O;A:GLY32:O;A:ASP31:O;A:GLU33:OE1;A:ASP31:OD2 | metals: cobalt,copper,europium,gadolinium,holmium,manganese,nickel,praseodymium,samarium,terbium,ytterbium

load "6LCQ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.345 A) ----
select (resno=31 or resno=32 or resno=33) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=31 or resno=32 or resno=33) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.533 15.487 8.136} color red
draw site1_b1 width 0.06 line {1.533 15.487 8.136} (chain='A' and resno=31 and atomname='O') color red
draw site1_b2 width 0.06 line {1.533 15.487 8.136} (chain='A' and resno=32 and atomname='O') color red
draw site1_b3 width 0.06 line {1.533 15.487 8.136} (chain='A' and resno=33 and atomname='OE1') color red
draw site1_b4 width 0.06 line {1.533 15.487 8.136} (chain='A' and resno=31 and atomname='OD2') color red
set echo site1_label {1.533 15.487 8.136}
echo pyv 0.345
color echo black
font echo 18

# ---- Site 2: spy (RMSD 0.486 A) ----
select (resno=31 or resno=32 or resno=33 or resno=44) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=31 or resno=32 or resno=33 or resno=44) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {1.334 15.658 8.130} color blue
draw site2_b1 width 0.06 line {1.334 15.658 8.130} (chain='A' and resno=44 and atomname='O') color blue
draw site2_b2 width 0.06 line {1.334 15.658 8.130} (chain='A' and resno=32 and atomname='O') color blue
draw site2_b3 width 0.06 line {1.334 15.658 8.130} (chain='A' and resno=31 and atomname='O') color blue
draw site2_b4 width 0.06 line {1.334 15.658 8.130} (chain='A' and resno=33 and atomname='OE1') color blue
draw site2_b5 width 0.06 line {1.334 15.658 8.130} (chain='A' and resno=31 and atomname='OD2') color blue
set echo site2_label {1.334 15.658 8.130}
echo spy 0.486
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
