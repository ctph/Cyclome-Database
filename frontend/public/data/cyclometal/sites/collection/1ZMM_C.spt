# 1ZMM_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.255 A | donors C:LEU6:O;C:VAL7:O;C:THR27:OG1;C:ARG5:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bvp RMSD 0.349 A | donors C:LEU6:O;C:VAL7:O;C:THR27:OG1;C:ARG5:O | metals: cobalt,copper,manganese,nickel

load "1ZMM_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.255 A) ----
select (resno=5 or resno=6 or resno=7 or resno=27) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=6 or resno=7 or resno=27) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.769 -2.650 25.456} color red
draw site1_b1 width 0.06 line {1.769 -2.650 25.456} (chain='C' and resno=6 and atomname='O') color red
draw site1_b2 width 0.06 line {1.769 -2.650 25.456} (chain='C' and resno=7 and atomname='O') color red
draw site1_b3 width 0.06 line {1.769 -2.650 25.456} (chain='C' and resno=27 and atomname='OG1') color red
draw site1_b4 width 0.06 line {1.769 -2.650 25.456} (chain='C' and resno=5 and atomname='O') color red
set echo site1_label {1.769 -2.650 25.456}
echo pyv 0.255
color echo black
font echo 18

# ---- Site 2: bvp (RMSD 0.349 A) ----
select (resno=5 or resno=6 or resno=7 or resno=27) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=6 or resno=7 or resno=27) and chain='C' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {1.689 -2.411 25.673} color blue
draw site2_b1 width 0.06 line {1.689 -2.411 25.673} (chain='C' and resno=6 and atomname='O') color blue
draw site2_b2 width 0.06 line {1.689 -2.411 25.673} (chain='C' and resno=7 and atomname='O') color blue
draw site2_b3 width 0.06 line {1.689 -2.411 25.673} (chain='C' and resno=27 and atomname='OG1') color blue
draw site2_b4 width 0.06 line {1.689 -2.411 25.673} (chain='C' and resno=5 and atomname='O') color blue
set echo site2_label {1.689 -2.411 25.673}
echo bvp 0.349
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
