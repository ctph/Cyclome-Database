load "1J35_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.317 A) ----
select (resno=12 or resno=14 or resno=47 or resno=128) and chain='A'
