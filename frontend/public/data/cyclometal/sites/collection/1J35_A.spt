draw site1_center sphere diameter 1.4 {0.104 -6.718 9.812} color red
draw site1_b1 width 0.06 line {0.104 -6.718 9.812} (chain='A' and resno=12 and atomname='ND1') color red
draw site1_b2 width 0.06 line {0.104 -6.718 9.812} (chain='A' and resno=14 and atomname='OH') color red
draw site1_b3 width 0.06 line {0.104 -6.718 9.812} (chain='A' and resno=47 and atomname='OE1') color red
draw site1_b4 width 0.06 line {0.104 -6.718 9.812} (chain='A' and resno=128 and atomname='OE2') color red
set echo site1_label {0.104 -6.718 9.812}
