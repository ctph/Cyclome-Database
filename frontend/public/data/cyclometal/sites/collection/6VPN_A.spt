# 6VPN_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.480 A | donors A:ASP21:O;A:SER32:O;A:CYS24:O;A:ARG31:O | metals: cobalt,copper,manganese,nickel,samarium

load "6VPN_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.480 A) ----
select (resno=21 or resno=24 or resno=31 or resno=32) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=21 or resno=24 or resno=31 or resno=32) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.397 -1.660 1.702} color red
draw site1_b1 width 0.06 line {4.397 -1.660 1.702} (chain='A' and resno=21 and atomname='O') color red
draw site1_b2 width 0.06 line {4.397 -1.660 1.702} (chain='A' and resno=32 and atomname='O') color red
draw site1_b3 width 0.06 line {4.397 -1.660 1.702} (chain='A' and resno=24 and atomname='O') color red
draw site1_b4 width 0.06 line {4.397 -1.660 1.702} (chain='A' and resno=31 and atomname='O') color red
set echo site1_label {4.397 -1.660 1.702}
echo tet 0.480
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
