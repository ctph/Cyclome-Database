# 1T0Z_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.228 A | donors B:GLU25:OE2;B:ASN24:O;B:ASN24:OD1;B:TYR21:O | metals: cobalt,copper,manganese,nickel

load "1T0Z_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.228 A) ----
select (resno=21 or resno=24 or resno=25) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=21 or resno=24 or resno=25) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {8.394 16.006 21.288} color red
draw site1_b1 width 0.06 line {8.394 16.006 21.288} (chain='B' and resno=25 and atomname='OE2') color red
draw site1_b2 width 0.06 line {8.394 16.006 21.288} (chain='B' and resno=24 and atomname='O') color red
draw site1_b3 width 0.06 line {8.394 16.006 21.288} (chain='B' and resno=24 and atomname='OD1') color red
draw site1_b4 width 0.06 line {8.394 16.006 21.288} (chain='B' and resno=21 and atomname='O') color red
set echo site1_label {8.394 16.006 21.288}
echo pyv 0.228
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
