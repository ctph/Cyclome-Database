# 1MCV_I: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.263 A | donors I:CYS15:O;I:ALA17:O;I:CYS19:O;I:LEU16:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): pyv RMSD 0.374 A | donors I:ALA17:O;I:CYS19:O;I:ASP12:O;I:CYS15:O | metals: cobalt,copper,manganese,nickel
# Site 3 (green): tet RMSD 0.446 A | donors I:LEU16:O;I:CYS15:O;I:CYS19:O;I:ALA17:O | metals: cobalt,copper,manganese,nickel,samarium

load "1MCV_I.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.263 A) ----
select (resno=15 or resno=16 or resno=17 or resno=19) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=15 or resno=16 or resno=17 or resno=19) and chain='I' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {29.801 23.251 23.636} color red
draw site1_b1 width 0.06 line {29.801 23.251 23.636} (chain='I' and resno=15 and atomname='O') color red
draw site1_b2 width 0.06 line {29.801 23.251 23.636} (chain='I' and resno=17 and atomname='O') color red
draw site1_b3 width 0.06 line {29.801 23.251 23.636} (chain='I' and resno=19 and atomname='O') color red
draw site1_b4 width 0.06 line {29.801 23.251 23.636} (chain='I' and resno=16 and atomname='O') color red
set echo site1_label {29.801 23.251 23.636}
echo bva 0.263
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.374 A) ----
