draw site3_center sphere diameter 1.4 {29.298 23.123 23.279} color green
draw site3_b1 width 0.06 line {29.298 23.123 23.279} (chain='I' and resno=16 and atomname='O') color green
draw site3_b2 width 0.06 line {29.298 23.123 23.279} (chain='I' and resno=15 and atomname='O') color green
draw site3_b3 width 0.06 line {29.298 23.123 23.279} (chain='I' and resno=19 and atomname='O') color green
draw site3_b4 width 0.06 line {29.298 23.123 23.279} (chain='I' and resno=17 and atomname='O') color green
