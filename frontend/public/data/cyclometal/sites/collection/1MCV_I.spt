color wireframe blue
draw site2_center sphere diameter 1.4 {30.968 23.328 24.665} color blue
draw site2_b1 width 0.06 line {30.968 23.328 24.665} (chain='I' and resno=17 and atomname='O') color blue
draw site2_b2 width 0.06 line {30.968 23.328 24.665} (chain='I' and resno=19 and atomname='O') color blue
draw site2_b3 width 0.06 line {30.968 23.328 24.665} (chain='I' and resno=12 and atomname='O') color blue
draw site2_b4 width 0.06 line {30.968 23.328 24.665} (chain='I' and resno=15 and atomname='O') color blue
set echo site2_label {30.968 23.328 24.665}
echo pyv 0.374
color echo black
font echo 18

# ---- Site 3: tet (RMSD 0.446 A) ----
select (resno=15 or resno=16 or resno=17 or resno=19) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=15 or resno=16 or resno=17 or resno=19) and chain='I' and carbon
