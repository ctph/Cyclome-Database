# 2CRT_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tpv RMSD 0.348 A | donors A:ASN60:OD1;A:GLY37:O;A:ASN4:O;A:TYR22:O;A:ARG36:O | metals: cobalt,copper,manganese

load "2CRT_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tpv (RMSD 0.348 A) ----
select (resno=4 or resno=22 or resno=36 or resno=37 or resno=60) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=22 or resno=36 or resno=37 or resno=60) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.389 -0.544 0.257} color red
draw site1_b1 width 0.06 line {3.389 -0.544 0.257} (chain='A' and resno=60 and atomname='OD1') color red
draw site1_b2 width 0.06 line {3.389 -0.544 0.257} (chain='A' and resno=37 and atomname='O') color red
draw site1_b3 width 0.06 line {3.389 -0.544 0.257} (chain='A' and resno=4 and atomname='O') color red
draw site1_b4 width 0.06 line {3.389 -0.544 0.257} (chain='A' and resno=22 and atomname='O') color red
draw site1_b5 width 0.06 line {3.389 -0.544 0.257} (chain='A' and resno=36 and atomname='O') color red
set echo site1_label {3.389 -0.544 0.257}
echo tpv 0.348
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
