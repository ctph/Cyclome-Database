# 1MCT_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.145 A | donors A:MET180:SD;A:ASN179:O;A:THR229:OG1;A:LEU99:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): spl RMSD 0.164 A | donors A:TRP141:O;A:LEU154:O;A:GLY140:O;A:PRO152:O | metals: cobalt,copper,europium,manganese,nickel
# Site 3 (green): tbp RMSD 0.303 A | donors A:ASN72:O;A:GLU77:OE1;A:GLU70:OE1;A:VAL75:O;A:GLU80:OE2 | metals: cobalt,copper,manganese,nickel

load "1MCT_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.145 A) ----
select (resno=99 or resno=179 or resno=180 or resno=229) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=99 or resno=179 or resno=180 or resno=229) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-2.113 30.961 17.646} color red
draw site1_b1 width 0.06 line {-2.113 30.961 17.646} (chain='A' and resno=180 and atomname='SD') color red
draw site1_b2 width 0.06 line {-2.113 30.961 17.646} (chain='A' and resno=179 and atomname='O') color red
draw site1_b3 width 0.06 line {-2.113 30.961 17.646} (chain='A' and resno=229 and atomname='OG1') color red
draw site1_b4 width 0.06 line {-2.113 30.961 17.646} (chain='A' and resno=99 and atomname='O') color red
set echo site1_label {-2.113 30.961 17.646}
echo bvp 0.145
color echo black
font echo 18

# ---- Site 2: spl (RMSD 0.164 A) ----
select (resno=140 or resno=141 or resno=152 or resno=154) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=140 or resno=141 or resno=152 or resno=154) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-16.071 20.921 3.932} color blue
draw site2_b1 width 0.06 line {-16.071 20.921 3.932} (chain='A' and resno=141 and atomname='O') color blue
draw site2_b2 width 0.06 line {-16.071 20.921 3.932} (chain='A' and resno=154 and atomname='O') color blue
draw site2_b3 width 0.06 line {-16.071 20.921 3.932} (chain='A' and resno=140 and atomname='O') color blue
draw site2_b4 width 0.06 line {-16.071 20.921 3.932} (chain='A' and resno=152 and atomname='O') color blue
set echo site2_label {-16.071 20.921 3.932}
echo spl 0.164
color echo black
font echo 18

# ---- Site 3: tbp (RMSD 0.303 A) ----
select (resno=70 or resno=72 or resno=75 or resno=77 or resno=80) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=70 or resno=72 or resno=75 or resno=77 or resno=80) and chain='A' and carbon
color wireframe green
draw site3_center sphere diameter 1.4 {-23.094 26.638 -2.466} color green
draw site3_b1 width 0.06 line {-23.094 26.638 -2.466} (chain='A' and resno=72 and atomname='O') color green
draw site3_b2 width 0.06 line {-23.094 26.638 -2.466} (chain='A' and resno=77 and atomname='OE1') color green
draw site3_b3 width 0.06 line {-23.094 26.638 -2.466} (chain='A' and resno=70 and atomname='OE1') color green
draw site3_b4 width 0.06 line {-23.094 26.638 -2.466} (chain='A' and resno=75 and atomname='O') color green
draw site3_b5 width 0.06 line {-23.094 26.638 -2.466} (chain='A' and resno=80 and atomname='OE2') color green
set echo site3_label {-23.094 26.638 -2.466}
echo tbp 0.303
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
