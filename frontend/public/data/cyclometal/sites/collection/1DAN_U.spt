# 1DAN_U: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.161 A | donors U:SER188:OG;U:SER205:O;U:PRO206:O;U:SER205:OG | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.238 A | donors U:ASP204:OD1;U:SER188:OG;U:SER188:O;U:VAL189:O | metals: cobalt,copper,manganese,nickel

load "1DAN_U.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.161 A) ----
select (resno=188 or resno=205 or resno=206) and chain='U'
wireframe 0.18
color wireframe cpk
select (resno=188 or resno=205 or resno=206) and chain='U' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {33.009 15.405 77.009} color red
draw site1_b1 width 0.06 line {33.009 15.405 77.009} (chain='U' and resno=188 and atomname='OG') color red
draw site1_b2 width 0.06 line {33.009 15.405 77.009} (chain='U' and resno=205 and atomname='O') color red
draw site1_b3 width 0.06 line {33.009 15.405 77.009} (chain='U' and resno=206 and atomname='O') color red
draw site1_b4 width 0.06 line {33.009 15.405 77.009} (chain='U' and resno=205 and atomname='OG') color red
set echo site1_label {33.009 15.405 77.009}
echo pyv 0.161
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.238 A) ----
select (resno=188 or resno=189 or resno=204) and chain='U'
wireframe 0.18
color wireframe cpk
select (resno=188 or resno=189 or resno=204) and chain='U' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {33.175 10.947 74.911} color blue
draw site2_b1 width 0.06 line {33.175 10.947 74.911} (chain='U' and resno=204 and atomname='OD1') color blue
draw site2_b2 width 0.06 line {33.175 10.947 74.911} (chain='U' and resno=188 and atomname='OG') color blue
draw site2_b3 width 0.06 line {33.175 10.947 74.911} (chain='U' and resno=188 and atomname='O') color blue
draw site2_b4 width 0.06 line {33.175 10.947 74.911} (chain='U' and resno=189 and atomname='O') color blue
set echo site2_label {33.175 10.947 74.911}
echo pyv 0.238
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
