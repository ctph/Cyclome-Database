# 1JU8_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.286 A | donors A:SER17:OG;A:ILE33:O;A:PRO35:O;A:ASP19:O | metals: cobalt,copper,manganese,nickel

load "1JU8_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.286 A) ----
select (resno=17 or resno=19 or resno=33 or resno=35) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=17 or resno=19 or resno=33 or resno=35) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.228 3.599 8.470} color red
draw site1_b1 width 0.06 line {-0.228 3.599 8.470} (chain='A' and resno=17 and atomname='OG') color red
draw site1_b2 width 0.06 line {-0.228 3.599 8.470} (chain='A' and resno=33 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.228 3.599 8.470} (chain='A' and resno=35 and atomname='O') color red
draw site1_b4 width 0.06 line {-0.228 3.599 8.470} (chain='A' and resno=19 and atomname='O') color red
set echo site1_label {-0.228 3.599 8.470}
echo pyv 0.286
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
