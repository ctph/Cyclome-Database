load "2PUQ_L.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.328 A) ----
select (resno=85 or resno=88 or resno=93) and chain='L'
