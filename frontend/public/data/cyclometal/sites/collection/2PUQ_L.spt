color wireframe cpk
select (resno=85 or resno=88 or resno=93) and chain='L' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-38.187 -11.986 14.653} color red
draw site1_b1 width 0.06 line {-38.187 -11.986 14.653} (chain='L' and resno=85 and atomname='O') color red
draw site1_b2 width 0.06 line {-38.187 -11.986 14.653} (chain='L' and resno=88 and atomname='O') color red
draw site1_b3 width 0.06 line {-38.187 -11.986 14.653} (chain='L' and resno=93 and atomname='OD1') color red
draw site1_b4 width 0.06 line {-38.187 -11.986 14.653} (chain='L' and resno=88 and atomname='OE1') color red
set echo site1_label {-38.187 -11.986 14.653}
echo pyv 0.328
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
