# 3PLC_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.307 A | donors A:THR58:O;A:CYS56:O;A:ASP20:O;A:ASP57:O | metals: cobalt,copper,manganese,nickel

load "3PLC_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.307 A) ----
select (resno=20 or resno=56 or resno=57 or resno=58) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=20 or resno=56 or resno=57 or resno=58) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-12.960 4.038 -4.298} color red
draw site1_b1 width 0.06 line {-12.960 4.038 -4.298} (chain='A' and resno=58 and atomname='O') color red
draw site1_b2 width 0.06 line {-12.960 4.038 -4.298} (chain='A' and resno=56 and atomname='O') color red
draw site1_b3 width 0.06 line {-12.960 4.038 -4.298} (chain='A' and resno=20 and atomname='O') color red
draw site1_b4 width 0.06 line {-12.960 4.038 -4.298} (chain='A' and resno=57 and atomname='O') color red
set echo site1_label {-12.960 4.038 -4.298}
echo pyv 0.307
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
