# 1KTZ_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.213 A | donors B:ILE89:O;B:CYS113:O;B:ASP92:OD1;B:MET112:SD | metals: cobalt,copper,europium,manganese,nickel
# Site 2 (blue): bvp RMSD 0.218 A | donors B:MET112:SD;B:ILE89:O;B:ASP92:OD1;B:MET112:O | metals: cobalt,copper,manganese,nickel

load "1KTZ_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.213 A) ----
select (resno=89 or resno=92 or resno=112 or resno=113) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=89 or resno=92 or resno=112 or resno=113) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {15.852 61.683 60.482} color red
draw site1_b1 width 0.06 line {15.852 61.683 60.482} (chain='B' and resno=89 and atomname='O') color red
draw site1_b2 width 0.06 line {15.852 61.683 60.482} (chain='B' and resno=113 and atomname='O') color red
draw site1_b3 width 0.06 line {15.852 61.683 60.482} (chain='B' and resno=92 and atomname='OD1') color red
draw site1_b4 width 0.06 line {15.852 61.683 60.482} (chain='B' and resno=112 and atomname='SD') color red
set echo site1_label {15.852 61.683 60.482}
echo spl 0.213
color echo black
font echo 18

# ---- Site 2: bvp (RMSD 0.218 A) ----
select (resno=89 or resno=92 or resno=112) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=89 or resno=92 or resno=112) and chain='B' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {15.902 61.821 60.275} color blue
draw site2_b1 width 0.06 line {15.902 61.821 60.275} (chain='B' and resno=112 and atomname='SD') color blue
draw site2_b2 width 0.06 line {15.902 61.821 60.275} (chain='B' and resno=89 and atomname='O') color blue
draw site2_b3 width 0.06 line {15.902 61.821 60.275} (chain='B' and resno=92 and atomname='OD1') color blue
draw site2_b4 width 0.06 line {15.902 61.821 60.275} (chain='B' and resno=112 and atomname='O') color blue
set echo site2_label {15.902 61.821 60.275}
echo bvp 0.218
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
