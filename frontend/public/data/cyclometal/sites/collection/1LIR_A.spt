# 1LIR_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.426 A | donors A:ASN24:OD1;A:ASN11:O;A:SER15:OG;A:TRP14:O | metals: cobalt,copper,manganese,nickel

load "1LIR_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.426 A) ----
select (resno=11 or resno=14 or resno=15 or resno=24) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=14 or resno=15 or resno=24) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-12.562 0.090 -0.420} color red
draw site1_b1 width 0.06 line {-12.562 0.090 -0.420} (chain='A' and resno=24 and atomname='OD1') color red
draw site1_b2 width 0.06 line {-12.562 0.090 -0.420} (chain='A' and resno=11 and atomname='O') color red
draw site1_b3 width 0.06 line {-12.562 0.090 -0.420} (chain='A' and resno=15 and atomname='OG') color red
draw site1_b4 width 0.06 line {-12.562 0.090 -0.420} (chain='A' and resno=14 and atomname='O') color red
set echo site1_label {-12.562 0.090 -0.420}
echo pyv 0.426
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
