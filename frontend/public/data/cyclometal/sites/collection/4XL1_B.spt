# 4XL1_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.289 A | donors B:SER116:O;B:THR75:OG1;B:HIS64:O;B:LEU62:O | metals: cobalt,copper,europium,manganese,nickel
# Site 2 (blue): tbp RMSD 0.432 A | donors B:CYS217:O;B:ASP218:O;B:HIS197:NE2;B:PHE195:O;B:HIS194:O | metals: cobalt,copper,manganese,nickel

load "4XL1_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.289 A) ----
select (resno=62 or resno=64 or resno=75 or resno=116) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=62 or resno=64 or resno=75 or resno=116) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {19.441 -5.617 -14.631} color red
draw site1_b1 width 0.06 line {19.441 -5.617 -14.631} (chain='B' and resno=116 and atomname='O') color red
draw site1_b2 width 0.06 line {19.441 -5.617 -14.631} (chain='B' and resno=75 and atomname='OG1') color red
draw site1_b3 width 0.06 line {19.441 -5.617 -14.631} (chain='B' and resno=64 and atomname='O') color red
draw site1_b4 width 0.06 line {19.441 -5.617 -14.631} (chain='B' and resno=62 and atomname='O') color red
set echo site1_label {19.441 -5.617 -14.631}
echo spl 0.289
color echo black
font echo 18

# ---- Site 2: tbp (RMSD 0.432 A) ----
select (resno=194 or resno=195 or resno=197 or resno=217 or resno=218) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=194 or resno=195 or resno=197 or resno=217 or resno=218) and chain='B' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {25.374 36.006 -24.097} color blue
draw site2_b1 width 0.06 line {25.374 36.006 -24.097} (chain='B' and resno=217 and atomname='O') color blue
draw site2_b2 width 0.06 line {25.374 36.006 -24.097} (chain='B' and resno=218 and atomname='O') color blue
draw site2_b3 width 0.06 line {25.374 36.006 -24.097} (chain='B' and resno=197 and atomname='NE2') color blue
draw site2_b4 width 0.06 line {25.374 36.006 -24.097} (chain='B' and resno=195 and atomname='O') color blue
draw site2_b5 width 0.06 line {25.374 36.006 -24.097} (chain='B' and resno=194 and atomname='O') color blue
set echo site2_label {25.374 36.006 -24.097}
