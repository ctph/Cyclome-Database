load "5WUZ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.496 A) ----
select (resno=29 or resno=32 or resno=35) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=29 or resno=32 or resno=35) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.691 -6.370 -1.930} color red
draw site1_b1 width 0.06 line {3.691 -6.370 -1.930} (chain='A' and resno=29 and atomname='OE1') color red
draw site1_b2 width 0.06 line {3.691 -6.370 -1.930} (chain='A' and resno=29 and atomname='O') color red
draw site1_b3 width 0.06 line {3.691 -6.370 -1.930} (chain='A' and resno=35 and atomname='O') color red
draw site1_b4 width 0.06 line {3.691 -6.370 -1.930} (chain='A' and resno=32 and atomname='OG') color red
set echo site1_label {3.691 -6.370 -1.930}
echo pyv 0.496
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
