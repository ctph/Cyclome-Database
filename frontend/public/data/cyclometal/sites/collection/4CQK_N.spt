# 4CQK_N: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.151 A | donors N:GLU2:OE2;N:ASP31:OD2;N:THR30:O;N:THR44:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tbp RMSD 0.439 A | donors N:GLY32:O;N:ASP31:OD2;N:ASP31:O;N:HIS33:ND1;N:THR44:OG1 | metals: cobalt,copper,manganese,nickel

load "4CQK_N.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.151 A) ----
select (resno=2 or resno=30 or resno=31 or resno=44) and chain='N'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=30 or resno=31 or resno=44) and chain='N' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-20.611 12.965 18.233} color red
draw site1_b1 width 0.06 line {-20.611 12.965 18.233} (chain='N' and resno=2 and atomname='OE2') color red
draw site1_b2 width 0.06 line {-20.611 12.965 18.233} (chain='N' and resno=31 and atomname='OD2') color red
draw site1_b3 width 0.06 line {-20.611 12.965 18.233} (chain='N' and resno=30 and atomname='O') color red
draw site1_b4 width 0.06 line {-20.611 12.965 18.233} (chain='N' and resno=44 and atomname='O') color red
set echo site1_label {-20.611 12.965 18.233}
echo bvp 0.151
color echo black
font echo 18

# ---- Site 2: tbp (RMSD 0.439 A) ----
select (resno=31 or resno=32 or resno=33 or resno=44) and chain='N'
wireframe 0.18
color wireframe cpk
select (resno=31 or resno=32 or resno=33 or resno=44) and chain='N' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-22.372 12.344 14.250} color blue
draw site2_b1 width 0.06 line {-22.372 12.344 14.250} (chain='N' and resno=32 and atomname='O') color blue
draw site2_b2 width 0.06 line {-22.372 12.344 14.250} (chain='N' and resno=31 and atomname='OD2') color blue
draw site2_b3 width 0.06 line {-22.372 12.344 14.250} (chain='N' and resno=31 and atomname='O') color blue
draw site2_b4 width 0.06 line {-22.372 12.344 14.250} (chain='N' and resno=33 and atomname='ND1') color blue
draw site2_b5 width 0.06 line {-22.372 12.344 14.250} (chain='N' and resno=44 and atomname='OG1') color blue
set echo site2_label {-22.372 12.344 14.250}
echo tbp 0.439
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
