# 1DEM_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.183 A | donors A:CYS7:O;A:TYR25:O;A:HIS10:ND1;A:GLN27:OE1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.419 A | donors A:CYS7:O;A:TYR25:O;A:HIS10:ND1;A:GLN27:OE1 | metals: cobalt,copper,manganese,nickel

load "1DEM_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.183 A) ----
select (resno=7 or resno=10 or resno=25 or resno=27) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=7 or resno=10 or resno=25 or resno=27) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-2.864 -2.975 5.651} color red
draw site1_b1 width 0.06 line {-2.864 -2.975 5.651} (chain='A' and resno=7 and atomname='O') color red
draw site1_b2 width 0.06 line {-2.864 -2.975 5.651} (chain='A' and resno=25 and atomname='O') color red
draw site1_b3 width 0.06 line {-2.864 -2.975 5.651} (chain='A' and resno=10 and atomname='ND1') color red
draw site1_b4 width 0.06 line {-2.864 -2.975 5.651} (chain='A' and resno=27 and atomname='OE1') color red
set echo site1_label {-2.864 -2.975 5.651}
echo bvp 0.183
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.419 A) ----
select (resno=7 or resno=10 or resno=25 or resno=27) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=7 or resno=10 or resno=25 or resno=27) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-2.581 -3.116 5.520} color blue
draw site2_b1 width 0.06 line {-2.581 -3.116 5.520} (chain='A' and resno=7 and atomname='O') color blue
draw site2_b2 width 0.06 line {-2.581 -3.116 5.520} (chain='A' and resno=25 and atomname='O') color blue
draw site2_b3 width 0.06 line {-2.581 -3.116 5.520} (chain='A' and resno=10 and atomname='ND1') color blue
draw site2_b4 width 0.06 line {-2.581 -3.116 5.520} (chain='A' and resno=27 and atomname='OE1') color blue
set echo site2_label {-2.581 -3.116 5.520}
echo pyv 0.419
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
