# 4AEI_M: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.321 A | donors M:HIS31:ND1;M:HIS98:ND1;M:SER97:OG;M:VAL30:O | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): tet RMSD 0.475 A | donors M:LEU88:O;M:GLN171:O;M:PRO45:O;M:SER173:OG | metals: cobalt,copper,manganese,nickel,samarium

load "4AEI_M.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.321 A) ----
select (resno=30 or resno=31 or resno=97 or resno=98) and chain='M'
wireframe 0.18
color wireframe cpk
select (resno=30 or resno=31 or resno=97 or resno=98) and chain='M' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {57.864 40.388 54.721} color red
draw site1_b1 width 0.06 line {57.864 40.388 54.721} (chain='M' and resno=31 and atomname='ND1') color red
draw site1_b2 width 0.06 line {57.864 40.388 54.721} (chain='M' and resno=98 and atomname='ND1') color red
draw site1_b3 width 0.06 line {57.864 40.388 54.721} (chain='M' and resno=97 and atomname='OG') color red
draw site1_b4 width 0.06 line {57.864 40.388 54.721} (chain='M' and resno=30 and atomname='O') color red
set echo site1_label {57.864 40.388 54.721}
echo tet 0.321
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.475 A) ----
select (resno=45 or resno=88 or resno=171 or resno=173) and chain='M'
wireframe 0.18
color wireframe cpk
select (resno=45 or resno=88 or resno=171 or resno=173) and chain='M' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {28.029 29.033 45.681} color blue
draw site2_b1 width 0.06 line {28.029 29.033 45.681} (chain='M' and resno=88 and atomname='O') color blue
draw site2_b2 width 0.06 line {28.029 29.033 45.681} (chain='M' and resno=171 and atomname='O') color blue
draw site2_b3 width 0.06 line {28.029 29.033 45.681} (chain='M' and resno=45 and atomname='O') color blue
draw site2_b4 width 0.06 line {28.029 29.033 45.681} (chain='M' and resno=173 and atomname='OG') color blue
set echo site2_label {28.029 29.033 45.681}
echo tet 0.475
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
