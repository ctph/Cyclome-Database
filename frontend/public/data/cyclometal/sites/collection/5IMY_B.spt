# 5IMY_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.155 A | donors B:GLU361:O;B:TYR244:OH;B:LEU365:O;B:ALA363:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): tpv RMSD 0.346 A | donors B:GLY339:O;B:LEU337:O;B:ASN342:OD1;B:SER340:OG;B:ASN342:O | metals: cobalt,copper,manganese

load "5IMY_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.155 A) ----
select (resno=244 or resno=361 or resno=363 or resno=365) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=244 or resno=361 or resno=363 or resno=365) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {65.899 79.597 99.927} color red
draw site1_b1 width 0.06 line {65.899 79.597 99.927} (chain='B' and resno=361 and atomname='O') color red
draw site1_b2 width 0.06 line {65.899 79.597 99.927} (chain='B' and resno=244 and atomname='OH') color red
draw site1_b3 width 0.06 line {65.899 79.597 99.927} (chain='B' and resno=365 and atomname='O') color red
draw site1_b4 width 0.06 line {65.899 79.597 99.927} (chain='B' and resno=363 and atomname='O') color red
set echo site1_label {65.899 79.597 99.927}
echo bva 0.155
color echo black
font echo 18

# ---- Site 2: tpv (RMSD 0.346 A) ----
select (resno=337 or resno=339 or resno=340 or resno=342) and chain='B'
wireframe 0.18
color wireframe cpk
