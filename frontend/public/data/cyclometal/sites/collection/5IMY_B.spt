draw site2_center sphere diameter 1.4 {53.605 73.114 104.799} color blue
draw site2_b1 width 0.06 line {53.605 73.114 104.799} (chain='B' and resno=339 and atomname='O') color blue
draw site2_b2 width 0.06 line {53.605 73.114 104.799} (chain='B' and resno=337 and atomname='O') color blue
draw site2_b3 width 0.06 line {53.605 73.114 104.799} (chain='B' and resno=342 and atomname='OD1') color blue
draw site2_b4 width 0.06 line {53.605 73.114 104.799} (chain='B' and resno=340 and atomname='OG') color blue
draw site2_b5 width 0.06 line {53.605 73.114 104.799} (chain='B' and resno=342 and atomname='O') color blue
set echo site2_label {53.605 73.114 104.799}
