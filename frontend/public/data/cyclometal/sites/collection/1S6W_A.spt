# 1S6W_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.309 A | donors A:CYS6:O;A:MET12:SD;A:CYS9:O;A:MET12:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1S6W_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.309 A) ----
select (resno=6 or resno=9 or resno=12) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=9 or resno=12) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.700 1.536 0.151} color red
draw site1_b1 width 0.06 line {4.700 1.536 0.151} (chain='A' and resno=6 and atomname='O') color red
draw site1_b2 width 0.06 line {4.700 1.536 0.151} (chain='A' and resno=12 and atomname='SD') color red
draw site1_b3 width 0.06 line {4.700 1.536 0.151} (chain='A' and resno=9 and atomname='O') color red
draw site1_b4 width 0.06 line {4.700 1.536 0.151} (chain='A' and resno=12 and atomname='O') color red
set echo site1_label {4.700 1.536 0.151}
echo bva 0.309
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
