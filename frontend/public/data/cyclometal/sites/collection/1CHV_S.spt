# 1CHV_S: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.356 A | donors S:MET26:SD;S:ASN29:OD1;S:SER28:OG;S:MET26:O | metals: cobalt,copper,manganese,nickel,samarium

load "1CHV_S.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.356 A) ----
select (resno=26 or resno=28 or resno=29) and chain='S'
wireframe 0.18
color wireframe cpk
select (resno=26 or resno=28 or resno=29) and chain='S' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {14.089 34.047 29.070} color red
draw site1_b1 width 0.06 line {14.089 34.047 29.070} (chain='S' and resno=26 and atomname='SD') color red
draw site1_b2 width 0.06 line {14.089 34.047 29.070} (chain='S' and resno=29 and atomname='OD1') color red
draw site1_b3 width 0.06 line {14.089 34.047 29.070} (chain='S' and resno=28 and atomname='OG') color red
draw site1_b4 width 0.06 line {14.089 34.047 29.070} (chain='S' and resno=26 and atomname='O') color red
set echo site1_label {14.089 34.047 29.070}
echo tet 0.356
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
