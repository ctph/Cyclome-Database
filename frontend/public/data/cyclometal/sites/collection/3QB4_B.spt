# 3QB4_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.178 A | donors B:GLU70:O;B:ASP66:OD1;B:THR72:OG1;B:GLU64:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bva RMSD 0.449 A | donors B:GLU64:OE1;B:ASP66:OD1;B:GLU64:O;B:THR72:OG1 | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "3QB4_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.178 A) ----
select (resno=64 or resno=66 or resno=70 or resno=72) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=64 or resno=66 or resno=70 or resno=72) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-18.838 3.740 -1.456} color red
draw site1_b1 width 0.06 line {-18.838 3.740 -1.456} (chain='B' and resno=70 and atomname='O') color red
draw site1_b2 width 0.06 line {-18.838 3.740 -1.456} (chain='B' and resno=66 and atomname='OD1') color red
draw site1_b3 width 0.06 line {-18.838 3.740 -1.456} (chain='B' and resno=72 and atomname='OG1') color red
draw site1_b4 width 0.06 line {-18.838 3.740 -1.456} (chain='B' and resno=64 and atomname='O') color red
set echo site1_label {-18.838 3.740 -1.456}
echo pyv 0.178
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.449 A) ----
select (resno=64 or resno=66 or resno=72) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=64 or resno=66 or resno=72) and chain='B' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-16.883 3.912 0.766} color blue
draw site2_b1 width 0.06 line {-16.883 3.912 0.766} (chain='B' and resno=64 and atomname='OE1') color blue
draw site2_b2 width 0.06 line {-16.883 3.912 0.766} (chain='B' and resno=66 and atomname='OD1') color blue
draw site2_b3 width 0.06 line {-16.883 3.912 0.766} (chain='B' and resno=64 and atomname='O') color blue
draw site2_b4 width 0.06 line {-16.883 3.912 0.766} (chain='B' and resno=72 and atomname='OG1') color blue
set echo site2_label {-16.883 3.912 0.766}
echo bva 0.449
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
