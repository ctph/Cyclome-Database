# 4ZQY_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.132 A | donors B:THR13:OG1;B:SER11:O;B:ASP6:OD1;B:ASP6:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "4ZQY_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.132 A) ----
select (resno=6 or resno=11 or resno=13) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=11 or resno=13) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {20.417 31.398 10.094} color red
draw site1_b1 width 0.06 line {20.417 31.398 10.094} (chain='B' and resno=13 and atomname='OG1') color red
draw site1_b2 width 0.06 line {20.417 31.398 10.094} (chain='B' and resno=11 and atomname='O') color red
draw site1_b3 width 0.06 line {20.417 31.398 10.094} (chain='B' and resno=6 and atomname='OD1') color red
draw site1_b4 width 0.06 line {20.417 31.398 10.094} (chain='B' and resno=6 and atomname='O') color red
set echo site1_label {20.417 31.398 10.094}
echo bva 0.132
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
