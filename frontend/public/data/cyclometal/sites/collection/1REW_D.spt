load "1REW_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.221 A) ----
select (resno=62 or resno=64 or resno=72 or resno=73) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=62 or resno=64 or resno=72 or resno=73) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-37.782 44.868 14.949} color red
draw site1_b1 width 0.06 line {-37.782 44.868 14.949} (chain='D' and resno=64 and atomname='OE2') color red
draw site1_b2 width 0.06 line {-37.782 44.868 14.949} (chain='D' and resno=62 and atomname='O') color red
draw site1_b3 width 0.06 line {-37.782 44.868 14.949} (chain='D' and resno=73 and atomname='O') color red
draw site1_b4 width 0.06 line {-37.782 44.868 14.949} (chain='D' and resno=72 and atomname='OG1') color red
set echo site1_label {-37.782 44.868 14.949}
