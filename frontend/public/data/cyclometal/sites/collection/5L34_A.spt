# 5L34_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.273 A | donors A:THR4:OG1;A:ARG2:O;A:CYS1:O;A:THR4:O | metals: cobalt,copper,manganese,nickel

load "5L34_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.273 A) ----
select (resno=1 or resno=2 or resno=4) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=1 or resno=2 or resno=4) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {2.822 -1.509 -4.954} color red
draw site1_b1 width 0.06 line {2.822 -1.509 -4.954} (chain='A' and resno=4 and atomname='OG1') color red
draw site1_b2 width 0.06 line {2.822 -1.509 -4.954} (chain='A' and resno=2 and atomname='O') color red
draw site1_b3 width 0.06 line {2.822 -1.509 -4.954} (chain='A' and resno=1 and atomname='O') color red
draw site1_b4 width 0.06 line {2.822 -1.509 -4.954} (chain='A' and resno=4 and atomname='O') color red
set echo site1_label {2.822 -1.509 -4.954}
echo bvp 0.273
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
