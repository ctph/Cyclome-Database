# 6ATL_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.190 A | donors A:LYS18:O;A:LYS23:O;A:CYS17:O;A:LEU20:O | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): bva RMSD 0.308 A | donors A:LYS18:O;A:LEU20:O;A:LYS23:O;A:CYS17:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "6ATL_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.190 A) ----
select (resno=17 or resno=18 or resno=20 or resno=23) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=17 or resno=18 or resno=20 or resno=23) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {27.668 21.044 16.533} color red
draw site1_b1 width 0.06 line {27.668 21.044 16.533} (chain='A' and resno=18 and atomname='O') color red
draw site1_b2 width 0.06 line {27.668 21.044 16.533} (chain='A' and resno=23 and atomname='O') color red
draw site1_b3 width 0.06 line {27.668 21.044 16.533} (chain='A' and resno=17 and atomname='O') color red
draw site1_b4 width 0.06 line {27.668 21.044 16.533} (chain='A' and resno=20 and atomname='O') color red
set echo site1_label {27.668 21.044 16.533}
echo tet 0.190
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.308 A) ----
select (resno=17 or resno=18 or resno=20 or resno=23) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=17 or resno=18 or resno=20 or resno=23) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {27.577 21.117 17.143} color blue
draw site2_b1 width 0.06 line {27.577 21.117 17.143} (chain='A' and resno=18 and atomname='O') color blue
draw site2_b2 width 0.06 line {27.577 21.117 17.143} (chain='A' and resno=20 and atomname='O') color blue
draw site2_b3 width 0.06 line {27.577 21.117 17.143} (chain='A' and resno=23 and atomname='O') color blue
draw site2_b4 width 0.06 line {27.577 21.117 17.143} (chain='A' and resno=17 and atomname='O') color blue
set echo site2_label {27.577 21.117 17.143}
echo bva 0.308
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
