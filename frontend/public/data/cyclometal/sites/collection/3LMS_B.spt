# 3LMS_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.340 A | donors B:LYS55:O;B:ARG52:O;B:LYS69:O;B:GLU56:OE2 | metals: cobalt,copper,manganese,nickel,samarium

load "3LMS_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.340 A) ----
select (resno=52 or resno=55 or resno=56 or resno=69) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=52 or resno=55 or resno=56 or resno=69) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.980 67.546 35.157} color red
draw site1_b1 width 0.06 line {3.980 67.546 35.157} (chain='B' and resno=55 and atomname='O') color red
draw site1_b2 width 0.06 line {3.980 67.546 35.157} (chain='B' and resno=52 and atomname='O') color red
draw site1_b3 width 0.06 line {3.980 67.546 35.157} (chain='B' and resno=69 and atomname='O') color red
draw site1_b4 width 0.06 line {3.980 67.546 35.157} (chain='B' and resno=56 and atomname='OE2') color red
set echo site1_label {3.980 67.546 35.157}
echo tet 0.340
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
