# 4LFT_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.149 A | donors B:GLN33:OE1;B:SER32:OG;B:ALA29:O;B:PHE30:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): tet RMSD 0.421 A | donors B:PHE30:O;B:SER32:OG;B:GLN33:OE1;B:ALA29:O | metals: cobalt,copper,manganese,nickel,samarium

load "4LFT_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.149 A) ----
select (resno=29 or resno=30 or resno=32 or resno=33) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=29 or resno=30 or resno=32 or resno=33) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.226 19.351 34.317} color red
draw site1_b1 width 0.06 line {3.226 19.351 34.317} (chain='B' and resno=33 and atomname='OE1') color red
draw site1_b2 width 0.06 line {3.226 19.351 34.317} (chain='B' and resno=32 and atomname='OG') color red
draw site1_b3 width 0.06 line {3.226 19.351 34.317} (chain='B' and resno=29 and atomname='O') color red
draw site1_b4 width 0.06 line {3.226 19.351 34.317} (chain='B' and resno=30 and atomname='O') color red
set echo site1_label {3.226 19.351 34.317}
echo bva 0.149
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.421 A) ----
select (resno=29 or resno=30 or resno=32 or resno=33) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=29 or resno=30 or resno=32 or resno=33) and chain='B' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {3.613 19.655 33.635} color blue
draw site2_b1 width 0.06 line {3.613 19.655 33.635} (chain='B' and resno=30 and atomname='O') color blue
draw site2_b2 width 0.06 line {3.613 19.655 33.635} (chain='B' and resno=32 and atomname='OG') color blue
draw site2_b3 width 0.06 line {3.613 19.655 33.635} (chain='B' and resno=33 and atomname='OE1') color blue
draw site2_b4 width 0.06 line {3.613 19.655 33.635} (chain='B' and resno=29 and atomname='O') color blue
set echo site2_label {3.613 19.655 33.635}
echo tet 0.421
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
