# 2JOT_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.249 A | donors A:ALA53:O;A:ALA55:OXT;A:LYS54:O;A:CYS52:O | metals: cobalt,copper,europium,manganese,nickel

load "2JOT_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.249 A) ----
select (resno=52 or resno=53 or resno=54 or resno=55) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=52 or resno=53 or resno=54 or resno=55) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-2.690 13.691 2.514} color red
draw site1_b1 width 0.06 line {-2.690 13.691 2.514} (chain='A' and resno=53 and atomname='O') color red
draw site1_b2 width 0.06 line {-2.690 13.691 2.514} (chain='A' and resno=55 and atomname='OXT') color red
draw site1_b3 width 0.06 line {-2.690 13.691 2.514} (chain='A' and resno=54 and atomname='O') color red
draw site1_b4 width 0.06 line {-2.690 13.691 2.514} (chain='A' and resno=52 and atomname='O') color red
set echo site1_label {-2.690 13.691 2.514}
echo spl 0.249
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
