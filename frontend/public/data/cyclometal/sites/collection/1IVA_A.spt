# 1IVA_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.263 A | donors A:ARG39:O;A:CYS27:O;A:GLU35:OE2;A:ILE41:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1IVA_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.263 A) ----
select (resno=27 or resno=35 or resno=39 or resno=41) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=27 or resno=35 or resno=39 or resno=41) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {8.297 -0.778 3.902} color red
draw site1_b1 width 0.06 line {8.297 -0.778 3.902} (chain='A' and resno=39 and atomname='O') color red
draw site1_b2 width 0.06 line {8.297 -0.778 3.902} (chain='A' and resno=27 and atomname='O') color red
draw site1_b3 width 0.06 line {8.297 -0.778 3.902} (chain='A' and resno=35 and atomname='OE2') color red
draw site1_b4 width 0.06 line {8.297 -0.778 3.902} (chain='A' and resno=41 and atomname='O') color red
set echo site1_label {8.297 -0.778 3.902}
echo bva 0.263
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
