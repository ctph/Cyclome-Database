# 1WQB_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.473 A | donors A:GLY26:O;A:GLU28:O;A:CYS11:O;A:CYS24:O | metals: cobalt,copper,manganese,nickel,samarium

load "1WQB_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.473 A) ----
select (resno=11 or resno=24 or resno=26 or resno=28) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=24 or resno=26 or resno=28) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.622 -3.082 5.817} color red
draw site1_b1 width 0.06 line {0.622 -3.082 5.817} (chain='A' and resno=26 and atomname='O') color red
draw site1_b2 width 0.06 line {0.622 -3.082 5.817} (chain='A' and resno=28 and atomname='O') color red
draw site1_b3 width 0.06 line {0.622 -3.082 5.817} (chain='A' and resno=11 and atomname='O') color red
draw site1_b4 width 0.06 line {0.622 -3.082 5.817} (chain='A' and resno=24 and atomname='O') color red
set echo site1_label {0.622 -3.082 5.817}
echo tet 0.473
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
