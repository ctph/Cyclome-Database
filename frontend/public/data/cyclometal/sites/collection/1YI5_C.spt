# 1YI5_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.241 A | donors C:SER147:O;C:ALA191:O;C:GLU193:O;C:GLU193:OE1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.396 A | donors C:HIS145:O;C:GLU193:O;C:ILE150:O;C:ALA191:O | metals: cobalt,copper,manganese,nickel,samarium

load "1YI5_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.241 A) ----
select (resno=147 or resno=191 or resno=193) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=147 or resno=191 or resno=193) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {119.379 163.202 77.402} color red
draw site1_b1 width 0.06 line {119.379 163.202 77.402} (chain='C' and resno=147 and atomname='O') color red
draw site1_b2 width 0.06 line {119.379 163.202 77.402} (chain='C' and resno=191 and atomname='O') color red
draw site1_b3 width 0.06 line {119.379 163.202 77.402} (chain='C' and resno=193 and atomname='O') color red
draw site1_b4 width 0.06 line {119.379 163.202 77.402} (chain='C' and resno=193 and atomname='OE1') color red
set echo site1_label {119.379 163.202 77.402}
echo pyv 0.241
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.396 A) ----
select (resno=145 or resno=150 or resno=191 or resno=193) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=145 or resno=150 or resno=191 or resno=193) and chain='C' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {118.827 163.977 76.087} color blue
draw site2_b1 width 0.06 line {118.827 163.977 76.087} (chain='C' and resno=145 and atomname='O') color blue
draw site2_b2 width 0.06 line {118.827 163.977 76.087} (chain='C' and resno=193 and atomname='O') color blue
draw site2_b3 width 0.06 line {118.827 163.977 76.087} (chain='C' and resno=150 and atomname='O') color blue
draw site2_b4 width 0.06 line {118.827 163.977 76.087} (chain='C' and resno=191 and atomname='O') color blue
set echo site2_label {118.827 163.977 76.087}
echo tet 0.396
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
