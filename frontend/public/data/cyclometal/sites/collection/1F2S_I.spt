# 1F2S_I: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.239 A | donors I:ALA318:O;I:CYS320:O;I:ASP313:O;I:CYS316:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.427 A | donors I:ASP313:O;I:CYS316:O;I:ALA318:O;I:CYS320:O | metals: cobalt,copper,manganese,nickel

load "1F2S_I.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.239 A) ----
select (resno=313 or resno=316 or resno=318 or resno=320) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=313 or resno=316 or resno=318 or resno=320) and chain='I' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-3.809 8.487 5.844} color red
draw site1_b1 width 0.06 line {-3.809 8.487 5.844} (chain='I' and resno=318 and atomname='O') color red
draw site1_b2 width 0.06 line {-3.809 8.487 5.844} (chain='I' and resno=320 and atomname='O') color red
draw site1_b3 width 0.06 line {-3.809 8.487 5.844} (chain='I' and resno=313 and atomname='O') color red
draw site1_b4 width 0.06 line {-3.809 8.487 5.844} (chain='I' and resno=316 and atomname='O') color red
set echo site1_label {-3.809 8.487 5.844}
echo bvp 0.239
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.427 A) ----
select (resno=313 or resno=316 or resno=318 or resno=320) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=313 or resno=316 or resno=318 or resno=320) and chain='I' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-4.159 8.556 5.869} color blue
draw site2_b1 width 0.06 line {-4.159 8.556 5.869} (chain='I' and resno=313 and atomname='O') color blue
draw site2_b2 width 0.06 line {-4.159 8.556 5.869} (chain='I' and resno=316 and atomname='O') color blue
draw site2_b3 width 0.06 line {-4.159 8.556 5.869} (chain='I' and resno=318 and atomname='O') color blue
draw site2_b4 width 0.06 line {-4.159 8.556 5.869} (chain='I' and resno=320 and atomname='O') color blue
set echo site2_label {-4.159 8.556 5.869}
echo pyv 0.427
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
