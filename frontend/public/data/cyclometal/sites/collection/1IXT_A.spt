# 1IXT_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.474 A | donors A:SER8:O;A:HIS9:NE2;A:CYS18:O;A:HIS9:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1IXT_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.474 A) ----
select (resno=8 or resno=9 or resno=18) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=8 or resno=9 or resno=18) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.184 -0.539 5.831} color red
draw site1_b1 width 0.06 line {4.184 -0.539 5.831} (chain='A' and resno=8 and atomname='O') color red
draw site1_b2 width 0.06 line {4.184 -0.539 5.831} (chain='A' and resno=9 and atomname='NE2') color red
draw site1_b3 width 0.06 line {4.184 -0.539 5.831} (chain='A' and resno=18 and atomname='O') color red
draw site1_b4 width 0.06 line {4.184 -0.539 5.831} (chain='A' and resno=9 and atomname='O') color red
set echo site1_label {4.184 -0.539 5.831}
echo bva 0.474
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
