# 2C4B_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.259 A | donors A:ASP22:OD1;A:ASP22:O;A:TYR24:O;A:PRO21:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bva RMSD 0.319 A | donors A:ASP75:OD2;A:TYR24:OH;A:TYR78:O;A:ILE76:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2C4B_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.259 A) ----
select (resno=21 or resno=22 or resno=24) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=21 or resno=22 or resno=24) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {19.776 62.034 26.504} color red
draw site1_b1 width 0.06 line {19.776 62.034 26.504} (chain='A' and resno=22 and atomname='OD1') color red
draw site1_b2 width 0.06 line {19.776 62.034 26.504} (chain='A' and resno=22 and atomname='O') color red
draw site1_b3 width 0.06 line {19.776 62.034 26.504} (chain='A' and resno=24 and atomname='O') color red
draw site1_b4 width 0.06 line {19.776 62.034 26.504} (chain='A' and resno=21 and atomname='O') color red
set echo site1_label {19.776 62.034 26.504}
echo pyv 0.259
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.319 A) ----
select (resno=24 or resno=75 or resno=76 or resno=78) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=24 or resno=75 or resno=76 or resno=78) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {14.947 72.255 23.345} color blue
draw site2_b1 width 0.06 line {14.947 72.255 23.345} (chain='A' and resno=75 and atomname='OD2') color blue
draw site2_b2 width 0.06 line {14.947 72.255 23.345} (chain='A' and resno=24 and atomname='OH') color blue
draw site2_b3 width 0.06 line {14.947 72.255 23.345} (chain='A' and resno=78 and atomname='O') color blue
draw site2_b4 width 0.06 line {14.947 72.255 23.345} (chain='A' and resno=76 and atomname='O') color blue
set echo site2_label {14.947 72.255 23.345}
echo bva 0.319
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
