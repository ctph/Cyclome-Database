load "1F8U_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.209 A) ----
select (resno=98 or resno=100 or resno=128 or resno=148) and chain='A'
