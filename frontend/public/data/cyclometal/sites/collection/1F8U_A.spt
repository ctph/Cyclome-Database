draw site1_center sphere diameter 1.4 {128.428 110.330 -151.691} color red
draw site1_b1 width 0.06 line {128.428 110.330 -151.691} (chain='A' and resno=98 and atomname='O') color red
draw site1_b2 width 0.06 line {128.428 110.330 -151.691} (chain='A' and resno=100 and atomname='OD1') color red
