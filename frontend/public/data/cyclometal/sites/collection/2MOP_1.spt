# 2MOP_1: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.248 A | donors 1:GLU14:OE2;1:GLN12:O;1:ASP15:OD1;1:GLU14:O | metals: cobalt,copper,manganese,nickel

load "2MOP_1.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.248 A) ----
select (resno=12 or resno=14 or resno=15) and chain='1'
wireframe 0.18
color wireframe cpk
select (resno=12 or resno=14 or resno=15) and chain='1' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.059 4.708 0.223} color red
draw site1_b1 width 0.06 line {4.059 4.708 0.223} (chain='1' and resno=14 and atomname='OE2') color red
draw site1_b2 width 0.06 line {4.059 4.708 0.223} (chain='1' and resno=12 and atomname='O') color red
draw site1_b3 width 0.06 line {4.059 4.708 0.223} (chain='1' and resno=15 and atomname='OD1') color red
draw site1_b4 width 0.06 line {4.059 4.708 0.223} (chain='1' and resno=14 and atomname='O') color red
set echo site1_label {4.059 4.708 0.223}
echo pyv 0.248
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
