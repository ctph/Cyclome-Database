# 1PJV_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.377 A | donors A:CYS8:O;A:TYR5:O;A:GLY20:O;A:ASP9:OD1 | metals: cobalt,copper,manganese,nickel

load "1PJV_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.377 A) ----
select (resno=5 or resno=8 or resno=9 or resno=20) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=8 or resno=9 or resno=20) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.743 -0.666 -0.683} color red
draw site1_b1 width 0.06 line {-0.743 -0.666 -0.683} (chain='A' and resno=8 and atomname='O') color red
draw site1_b2 width 0.06 line {-0.743 -0.666 -0.683} (chain='A' and resno=5 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.743 -0.666 -0.683} (chain='A' and resno=20 and atomname='O') color red
draw site1_b4 width 0.06 line {-0.743 -0.666 -0.683} (chain='A' and resno=9 and atomname='OD1') color red
set echo site1_label {-0.743 -0.666 -0.683}
echo pyv 0.377
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
