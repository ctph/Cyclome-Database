# 2KJF_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.150 A | donors A:ALA50:O;A:LYS51:O;A:GLN52:O;A:ILE49:O | metals: cobalt,copper,manganese,nickel

load "2KJF_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.150 A) ----
select (resno=49 or resno=50 or resno=51 or resno=52) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=49 or resno=50 or resno=51 or resno=52) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.582 4.677 14.018} color red
draw site1_b1 width 0.06 line {-0.582 4.677 14.018} (chain='A' and resno=50 and atomname='O') color red
draw site1_b2 width 0.06 line {-0.582 4.677 14.018} (chain='A' and resno=51 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.582 4.677 14.018} (chain='A' and resno=52 and atomname='O') color red
draw site1_b4 width 0.06 line {-0.582 4.677 14.018} (chain='A' and resno=49 and atomname='O') color red
set echo site1_label {-0.582 4.677 14.018}
echo bvp 0.150
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
