# 6ATM_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.341 A | donors C:HIS34:ND1;C:VAL2:O;C:ILE4:O;C:LYS32:O | metals: cobalt,copper,manganese,nickel

load "6ATM_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.341 A) ----
select (resno=2 or resno=4 or resno=32 or resno=34) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=4 or resno=32 or resno=34) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {10.763 4.012 -7.471} color red
draw site1_b1 width 0.06 line {10.763 4.012 -7.471} (chain='C' and resno=34 and atomname='ND1') color red
draw site1_b2 width 0.06 line {10.763 4.012 -7.471} (chain='C' and resno=2 and atomname='O') color red
draw site1_b3 width 0.06 line {10.763 4.012 -7.471} (chain='C' and resno=4 and atomname='O') color red
draw site1_b4 width 0.06 line {10.763 4.012 -7.471} (chain='C' and resno=32 and atomname='O') color red
set echo site1_label {10.763 4.012 -7.471}
echo bvp 0.341
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
