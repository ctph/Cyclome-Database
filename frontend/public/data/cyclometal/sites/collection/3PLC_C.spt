# 3PLC_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.322 A | donors C:ASP20:O;C:ASP57:O;C:THR58:O;C:CYS56:O | metals: cobalt,copper,manganese,nickel

load "3PLC_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.322 A) ----
select (resno=20 or resno=56 or resno=57 or resno=58) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=20 or resno=56 or resno=57 or resno=58) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {12.092 -29.878 -25.528} color red
draw site1_b1 width 0.06 line {12.092 -29.878 -25.528} (chain='C' and resno=20 and atomname='O') color red
draw site1_b2 width 0.06 line {12.092 -29.878 -25.528} (chain='C' and resno=57 and atomname='O') color red
draw site1_b3 width 0.06 line {12.092 -29.878 -25.528} (chain='C' and resno=58 and atomname='O') color red
draw site1_b4 width 0.06 line {12.092 -29.878 -25.528} (chain='C' and resno=56 and atomname='O') color red
set echo site1_label {12.092 -29.878 -25.528}
echo pyv 0.322
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
