load "3EVS_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tpv (RMSD 0.347 A) ----
select (resno=59 or resno=60 or resno=61 or resno=88 or resno=117) and chain='B'
wireframe 0.18
color wireframe cpk
