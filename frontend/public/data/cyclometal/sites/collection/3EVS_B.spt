color wireframe red
draw site1_center sphere diameter 1.4 {0.960 29.273 30.003} color red
draw site1_b1 width 0.06 line {0.960 29.273 30.003} (chain='B' and resno=61 and atomname='OE1') color red
draw site1_b2 width 0.06 line {0.960 29.273 30.003} (chain='B' and resno=60 and atomname='O') color red
