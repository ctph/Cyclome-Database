# Site 1 (red): pyv RMSD 0.291 A | donors A:THR19:OG1;A:CYS18:O;A:PRO16:O;A:GLY17:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.418 A | donors A:THR26:O;A:THR19:OG1;A:THR26:OG1;A:ARG27:O | metals: cobalt,copper,manganese,nickel,samarium
# Site 3 (green): bva RMSD 0.455 A | donors A:THR19:OG1;A:ARG27:O;A:THR26:OG1;A:THR26:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2MH1_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.291 A) ----
select (resno=16 or resno=17 or resno=18 or resno=19) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=16 or resno=17 or resno=18 or resno=19) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.758 -3.302 -3.275} color red
draw site1_b1 width 0.06 line {-5.758 -3.302 -3.275} (chain='A' and resno=19 and atomname='OG1') color red
draw site1_b2 width 0.06 line {-5.758 -3.302 -3.275} (chain='A' and resno=18 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.758 -3.302 -3.275} (chain='A' and resno=16 and atomname='O') color red
draw site1_b4 width 0.06 line {-5.758 -3.302 -3.275} (chain='A' and resno=17 and atomname='O') color red
set echo site1_label {-5.758 -3.302 -3.275}
echo pyv 0.291
color echo black
font echo 18

