draw site2_b2 width 0.06 line {-4.293 1.294 -3.155} (chain='A' and resno=19 and atomname='OG1') color blue
draw site2_b3 width 0.06 line {-4.293 1.294 -3.155} (chain='A' and resno=26 and atomname='OG1') color blue
draw site2_b4 width 0.06 line {-4.293 1.294 -3.155} (chain='A' and resno=27 and atomname='O') color blue
set echo site2_label {-4.293 1.294 -3.155}
