# 1YWH_I: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.136 A | donors I:ALA84:O;I:ARG83:O;I:SER81:O;I:GLY82:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.248 A | donors I:MET219:SD;I:CYS241:O;I:MET219:O;I:HIS160:NE2 | metals: cobalt,copper,manganese,nickel,samarium
# Site 3 (green): tbp RMSD 0.416 A | donors I:HIS249:NE2;I:GLY152:O;I:SER245:OG;I:HIS251:NE2;I:ASN157:OD1 | metals: cobalt,copper,manganese,nickel

load "1YWH_I.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.136 A) ----
select (resno=81 or resno=82 or resno=83 or resno=84) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=81 or resno=82 or resno=83 or resno=84) and chain='I' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {49.495 -2.715 53.026} color red
draw site1_b1 width 0.06 line {49.495 -2.715 53.026} (chain='I' and resno=84 and atomname='O') color red
draw site1_b2 width 0.06 line {49.495 -2.715 53.026} (chain='I' and resno=83 and atomname='O') color red
draw site1_b3 width 0.06 line {49.495 -2.715 53.026} (chain='I' and resno=81 and atomname='O') color red
draw site1_b4 width 0.06 line {49.495 -2.715 53.026} (chain='I' and resno=82 and atomname='O') color red
set echo site1_label {49.495 -2.715 53.026}
echo pyv 0.136
color echo black
font echo 18

