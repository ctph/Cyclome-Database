draw site2_center sphere diameter 1.4 {72.055 12.092 78.342} color blue
draw site2_b1 width 0.06 line {72.055 12.092 78.342} (chain='I' and resno=219 and atomname='SD') color blue
draw site2_b2 width 0.06 line {72.055 12.092 78.342} (chain='I' and resno=241 and atomname='O') color blue
draw site2_b3 width 0.06 line {72.055 12.092 78.342} (chain='I' and resno=219 and atomname='O') color blue
draw site2_b4 width 0.06 line {72.055 12.092 78.342} (chain='I' and resno=160 and atomname='NE2') color blue
set echo site2_label {72.055 12.092 78.342}
echo tet 0.248
color echo black
font echo 18

# ---- Site 3: tbp (RMSD 0.416 A) ----
select (resno=152 or resno=157 or resno=245 or resno=249 or resno=251) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=152 or resno=157 or resno=245 or resno=249 or resno=251) and chain='I' and carbon
color wireframe green
draw site3_center sphere diameter 1.4 {65.307 1.251 72.780} color green
draw site3_b1 width 0.06 line {65.307 1.251 72.780} (chain='I' and resno=249 and atomname='NE2') color green
draw site3_b2 width 0.06 line {65.307 1.251 72.780} (chain='I' and resno=152 and atomname='O') color green
draw site3_b3 width 0.06 line {65.307 1.251 72.780} (chain='I' and resno=245 and atomname='OG') color green
