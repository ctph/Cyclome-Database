# Site 2 (blue): tpv RMSD 0.457 A | donors H:VAL160:O;H:VAL133:O;H:HIS199:NE2;H:PHE135:O;H:THR201:OG1 | metals: cobalt,copper,manganese

load "4Z6A_H.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.399 A) ----
select (resno=49 or resno=50 or resno=108 or resno=110) and chain='H'
wireframe 0.18
color wireframe cpk
select (resno=49 or resno=50 or resno=108 or resno=110) and chain='H' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-19.840 -25.904 60.549} color red
draw site1_b1 width 0.06 line {-19.840 -25.904 60.549} (chain='H' and resno=49 and atomname='O') color red
draw site1_b2 width 0.06 line {-19.840 -25.904 60.549} (chain='H' and resno=108 and atomname='O') color red
draw site1_b3 width 0.06 line {-19.840 -25.904 60.549} (chain='H' and resno=50 and atomname='O') color red
draw site1_b4 width 0.06 line {-19.840 -25.904 60.549} (chain='H' and resno=110 and atomname='O') color red
set echo site1_label {-19.840 -25.904 60.549}
echo spl 0.399
color echo black
font echo 18

# ---- Site 2: tpv (RMSD 0.457 A) ----
