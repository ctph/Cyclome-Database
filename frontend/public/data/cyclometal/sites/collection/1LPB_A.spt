# 1LPB_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.436 A | donors A:VAL57:O;A:ALA51:O;A:ASN81:O;A:LYS60:O | metals: cobalt,copper,manganese,nickel,samarium

load "1LPB_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.436 A) ----
select (resno=51 or resno=57 or resno=60 or resno=81) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=51 or resno=57 or resno=60 or resno=81) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-6.991 9.798 15.409} color red
draw site1_b1 width 0.06 line {-6.991 9.798 15.409} (chain='A' and resno=57 and atomname='O') color red
draw site1_b2 width 0.06 line {-6.991 9.798 15.409} (chain='A' and resno=51 and atomname='O') color red
draw site1_b3 width 0.06 line {-6.991 9.798 15.409} (chain='A' and resno=81 and atomname='O') color red
draw site1_b4 width 0.06 line {-6.991 9.798 15.409} (chain='A' and resno=60 and atomname='O') color red
set echo site1_label {-6.991 9.798 15.409}
echo tet 0.436
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
