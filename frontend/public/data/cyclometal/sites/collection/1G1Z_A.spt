color wireframe red
draw site1_center sphere diameter 1.4 {3.340 9.863 -2.605} color red
draw site1_b1 width 0.06 line {3.340 9.863 -2.605} (chain='A' and resno=17 and atomname='OD1') color red
draw site1_b2 width 0.06 line {3.340 9.863 -2.605} (chain='A' and resno=2 and atomname='OD2') color red
draw site1_b3 width 0.06 line {3.340 9.863 -2.605} (chain='A' and resno=17 and atomname='O') color red
draw site1_b4 width 0.06 line {3.340 9.863 -2.605} (chain='A' and resno=3 and atomname='O') color red
set echo site1_label {3.340 9.863 -2.605}
