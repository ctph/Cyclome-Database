load "1G1Z_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.342 A) ----
select (resno=2 or resno=3 or resno=17) and chain='A'
