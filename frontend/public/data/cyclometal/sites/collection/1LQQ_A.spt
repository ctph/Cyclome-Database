# 1LQQ_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.284 A | donors A:LYS62:O;A:HIS64:NE2;A:TYR10:O;A:ASN11:O | metals: cobalt,copper,manganese,nickel

load "1LQQ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.284 A) ----
select (resno=10 or resno=11 or resno=62 or resno=64) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=10 or resno=11 or resno=62 or resno=64) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-12.843 5.189 1.487} color red
draw site1_b1 width 0.06 line {-12.843 5.189 1.487} (chain='A' and resno=62 and atomname='O') color red
draw site1_b2 width 0.06 line {-12.843 5.189 1.487} (chain='A' and resno=64 and atomname='NE2') color red
draw site1_b3 width 0.06 line {-12.843 5.189 1.487} (chain='A' and resno=10 and atomname='O') color red
draw site1_b4 width 0.06 line {-12.843 5.189 1.487} (chain='A' and resno=11 and atomname='O') color red
set echo site1_label {-12.843 5.189 1.487}
echo bvp 0.284
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
