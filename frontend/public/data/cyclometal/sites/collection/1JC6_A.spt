# 1JC6_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.308 A | donors A:GLN54:O;A:ARG55:O;A:TYR61:OH;A:ALA58:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.444 A | donors A:SER27:OG;A:HIS28:NE2;A:ASN26:OD1;A:ASN8:O | metals: cobalt,copper,manganese,nickel,samarium

load "1JC6_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.308 A) ----
select (resno=54 or resno=55 or resno=58 or resno=61) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=54 or resno=55 or resno=58 or resno=61) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-3.799 -11.246 -3.101} color red
draw site1_b1 width 0.06 line {-3.799 -11.246 -3.101} (chain='A' and resno=54 and atomname='O') color red
draw site1_b2 width 0.06 line {-3.799 -11.246 -3.101} (chain='A' and resno=55 and atomname='O') color red
draw site1_b3 width 0.06 line {-3.799 -11.246 -3.101} (chain='A' and resno=61 and atomname='OH') color red
draw site1_b4 width 0.06 line {-3.799 -11.246 -3.101} (chain='A' and resno=58 and atomname='O') color red
set echo site1_label {-3.799 -11.246 -3.101}
echo pyv 0.308
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.444 A) ----
select (resno=8 or resno=26 or resno=27 or resno=28) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=8 or resno=26 or resno=27 or resno=28) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {8.976 -1.647 -0.239} color blue
draw site2_b1 width 0.06 line {8.976 -1.647 -0.239} (chain='A' and resno=27 and atomname='OG') color blue
draw site2_b2 width 0.06 line {8.976 -1.647 -0.239} (chain='A' and resno=28 and atomname='NE2') color blue
draw site2_b3 width 0.06 line {8.976 -1.647 -0.239} (chain='A' and resno=26 and atomname='OD1') color blue
draw site2_b4 width 0.06 line {8.976 -1.647 -0.239} (chain='A' and resno=8 and atomname='O') color blue
set echo site2_label {8.976 -1.647 -0.239}
echo tet 0.444
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
