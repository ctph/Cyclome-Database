# Site 4 (orange): tet RMSD 0.431 A | donors A:GLU2:O;A:GLN11:O;A:CYS13:O;A:ILE19:O | metals: cobalt,copper,manganese,nickel,samarium

load "1LSI_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.162 A) ----
select (resno=21 or resno=38 or resno=39) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=21 or resno=38 or resno=39) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.588 0.418 -4.603} color red
draw site1_b1 width 0.06 line {1.588 0.418 -4.603} (chain='A' and resno=21 and atomname='OH') color red
draw site1_b2 width 0.06 line {1.588 0.418 -4.603} (chain='A' and resno=38 and atomname='O') color red
draw site1_b3 width 0.06 line {1.588 0.418 -4.603} (chain='A' and resno=39 and atomname='O') color red
draw site1_b4 width 0.06 line {1.588 0.418 -4.603} (chain='A' and resno=38 and atomname='OE1') color red
set echo site1_label {1.588 0.418 -4.603}
echo tet 0.162
color echo black
font echo 18

