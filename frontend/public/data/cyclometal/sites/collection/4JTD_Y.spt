# 4JTD_Y: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.409 A | donors Y:TRP14:O;Y:THR23:O;Y:SER24:OG;Y:SER24:O | metals: cobalt,copper,manganese,nickel

load "4JTD_Y.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.409 A) ----
select (resno=14 or resno=23 or resno=24) and chain='Y'
wireframe 0.18
color wireframe cpk
select (resno=14 or resno=23 or resno=24) and chain='Y' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-4.070 83.060 338.145} color red
draw site1_b1 width 0.06 line {-4.070 83.060 338.145} (chain='Y' and resno=14 and atomname='O') color red
draw site1_b2 width 0.06 line {-4.070 83.060 338.145} (chain='Y' and resno=23 and atomname='O') color red
draw site1_b3 width 0.06 line {-4.070 83.060 338.145} (chain='Y' and resno=24 and atomname='OG') color red
draw site1_b4 width 0.06 line {-4.070 83.060 338.145} (chain='Y' and resno=24 and atomname='O') color red
set echo site1_label {-4.070 83.060 338.145}
echo pyv 0.409
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
