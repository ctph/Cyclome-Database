# 6ZOI_D: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.141 A | donors D:THR17:O;D:SER19:OG;D:ASN38:OD1;D:ASN38:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): spl RMSD 0.218 A | donors D:GLY16:O;D:SER19:OG;D:THR17:O;D:ASN38:OD1 | metals: cobalt,copper,europium,manganese,nickel

load "6ZOI_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.141 A) ----
select (resno=17 or resno=19 or resno=38) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=17 or resno=19 or resno=38) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {13.065 -25.673 10.153} color red
draw site1_b1 width 0.06 line {13.065 -25.673 10.153} (chain='D' and resno=17 and atomname='O') color red
draw site1_b2 width 0.06 line {13.065 -25.673 10.153} (chain='D' and resno=19 and atomname='OG') color red
draw site1_b3 width 0.06 line {13.065 -25.673 10.153} (chain='D' and resno=38 and atomname='OD1') color red
draw site1_b4 width 0.06 line {13.065 -25.673 10.153} (chain='D' and resno=38 and atomname='O') color red
set echo site1_label {13.065 -25.673 10.153}
echo bvp 0.141
color echo black
font echo 18

# ---- Site 2: spl (RMSD 0.218 A) ----
select (resno=16 or resno=17 or resno=19 or resno=38) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=16 or resno=17 or resno=19 or resno=38) and chain='D' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {12.983 -25.829 10.097} color blue
draw site2_b1 width 0.06 line {12.983 -25.829 10.097} (chain='D' and resno=16 and atomname='O') color blue
draw site2_b2 width 0.06 line {12.983 -25.829 10.097} (chain='D' and resno=19 and atomname='OG') color blue
draw site2_b3 width 0.06 line {12.983 -25.829 10.097} (chain='D' and resno=17 and atomname='O') color blue
draw site2_b4 width 0.06 line {12.983 -25.829 10.097} (chain='D' and resno=38 and atomname='OD1') color blue
set echo site2_label {12.983 -25.829 10.097}
echo spl 0.218
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
