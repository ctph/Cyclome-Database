# 7N0T_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.259 A | donors A:TYR15:O;A:CYS8:O;A:ASP5:O;A:ASN9:OD1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bvp RMSD 0.424 A | donors A:TYR15:O;A:CYS8:O;A:ASP5:O;A:ASN9:OD1 | metals: cobalt,copper,manganese,nickel
# Site 3 (green): tbp RMSD 0.481 A | donors A:CYS8:O;A:ASP5:O;A:ASN9:OD1;A:CYS16:O;A:CYS3:O | metals: cobalt,copper,manganese,nickel

load "7N0T_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.259 A) ----
select (resno=5 or resno=8 or resno=9 or resno=15) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=8 or resno=9 or resno=15) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.295 1.514 1.397} color red
draw site1_b1 width 0.06 line {0.295 1.514 1.397} (chain='A' and resno=15 and atomname='O') color red
draw site1_b2 width 0.06 line {0.295 1.514 1.397} (chain='A' and resno=8 and atomname='O') color red
draw site1_b3 width 0.06 line {0.295 1.514 1.397} (chain='A' and resno=5 and atomname='O') color red
draw site1_b4 width 0.06 line {0.295 1.514 1.397} (chain='A' and resno=9 and atomname='OD1') color red
set echo site1_label {0.295 1.514 1.397}
echo pyv 0.259
color echo black
font echo 18

