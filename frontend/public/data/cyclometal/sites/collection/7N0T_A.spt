draw site2_b2 width 0.06 line {0.491 1.148 1.322} (chain='A' and resno=8 and atomname='O') color blue
draw site2_b3 width 0.06 line {0.491 1.148 1.322} (chain='A' and resno=5 and atomname='O') color blue
draw site2_b4 width 0.06 line {0.491 1.148 1.322} (chain='A' and resno=9 and atomname='OD1') color blue
