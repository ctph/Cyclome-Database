# 1GNA_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.425 A | donors A:CYS99:O;A:ALA94:O;A:THR97:OG1;A:CYS96:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1GNA_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.425 A) ----
select (resno=94 or resno=96 or resno=97 or resno=99) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=94 or resno=96 or resno=97 or resno=99) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.909 -6.941 -1.378} color red
draw site1_b1 width 0.06 line {0.909 -6.941 -1.378} (chain='A' and resno=99 and atomname='O') color red
draw site1_b2 width 0.06 line {0.909 -6.941 -1.378} (chain='A' and resno=94 and atomname='O') color red
draw site1_b3 width 0.06 line {0.909 -6.941 -1.378} (chain='A' and resno=97 and atomname='OG1') color red
draw site1_b4 width 0.06 line {0.909 -6.941 -1.378} (chain='A' and resno=96 and atomname='O') color red
set echo site1_label {0.909 -6.941 -1.378}
echo bva 0.425
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
