# 5HBT_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.212 A | donors C:THR99:OG1;C:GLN6:O;C:THR101:OG1;C:GLN6:OE1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.303 A | donors C:ASN189:O;C:TYR185:OH;C:GLU186:OE2;C:TYR191:OH | metals: cobalt,copper,manganese,nickel,samarium

load "5HBT_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.212 A) ----
select (resno=6 or resno=99 or resno=101) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=99 or resno=101) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {15.998 -14.625 50.883} color red
draw site1_b1 width 0.06 line {15.998 -14.625 50.883} (chain='C' and resno=99 and atomname='OG1') color red
draw site1_b2 width 0.06 line {15.998 -14.625 50.883} (chain='C' and resno=6 and atomname='O') color red
draw site1_b3 width 0.06 line {15.998 -14.625 50.883} (chain='C' and resno=101 and atomname='OG1') color red
draw site1_b4 width 0.06 line {15.998 -14.625 50.883} (chain='C' and resno=6 and atomname='OE1') color red
set echo site1_label {15.998 -14.625 50.883}
echo bvp 0.212
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.303 A) ----
select (resno=185 or resno=186 or resno=189 or resno=191) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=185 or resno=186 or resno=189 or resno=191) and chain='C' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {18.506 -13.502 98.062} color blue
draw site2_b1 width 0.06 line {18.506 -13.502 98.062} (chain='C' and resno=189 and atomname='O') color blue
draw site2_b2 width 0.06 line {18.506 -13.502 98.062} (chain='C' and resno=185 and atomname='OH') color blue
draw site2_b3 width 0.06 line {18.506 -13.502 98.062} (chain='C' and resno=186 and atomname='OE2') color blue
draw site2_b4 width 0.06 line {18.506 -13.502 98.062} (chain='C' and resno=191 and atomname='OH') color blue
set echo site2_label {18.506 -13.502 98.062}
echo tet 0.303
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
