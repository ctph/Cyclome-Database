# 2LKB_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.344 A | donors A:LYS8:O;A:ILE6:O;A:ASP3:OD2;A:ALA7:O | metals: cobalt,copper,manganese,nickel

load "2LKB_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.344 A) ----
select (resno=3 or resno=6 or resno=7 or resno=8) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=6 or resno=7 or resno=8) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-1.464 3.963 -1.741} color red
draw site1_b1 width 0.06 line {-1.464 3.963 -1.741} (chain='A' and resno=8 and atomname='O') color red
draw site1_b2 width 0.06 line {-1.464 3.963 -1.741} (chain='A' and resno=6 and atomname='O') color red
draw site1_b3 width 0.06 line {-1.464 3.963 -1.741} (chain='A' and resno=3 and atomname='OD2') color red
draw site1_b4 width 0.06 line {-1.464 3.963 -1.741} (chain='A' and resno=7 and atomname='O') color red
set echo site1_label {-1.464 3.963 -1.741}
echo pyv 0.344
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
