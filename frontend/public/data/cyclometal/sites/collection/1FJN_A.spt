# 1FJN_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.340 A | donors A:LYS15:O;A:ILE17:O;A:ARG20:O;A:CYS14:O | metals: cobalt,copper,manganese,nickel

load "1FJN_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.340 A) ----
select (resno=14 or resno=15 or resno=17 or resno=20) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=14 or resno=15 or resno=17 or resno=20) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {9.185 0.966 -0.461} color red
draw site1_b1 width 0.06 line {9.185 0.966 -0.461} (chain='A' and resno=15 and atomname='O') color red
draw site1_b2 width 0.06 line {9.185 0.966 -0.461} (chain='A' and resno=17 and atomname='O') color red
draw site1_b3 width 0.06 line {9.185 0.966 -0.461} (chain='A' and resno=20 and atomname='O') color red
draw site1_b4 width 0.06 line {9.185 0.966 -0.461} (chain='A' and resno=14 and atomname='O') color red
set echo site1_label {9.185 0.966 -0.461}
echo pyv 0.340
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
