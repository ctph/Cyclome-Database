# 1VNA_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.266 A | donors A:ASN26:O;A:GLY36:O;A:SER37:O;A:CYS29:O | metals: cobalt,copper,europium,manganese,nickel

load "1VNA_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.266 A) ----
select (resno=26 or resno=29 or resno=36 or resno=37) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=26 or resno=29 or resno=36 or resno=37) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {8.690 4.537 -0.744} color red
draw site1_b1 width 0.06 line {8.690 4.537 -0.744} (chain='A' and resno=26 and atomname='O') color red
draw site1_b2 width 0.06 line {8.690 4.537 -0.744} (chain='A' and resno=36 and atomname='O') color red
draw site1_b3 width 0.06 line {8.690 4.537 -0.744} (chain='A' and resno=37 and atomname='O') color red
draw site1_b4 width 0.06 line {8.690 4.537 -0.744} (chain='A' and resno=29 and atomname='O') color red
set echo site1_label {8.690 4.537 -0.744}
echo spl 0.266
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
