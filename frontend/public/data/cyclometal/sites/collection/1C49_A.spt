# 1C49_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.465 A | donors A:ASN25:OD1;A:ALA26:O;A:GLU10:OE1;A:TYR14:OH | metals: cobalt,copper,manganese,nickel

load "1C49_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.465 A) ----
select (resno=10 or resno=14 or resno=25 or resno=26) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=10 or resno=14 or resno=25 or resno=26) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-4.128 -1.004 7.981} color red
draw site1_b1 width 0.06 line {-4.128 -1.004 7.981} (chain='A' and resno=25 and atomname='OD1') color red
draw site1_b2 width 0.06 line {-4.128 -1.004 7.981} (chain='A' and resno=26 and atomname='O') color red
draw site1_b3 width 0.06 line {-4.128 -1.004 7.981} (chain='A' and resno=10 and atomname='OE1') color red
draw site1_b4 width 0.06 line {-4.128 -1.004 7.981} (chain='A' and resno=14 and atomname='OH') color red
set echo site1_label {-4.128 -1.004 7.981}
echo pyv 0.465
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
