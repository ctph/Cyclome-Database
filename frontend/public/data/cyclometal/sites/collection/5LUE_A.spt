# 5LUE_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.383 A | donors A:ARG36:O;A:LYS35:O;A:MET24:SD;A:TYR22:OH | metals: cobalt,copper,manganese,nickel

load "5LUE_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.383 A) ----
select (resno=22 or resno=24 or resno=35 or resno=36) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=22 or resno=24 or resno=35 or resno=36) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.963 -2.764 5.054} color red
draw site1_b1 width 0.06 line {0.963 -2.764 5.054} (chain='A' and resno=36 and atomname='O') color red
draw site1_b2 width 0.06 line {0.963 -2.764 5.054} (chain='A' and resno=35 and atomname='O') color red
draw site1_b3 width 0.06 line {0.963 -2.764 5.054} (chain='A' and resno=24 and atomname='SD') color red
draw site1_b4 width 0.06 line {0.963 -2.764 5.054} (chain='A' and resno=22 and atomname='OH') color red
set echo site1_label {0.963 -2.764 5.054}
echo bvp 0.383
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
