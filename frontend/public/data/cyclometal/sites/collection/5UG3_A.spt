load "5UG3_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.387 A) ----
select (resno=2 or resno=3 or resno=18) and chain='A'
