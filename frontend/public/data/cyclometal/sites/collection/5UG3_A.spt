draw site1_center sphere diameter 1.4 {-3.271 -0.553 -2.394} color red
draw site1_b1 width 0.06 line {-3.271 -0.553 -2.394} (chain='A' and resno=3 and atomname='O') color red
draw site1_b2 width 0.06 line {-3.271 -0.553 -2.394} (chain='A' and resno=2 and atomname='O') color red
