color wireframe red
draw site1_center sphere diameter 1.4 {-4.065 -5.674 16.650} color red
draw site1_b1 width 0.06 line {-4.065 -5.674 16.650} (chain='A' and resno=6 and atomname='SG') color red
draw site1_b2 width 0.06 line {-4.065 -5.674 16.650} (chain='A' and resno=18 and atomname='SG') color red
