load "4X9Z_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.218 A) ----
select (resno=5 or resno=6 or resno=17 or resno=18) and chain='A'
wireframe 0.18
color wireframe cpk
