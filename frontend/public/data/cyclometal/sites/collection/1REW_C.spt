# 1REW_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.281 A | donors C:HIS58:ND1;C:ASN56:O;C:TYR80:O;C:MET78:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1REW_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.281 A) ----
select (resno=56 or resno=58 or resno=78 or resno=80) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=56 or resno=58 or resno=78 or resno=80) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-25.807 78.404 46.550} color red
draw site1_b1 width 0.06 line {-25.807 78.404 46.550} (chain='C' and resno=58 and atomname='ND1') color red
draw site1_b2 width 0.06 line {-25.807 78.404 46.550} (chain='C' and resno=56 and atomname='O') color red
draw site1_b3 width 0.06 line {-25.807 78.404 46.550} (chain='C' and resno=80 and atomname='O') color red
draw site1_b4 width 0.06 line {-25.807 78.404 46.550} (chain='C' and resno=78 and atomname='O') color red
set echo site1_label {-25.807 78.404 46.550}
echo bva 0.281
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
