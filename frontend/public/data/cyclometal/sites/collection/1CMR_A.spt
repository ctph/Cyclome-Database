# Site 1 (red): spl RMSD 0.310 A | donors A:ARG13:O;A:HIS15:O;A:GLN12:O;A:LEU14:O | metals: cobalt,copper,europium,manganese,nickel

load "1CMR_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.310 A) ----
select (resno=12 or resno=13 or resno=14 or resno=15) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=12 or resno=13 or resno=14 or resno=15) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {5.302 -9.769 1.579} color red
draw site1_b1 width 0.06 line {5.302 -9.769 1.579} (chain='A' and resno=13 and atomname='O') color red
draw site1_b2 width 0.06 line {5.302 -9.769 1.579} (chain='A' and resno=15 and atomname='O') color red
draw site1_b3 width 0.06 line {5.302 -9.769 1.579} (chain='A' and resno=12 and atomname='O') color red
draw site1_b4 width 0.06 line {5.302 -9.769 1.579} (chain='A' and resno=14 and atomname='O') color red
set echo site1_label {5.302 -9.769 1.579}
echo spl 0.310
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
