load "1DAN_L.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.125 A) ----
select (resno=46 or resno=47 or resno=63 or resno=64) and chain='L'
wireframe 0.18
color wireframe cpk
select (resno=46 or resno=47 or resno=63 or resno=64) and chain='L' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {36.824 25.990 69.441} color red
draw site1_b1 width 0.06 line {36.824 25.990 69.441} (chain='L' and resno=46 and atomname='OD2') color red
draw site1_b2 width 0.06 line {36.824 25.990 69.441} (chain='L' and resno=63 and atomname='OD1') color red
draw site1_b3 width 0.06 line {36.824 25.990 69.441} (chain='L' and resno=47 and atomname='O') color red
draw site1_b4 width 0.06 line {36.824 25.990 69.441} (chain='L' and resno=64 and atomname='O') color red
set echo site1_label {36.824 25.990 69.441}
echo spl 0.125
color echo black
font echo 18

