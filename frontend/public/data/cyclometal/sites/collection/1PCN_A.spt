# 1PCN_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.233 A | donors A:ASP12:OD1;A:GLU13:OE1;A:SER25:OG;A:LEU11:O | metals: cobalt,copper,manganese,nickel

load "1PCN_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.233 A) ----
select (resno=11 or resno=12 or resno=13 or resno=25) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=12 or resno=13 or resno=25) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.376 -4.637 -13.586} color red
draw site1_b1 width 0.06 line {-5.376 -4.637 -13.586} (chain='A' and resno=12 and atomname='OD1') color red
draw site1_b2 width 0.06 line {-5.376 -4.637 -13.586} (chain='A' and resno=13 and atomname='OE1') color red
draw site1_b3 width 0.06 line {-5.376 -4.637 -13.586} (chain='A' and resno=25 and atomname='OG') color red
draw site1_b4 width 0.06 line {-5.376 -4.637 -13.586} (chain='A' and resno=11 and atomname='O') color red
set echo site1_label {-5.376 -4.637 -13.586}
echo bvp 0.233
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
