# 5VYP_K: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.242 A | donors K:HIS33:ND1;K:ASP31:OD2;K:ASP31:O;K:GLY32:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): bvp RMSD 0.293 A | donors K:THR44:OG1;K:ASP31:OD2;K:GLY32:O;K:HIS33:ND1 | metals: cobalt,copper,manganese,nickel

load "5VYP_K.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.242 A) ----
select (resno=31 or resno=32 or resno=33) and chain='K'
wireframe 0.18
color wireframe cpk
select (resno=31 or resno=32 or resno=33) and chain='K' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {7.608 -16.615 -42.693} color red
draw site1_b1 width 0.06 line {7.608 -16.615 -42.693} (chain='K' and resno=33 and atomname='ND1') color red
draw site1_b2 width 0.06 line {7.608 -16.615 -42.693} (chain='K' and resno=31 and atomname='OD2') color red
draw site1_b3 width 0.06 line {7.608 -16.615 -42.693} (chain='K' and resno=31 and atomname='O') color red
draw site1_b4 width 0.06 line {7.608 -16.615 -42.693} (chain='K' and resno=32 and atomname='O') color red
set echo site1_label {7.608 -16.615 -42.693}
echo bva 0.242
color echo black
font echo 18

# ---- Site 2: bvp (RMSD 0.293 A) ----
select (resno=31 or resno=32 or resno=33 or resno=44) and chain='K'
wireframe 0.18
color wireframe cpk
select (resno=31 or resno=32 or resno=33 or resno=44) and chain='K' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {7.719 -16.848 -42.291} color blue
draw site2_b1 width 0.06 line {7.719 -16.848 -42.291} (chain='K' and resno=44 and atomname='OG1') color blue
draw site2_b2 width 0.06 line {7.719 -16.848 -42.291} (chain='K' and resno=31 and atomname='OD2') color blue
draw site2_b3 width 0.06 line {7.719 -16.848 -42.291} (chain='K' and resno=32 and atomname='O') color blue
draw site2_b4 width 0.06 line {7.719 -16.848 -42.291} (chain='K' and resno=33 and atomname='ND1') color blue
set echo site2_label {7.719 -16.848 -42.291}
echo bvp 0.293
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
