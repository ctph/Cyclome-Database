# 4NTY_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.132 A | donors A:HIS164:ND1;A:ILE225:O;A:ASP224:O;A:MET169:SD | metals: cobalt,copper,manganese,nickel

load "4NTY_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.132 A) ----
select (resno=164 or resno=169 or resno=224 or resno=225) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=164 or resno=169 or resno=224 or resno=225) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {19.147 1.338 11.545} color red
draw site1_b1 width 0.06 line {19.147 1.338 11.545} (chain='A' and resno=164 and atomname='ND1') color red
draw site1_b2 width 0.06 line {19.147 1.338 11.545} (chain='A' and resno=225 and atomname='O') color red
draw site1_b3 width 0.06 line {19.147 1.338 11.545} (chain='A' and resno=224 and atomname='O') color red
draw site1_b4 width 0.06 line {19.147 1.338 11.545} (chain='A' and resno=169 and atomname='SD') color red
set echo site1_label {19.147 1.338 11.545}
echo bvp 0.132
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
