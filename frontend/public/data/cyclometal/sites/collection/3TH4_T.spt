# 3TH4_T: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.153 A | donors T:PRO206:O;T:SER205:OG;T:SER188:OG;T:SER205:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.261 A | donors T:ASP204:OD1;T:SER188:OG;T:SER188:O;T:VAL189:O | metals: cobalt,copper,manganese,nickel

load "3TH4_T.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.153 A) ----
select (resno=188 or resno=205 or resno=206) and chain='T'
wireframe 0.18
color wireframe cpk
select (resno=188 or resno=205 or resno=206) and chain='T' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {32.780 15.795 76.755} color red
draw site1_b1 width 0.06 line {32.780 15.795 76.755} (chain='T' and resno=206 and atomname='O') color red
draw site1_b2 width 0.06 line {32.780 15.795 76.755} (chain='T' and resno=205 and atomname='OG') color red
draw site1_b3 width 0.06 line {32.780 15.795 76.755} (chain='T' and resno=188 and atomname='OG') color red
draw site1_b4 width 0.06 line {32.780 15.795 76.755} (chain='T' and resno=205 and atomname='O') color red
set echo site1_label {32.780 15.795 76.755}
echo pyv 0.153
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.261 A) ----
select (resno=188 or resno=189 or resno=204) and chain='T'
wireframe 0.18
color wireframe cpk
select (resno=188 or resno=189 or resno=204) and chain='T' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {32.981 11.393 74.788} color blue
draw site2_b1 width 0.06 line {32.981 11.393 74.788} (chain='T' and resno=204 and atomname='OD1') color blue
draw site2_b2 width 0.06 line {32.981 11.393 74.788} (chain='T' and resno=188 and atomname='OG') color blue
draw site2_b3 width 0.06 line {32.981 11.393 74.788} (chain='T' and resno=188 and atomname='O') color blue
draw site2_b4 width 0.06 line {32.981 11.393 74.788} (chain='T' and resno=189 and atomname='O') color blue
set echo site2_label {32.981 11.393 74.788}
echo pyv 0.261
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
