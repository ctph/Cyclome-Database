# 1H9I_I: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.319 A | donors I:ASP12:O;I:LEU16:O;I:CYS15:O;I:CYS19:O | metals: cobalt,copper,europium,manganese,nickel
# Site 2 (blue): bva RMSD 0.478 A | donors I:SER29:O;I:CYS27:O;I:THR22:OG1;I:VAL20:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1H9I_I.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.319 A) ----
select (resno=12 or resno=15 or resno=16 or resno=19) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=12 or resno=15 or resno=16 or resno=19) and chain='I' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {50.130 105.790 -11.467} color red
draw site1_b1 width 0.06 line {50.130 105.790 -11.467} (chain='I' and resno=12 and atomname='O') color red
draw site1_b2 width 0.06 line {50.130 105.790 -11.467} (chain='I' and resno=16 and atomname='O') color red
draw site1_b3 width 0.06 line {50.130 105.790 -11.467} (chain='I' and resno=15 and atomname='O') color red
draw site1_b4 width 0.06 line {50.130 105.790 -11.467} (chain='I' and resno=19 and atomname='O') color red
set echo site1_label {50.130 105.790 -11.467}
echo spl 0.319
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.478 A) ----
select (resno=20 or resno=22 or resno=27 or resno=29) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=20 or resno=22 or resno=27 or resno=29) and chain='I' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {53.213 109.189 -3.550} color blue
draw site2_b1 width 0.06 line {53.213 109.189 -3.550} (chain='I' and resno=29 and atomname='O') color blue
draw site2_b2 width 0.06 line {53.213 109.189 -3.550} (chain='I' and resno=27 and atomname='O') color blue
draw site2_b3 width 0.06 line {53.213 109.189 -3.550} (chain='I' and resno=22 and atomname='OG1') color blue
draw site2_b4 width 0.06 line {53.213 109.189 -3.550} (chain='I' and resno=20 and atomname='O') color blue
set echo site2_label {53.213 109.189 -3.550}
echo bva 0.478
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
