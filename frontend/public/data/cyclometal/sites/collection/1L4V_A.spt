# 1L4V_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.191 A | donors A:ASN12:OD1;A:ASN12:O;A:SER14:OG;A:ILE11:O | metals: cobalt,copper,manganese,nickel

load "1L4V_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.191 A) ----
select (resno=11 or resno=12 or resno=14) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=12 or resno=14) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.238 4.489 -2.529} color red
draw site1_b1 width 0.06 line {-5.238 4.489 -2.529} (chain='A' and resno=12 and atomname='OD1') color red
draw site1_b2 width 0.06 line {-5.238 4.489 -2.529} (chain='A' and resno=12 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.238 4.489 -2.529} (chain='A' and resno=14 and atomname='OG') color red
draw site1_b4 width 0.06 line {-5.238 4.489 -2.529} (chain='A' and resno=11 and atomname='O') color red
set echo site1_label {-5.238 4.489 -2.529}
echo pyv 0.191
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
