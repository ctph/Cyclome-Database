# 1IJC_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.258 A | donors A:THR16:OG1;A:GLU2:OE2;A:LYS14:O;A:ILE15:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1IJC_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.258 A) ----
select (resno=2 or resno=14 or resno=15 or resno=16) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=14 or resno=15 or resno=16) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-16.265 10.454 -7.815} color red
draw site1_b1 width 0.06 line {-16.265 10.454 -7.815} (chain='A' and resno=16 and atomname='OG1') color red
draw site1_b2 width 0.06 line {-16.265 10.454 -7.815} (chain='A' and resno=2 and atomname='OE2') color red
draw site1_b3 width 0.06 line {-16.265 10.454 -7.815} (chain='A' and resno=14 and atomname='O') color red
draw site1_b4 width 0.06 line {-16.265 10.454 -7.815} (chain='A' and resno=15 and atomname='O') color red
set echo site1_label {-16.265 10.454 -7.815}
echo bva 0.258
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
