# 1JMN_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.422 A | donors A:TYR13:OH;A:LYS33:O;A:ILE35:O;A:LYS1:O | metals: cobalt,copper,manganese,nickel

load "1JMN_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.422 A) ----
select (resno=1 or resno=13 or resno=33 or resno=35) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=1 or resno=13 or resno=33 or resno=35) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.185 -1.988 5.321} color red
draw site1_b1 width 0.06 line {-0.185 -1.988 5.321} (chain='A' and resno=13 and atomname='OH') color red
draw site1_b2 width 0.06 line {-0.185 -1.988 5.321} (chain='A' and resno=33 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.185 -1.988 5.321} (chain='A' and resno=35 and atomname='O') color red
draw site1_b4 width 0.06 line {-0.185 -1.988 5.321} (chain='A' and resno=1 and atomname='O') color red
set echo site1_label {-0.185 -1.988 5.321}
echo pyv 0.422
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
