draw site3_b2 width 0.06 line {4.160 -23.852 -6.379} (chain='L' and resno=63 and atomname='OD2') color green
draw site3_b3 width 0.06 line {4.160 -23.852 -6.379} (chain='L' and resno=49 and atomname='OE1') color green
