# 4ZMA_L: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.135 A | donors L:GLY47:O;L:GLN64:O;L:ASP63:OD1;L:ASP46:OD2 | metals: cobalt,copper,europium,manganese,nickel
# Site 2 (blue): tet RMSD 0.270 A | donors L:GLN49:OE1;L:GLN64:O;L:ASP63:OD2;L:ASP46:OD2 | metals: cobalt,copper,manganese,nickel,samarium
# Site 3 (green): tbp RMSD 0.307 A | donors L:GLY47:O;L:ASP63:OD2;L:GLN49:OE1;L:ASP46:OD2;L:GLN64:O | metals: cobalt,copper,manganese,nickel

load "4ZMA_L.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.135 A) ----
select (resno=46 or resno=47 or resno=63 or resno=64) and chain='L'
wireframe 0.18
color wireframe cpk
select (resno=46 or resno=47 or resno=63 or resno=64) and chain='L' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.203 -23.738 -6.212} color red
draw site1_b1 width 0.06 line {4.203 -23.738 -6.212} (chain='L' and resno=47 and atomname='O') color red
draw site1_b2 width 0.06 line {4.203 -23.738 -6.212} (chain='L' and resno=64 and atomname='O') color red
draw site1_b3 width 0.06 line {4.203 -23.738 -6.212} (chain='L' and resno=63 and atomname='OD1') color red
draw site1_b4 width 0.06 line {4.203 -23.738 -6.212} (chain='L' and resno=46 and atomname='OD2') color red
set echo site1_label {4.203 -23.738 -6.212}
echo spl 0.135
color echo black
font echo 18

