draw site2_b1 width 0.06 line {3.920 -23.529 -5.998} (chain='L' and resno=49 and atomname='OE1') color blue
draw site2_b2 width 0.06 line {3.920 -23.529 -5.998} (chain='L' and resno=64 and atomname='O') color blue
draw site2_b3 width 0.06 line {3.920 -23.529 -5.998} (chain='L' and resno=63 and atomname='OD2') color blue
draw site2_b4 width 0.06 line {3.920 -23.529 -5.998} (chain='L' and resno=46 and atomname='OD2') color blue
set echo site2_label {3.920 -23.529 -5.998}
echo tet 0.270
