# 1YZ2_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.445 A | donors A:CYS8:O;A:ALA21:O;A:ASP9:O;A:PHE22:O | metals: cobalt,copper,europium,manganese,nickel

load "1YZ2_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.445 A) ----
select (resno=8 or resno=9 or resno=21 or resno=22) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=8 or resno=9 or resno=21 or resno=22) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.990 5.364 -0.049} color red
draw site1_b1 width 0.06 line {1.990 5.364 -0.049} (chain='A' and resno=8 and atomname='O') color red
draw site1_b2 width 0.06 line {1.990 5.364 -0.049} (chain='A' and resno=21 and atomname='O') color red
draw site1_b3 width 0.06 line {1.990 5.364 -0.049} (chain='A' and resno=9 and atomname='O') color red
draw site1_b4 width 0.06 line {1.990 5.364 -0.049} (chain='A' and resno=22 and atomname='O') color red
set echo site1_label {1.990 5.364 -0.049}
echo spl 0.445
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
