# 2ODY_D: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.174 A | donors D:MET180:SD;D:ASN179:O;D:THR229:OG1;D:LEU99:O | metals: cobalt,copper,manganese,nickel

load "2ODY_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.174 A) ----
select (resno=99 or resno=179 or resno=180 or resno=229) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=99 or resno=179 or resno=180 or resno=229) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {34.686 95.818 101.994} color red
draw site1_b1 width 0.06 line {34.686 95.818 101.994} (chain='D' and resno=180 and atomname='SD') color red
draw site1_b2 width 0.06 line {34.686 95.818 101.994} (chain='D' and resno=179 and atomname='O') color red
draw site1_b3 width 0.06 line {34.686 95.818 101.994} (chain='D' and resno=229 and atomname='OG1') color red
draw site1_b4 width 0.06 line {34.686 95.818 101.994} (chain='D' and resno=99 and atomname='O') color red
set echo site1_label {34.686 95.818 101.994}
echo bvp 0.174
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
