# 6AVA_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.301 A | donors B:GLN17:OE1;B:ARG11:O;B:ASP13:OD1;B:MET14:SD | metals: cobalt,copper,europium,manganese,nickel

load "6AVA_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.301 A) ----
select (resno=11 or resno=13 or resno=14 or resno=17) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=13 or resno=14 or resno=17) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-26.534 4.377 -3.135} color red
draw site1_b1 width 0.06 line {-26.534 4.377 -3.135} (chain='B' and resno=17 and atomname='OE1') color red
draw site1_b2 width 0.06 line {-26.534 4.377 -3.135} (chain='B' and resno=11 and atomname='O') color red
draw site1_b3 width 0.06 line {-26.534 4.377 -3.135} (chain='B' and resno=13 and atomname='OD1') color red
draw site1_b4 width 0.06 line {-26.534 4.377 -3.135} (chain='B' and resno=14 and atomname='SD') color red
set echo site1_label {-26.534 4.377 -3.135}
echo spl 0.301
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
