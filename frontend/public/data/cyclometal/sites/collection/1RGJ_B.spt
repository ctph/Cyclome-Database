# 1RGJ_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.129 A | donors B:ASP13:O;B:ASP12:O;B:ASP12:OD2;B:TRP11:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.221 A | donors B:ASP13:O;B:ASP12:O;B:ASP12:OD2;B:TRP11:O | metals: cobalt,copper,manganese,nickel

load "1RGJ_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.129 A) ----
select (resno=11 or resno=12 or resno=13) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=12 or resno=13) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.764 -14.293 4.993} color red
draw site1_b1 width 0.06 line {-5.764 -14.293 4.993} (chain='B' and resno=13 and atomname='O') color red
draw site1_b2 width 0.06 line {-5.764 -14.293 4.993} (chain='B' and resno=12 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.764 -14.293 4.993} (chain='B' and resno=12 and atomname='OD2') color red
draw site1_b4 width 0.06 line {-5.764 -14.293 4.993} (chain='B' and resno=11 and atomname='O') color red
set echo site1_label {-5.764 -14.293 4.993}
echo bvp 0.129
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.221 A) ----
select (resno=11 or resno=12 or resno=13) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=12 or resno=13) and chain='B' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-5.861 -14.469 5.022} color blue
draw site2_b1 width 0.06 line {-5.861 -14.469 5.022} (chain='B' and resno=13 and atomname='O') color blue
draw site2_b2 width 0.06 line {-5.861 -14.469 5.022} (chain='B' and resno=12 and atomname='O') color blue
draw site2_b3 width 0.06 line {-5.861 -14.469 5.022} (chain='B' and resno=12 and atomname='OD2') color blue
draw site2_b4 width 0.06 line {-5.861 -14.469 5.022} (chain='B' and resno=11 and atomname='O') color blue
set echo site2_label {-5.861 -14.469 5.022}
echo pyv 0.221
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
