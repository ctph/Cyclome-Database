# 3QB4_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.187 A | donors C:GLU61:OE1;C:CYS117:O;C:HIS59:O;C:THR88:OG1 | metals: cobalt,copper,europium,manganese,nickel
# Site 2 (blue): tpv RMSD 0.424 A | donors C:GLU61:OE1;C:LEU60:O;C:THR88:OG1;C:HIS59:O;C:CYS117:O | metals: cobalt,copper,manganese

load "3QB4_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.187 A) ----
select (resno=59 or resno=61 or resno=88 or resno=117) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=59 or resno=61 or resno=88 or resno=117) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {7.820 -5.101 23.904} color red
draw site1_b1 width 0.06 line {7.820 -5.101 23.904} (chain='C' and resno=61 and atomname='OE1') color red
draw site1_b2 width 0.06 line {7.820 -5.101 23.904} (chain='C' and resno=117 and atomname='O') color red
draw site1_b3 width 0.06 line {7.820 -5.101 23.904} (chain='C' and resno=59 and atomname='O') color red
draw site1_b4 width 0.06 line {7.820 -5.101 23.904} (chain='C' and resno=88 and atomname='OG1') color red
set echo site1_label {7.820 -5.101 23.904}
echo spl 0.187
color echo black
font echo 18

# ---- Site 2: tpv (RMSD 0.424 A) ----
select (resno=59 or resno=60 or resno=61 or resno=88 or resno=117) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=59 or resno=60 or resno=61 or resno=88 or resno=117) and chain='C' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {7.523 -6.212 23.476} color blue
draw site2_b1 width 0.06 line {7.523 -6.212 23.476} (chain='C' and resno=61 and atomname='OE1') color blue
draw site2_b2 width 0.06 line {7.523 -6.212 23.476} (chain='C' and resno=60 and atomname='O') color blue
draw site2_b3 width 0.06 line {7.523 -6.212 23.476} (chain='C' and resno=88 and atomname='OG1') color blue
draw site2_b4 width 0.06 line {7.523 -6.212 23.476} (chain='C' and resno=59 and atomname='O') color blue
draw site2_b5 width 0.06 line {7.523 -6.212 23.476} (chain='C' and resno=117 and atomname='O') color blue
set echo site2_label {7.523 -6.212 23.476}
