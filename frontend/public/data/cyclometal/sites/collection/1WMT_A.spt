# 1WMT_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.238 A | donors A:ASN37:OD1;A:ASN38:O;A:TRP41:O;A:ASN22:OD1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.356 A | donors A:ASN30:OD1;A:HIS32:O;A:THR3:O;A:HIS32:ND1 | metals: cobalt,copper,manganese,nickel
# Site 3 (green): tet RMSD 0.445 A | donors A:ALA26:O;A:GLY9:O;A:CYS13:O;A:HIS32:O | metals: cobalt,copper,manganese,nickel,samarium

load "1WMT_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.238 A) ----
select (resno=22 or resno=37 or resno=38 or resno=41) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=22 or resno=37 or resno=38 or resno=41) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.164 12.483 5.152} color red
draw site1_b1 width 0.06 line {3.164 12.483 5.152} (chain='A' and resno=37 and atomname='OD1') color red
draw site1_b2 width 0.06 line {3.164 12.483 5.152} (chain='A' and resno=38 and atomname='O') color red
draw site1_b3 width 0.06 line {3.164 12.483 5.152} (chain='A' and resno=41 and atomname='O') color red
draw site1_b4 width 0.06 line {3.164 12.483 5.152} (chain='A' and resno=22 and atomname='OD1') color red
set echo site1_label {3.164 12.483 5.152}
echo bvp 0.238
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.356 A) ----
select (resno=3 or resno=30 or resno=32) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=30 or resno=32) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-0.596 -7.133 5.811} color blue
draw site2_b1 width 0.06 line {-0.596 -7.133 5.811} (chain='A' and resno=30 and atomname='OD1') color blue
draw site2_b2 width 0.06 line {-0.596 -7.133 5.811} (chain='A' and resno=32 and atomname='O') color blue
draw site2_b3 width 0.06 line {-0.596 -7.133 5.811} (chain='A' and resno=3 and atomname='O') color blue
draw site2_b4 width 0.06 line {-0.596 -7.133 5.811} (chain='A' and resno=32 and atomname='ND1') color blue
set echo site2_label {-0.596 -7.133 5.811}
echo pyv 0.356
color echo black
font echo 18

# ---- Site 3: tet (RMSD 0.445 A) ----
select (resno=9 or resno=13 or resno=26 or resno=32) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=9 or resno=13 or resno=26 or resno=32) and chain='A' and carbon
color wireframe green
draw site3_center sphere diameter 1.4 {0.572 -3.112 -1.246} color green
draw site3_b1 width 0.06 line {0.572 -3.112 -1.246} (chain='A' and resno=26 and atomname='O') color green
draw site3_b2 width 0.06 line {0.572 -3.112 -1.246} (chain='A' and resno=9 and atomname='O') color green
draw site3_b3 width 0.06 line {0.572 -3.112 -1.246} (chain='A' and resno=13 and atomname='O') color green
draw site3_b4 width 0.06 line {0.572 -3.112 -1.246} (chain='A' and resno=32 and atomname='O') color green
set echo site3_label {0.572 -3.112 -1.246}
echo tet 0.445
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
