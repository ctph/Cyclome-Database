# 1ATX_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.421 A | donors A:ASP9:OD1;A:SER17:O;A:CYS6:O;A:SER8:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1ATX_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.421 A) ----
select (resno=6 or resno=8 or resno=9 or resno=17) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=8 or resno=9 or resno=17) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {15.300 3.196 -6.890} color red
draw site1_b1 width 0.06 line {15.300 3.196 -6.890} (chain='A' and resno=9 and atomname='OD1') color red
draw site1_b2 width 0.06 line {15.300 3.196 -6.890} (chain='A' and resno=17 and atomname='O') color red
draw site1_b3 width 0.06 line {15.300 3.196 -6.890} (chain='A' and resno=6 and atomname='O') color red
draw site1_b4 width 0.06 line {15.300 3.196 -6.890} (chain='A' and resno=8 and atomname='O') color red
set echo site1_label {15.300 3.196 -6.890}
echo bva 0.421
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
