load "2KCR_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.238 A) ----
select (resno=49 or resno=51 or resno=52) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=49 or resno=51 or resno=52) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {5.154 11.249 3.049} color red
draw site1_b1 width 0.06 line {5.154 11.249 3.049} (chain='A' and resno=51 and atomname='OE1') color red
draw site1_b2 width 0.06 line {5.154 11.249 3.049} (chain='A' and resno=49 and atomname='OG1') color red
draw site1_b3 width 0.06 line {5.154 11.249 3.049} (chain='A' and resno=52 and atomname='OD1') color red
draw site1_b4 width 0.06 line {5.154 11.249 3.049} (chain='A' and resno=51 and atomname='O') color red
set echo site1_label {5.154 11.249 3.049}
echo pyv 0.238
color echo black
font echo 18

