# 2M4Z_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.213 A | donors A:ASN10:O;A:SER12:O;A:PRO11:O;A:ASN13:O | metals: cobalt,copper,europium,manganese,nickel

load "2M4Z_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.213 A) ----
select (resno=10 or resno=11 or resno=12 or resno=13) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=10 or resno=11 or resno=12 or resno=13) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-7.511 -3.128 1.178} color red
draw site1_b1 width 0.06 line {-7.511 -3.128 1.178} (chain='A' and resno=10 and atomname='O') color red
draw site1_b2 width 0.06 line {-7.511 -3.128 1.178} (chain='A' and resno=12 and atomname='O') color red
draw site1_b3 width 0.06 line {-7.511 -3.128 1.178} (chain='A' and resno=11 and atomname='O') color red
draw site1_b4 width 0.06 line {-7.511 -3.128 1.178} (chain='A' and resno=13 and atomname='O') color red
set echo site1_label {-7.511 -3.128 1.178}
echo spl 0.213
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
