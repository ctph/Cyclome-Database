load "1MYN_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tpv (RMSD 0.481 A) ----
select (resno=1 or resno=30 or resno=40 or resno=41 or resno=42) and chain='A'
