draw site3_center sphere diameter 1.4 {-4.094 8.928 5.557} color green
draw site3_b1 width 0.06 line {-4.094 8.928 5.557} (chain='I' and resno=513 and atomname='O') color green
draw site3_b2 width 0.06 line {-4.094 8.928 5.557} (chain='I' and resno=516 and atomname='O') color green
draw site3_b3 width 0.06 line {-4.094 8.928 5.557} (chain='I' and resno=518 and atomname='O') color green
draw site3_b4 width 0.06 line {-4.094 8.928 5.557} (chain='I' and resno=520 and atomname='O') color green
set echo site3_label {-4.094 8.928 5.557}
