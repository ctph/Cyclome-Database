color wireframe blue
draw site2_center sphere diameter 1.4 {-2.734 8.880 6.615} color blue
draw site2_b1 width 0.06 line {-2.734 8.880 6.615} (chain='I' and resno=516 and atomname='O') color blue
draw site2_b2 width 0.06 line {-2.734 8.880 6.615} (chain='I' and resno=518 and atomname='O') color blue
draw site2_b3 width 0.06 line {-2.734 8.880 6.615} (chain='I' and resno=520 and atomname='O') color blue
draw site2_b4 width 0.06 line {-2.734 8.880 6.615} (chain='I' and resno=517 and atomname='O') color blue
set echo site2_label {-2.734 8.880 6.615}
echo bva 0.274
color echo black
font echo 18

# ---- Site 3: pyv (RMSD 0.400 A) ----
select (resno=513 or resno=516 or resno=518 or resno=520) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=513 or resno=516 or resno=518 or resno=520) and chain='I' and carbon
