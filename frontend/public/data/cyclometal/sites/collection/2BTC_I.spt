# 2BTC_I: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.234 A | donors I:ALA518:O;I:CYS520:O;I:ASP513:O;I:CYS516:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bva RMSD 0.274 A | donors I:CYS516:O;I:ALA518:O;I:CYS520:O;I:LEU517:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 3 (green): pyv RMSD 0.400 A | donors I:ASP513:O;I:CYS516:O;I:ALA518:O;I:CYS520:O | metals: cobalt,copper,manganese,nickel

load "2BTC_I.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.234 A) ----
select (resno=513 or resno=516 or resno=518 or resno=520) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=513 or resno=516 or resno=518 or resno=520) and chain='I' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-3.750 8.849 5.549} color red
draw site1_b1 width 0.06 line {-3.750 8.849 5.549} (chain='I' and resno=518 and atomname='O') color red
draw site1_b2 width 0.06 line {-3.750 8.849 5.549} (chain='I' and resno=520 and atomname='O') color red
draw site1_b3 width 0.06 line {-3.750 8.849 5.549} (chain='I' and resno=513 and atomname='O') color red
draw site1_b4 width 0.06 line {-3.750 8.849 5.549} (chain='I' and resno=516 and atomname='O') color red
set echo site1_label {-3.750 8.849 5.549}
echo bvp 0.234
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.274 A) ----
