# 4ZMA_T: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.195 A | donors T:SER188:OG;T:SER205:O;T:PRO206:O;T:SER205:OG | metals: cobalt,copper,manganese,nickel

load "4ZMA_T.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.195 A) ----
select (resno=188 or resno=205 or resno=206) and chain='T'
wireframe 0.18
color wireframe cpk
select (resno=188 or resno=205 or resno=206) and chain='T' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.469 -14.156 -14.005} color red
draw site1_b1 width 0.06 line {-0.469 -14.156 -14.005} (chain='T' and resno=188 and atomname='OG') color red
draw site1_b2 width 0.06 line {-0.469 -14.156 -14.005} (chain='T' and resno=205 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.469 -14.156 -14.005} (chain='T' and resno=206 and atomname='O') color red
draw site1_b4 width 0.06 line {-0.469 -14.156 -14.005} (chain='T' and resno=205 and atomname='OG') color red
set echo site1_label {-0.469 -14.156 -14.005}
echo pyv 0.195
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
