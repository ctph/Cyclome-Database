# 5VYP_H: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.292 A | donors H:ASP31:OD2;H:THR44:OG1;H:HIS33:ND1;H:GLY32:O | metals: cobalt,copper,manganese,nickel

load "5VYP_H.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.292 A) ----
select (resno=31 or resno=32 or resno=33 or resno=44) and chain='H'
wireframe 0.18
color wireframe cpk
select (resno=31 or resno=32 or resno=33 or resno=44) and chain='H' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-11.778 5.576 -46.419} color red
draw site1_b1 width 0.06 line {-11.778 5.576 -46.419} (chain='H' and resno=31 and atomname='OD2') color red
draw site1_b2 width 0.06 line {-11.778 5.576 -46.419} (chain='H' and resno=44 and atomname='OG1') color red
draw site1_b3 width 0.06 line {-11.778 5.576 -46.419} (chain='H' and resno=33 and atomname='ND1') color red
draw site1_b4 width 0.06 line {-11.778 5.576 -46.419} (chain='H' and resno=32 and atomname='O') color red
set echo site1_label {-11.778 5.576 -46.419}
echo bvp 0.292
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
