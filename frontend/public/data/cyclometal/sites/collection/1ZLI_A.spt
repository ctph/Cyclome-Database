# 1ZLI_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.202 A | donors A:ASP104:OD1;A:VAL52:O;A:LYS51:O;A:GLY53:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.217 A | donors A:GLU72:O;A:SER197:OG;A:HIS196:O;A:GLU72:OE1 | metals: cobalt,copper,manganese,nickel

load "1ZLI_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.202 A) ----
select (resno=51 or resno=52 or resno=53 or resno=104) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=51 or resno=52 or resno=53 or resno=104) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.759 9.750 77.754} color red
draw site1_b1 width 0.06 line {0.759 9.750 77.754} (chain='A' and resno=104 and atomname='OD1') color red
draw site1_b2 width 0.06 line {0.759 9.750 77.754} (chain='A' and resno=52 and atomname='O') color red
draw site1_b3 width 0.06 line {0.759 9.750 77.754} (chain='A' and resno=51 and atomname='O') color red
draw site1_b4 width 0.06 line {0.759 9.750 77.754} (chain='A' and resno=53 and atomname='O') color red
set echo site1_label {0.759 9.750 77.754}
echo pyv 0.202
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.217 A) ----
select (resno=72 or resno=196 or resno=197) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=72 or resno=196 or resno=197) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-0.191 29.947 66.153} color blue
draw site2_b1 width 0.06 line {-0.191 29.947 66.153} (chain='A' and resno=72 and atomname='O') color blue
draw site2_b2 width 0.06 line {-0.191 29.947 66.153} (chain='A' and resno=197 and atomname='OG') color blue
draw site2_b3 width 0.06 line {-0.191 29.947 66.153} (chain='A' and resno=196 and atomname='O') color blue
draw site2_b4 width 0.06 line {-0.191 29.947 66.153} (chain='A' and resno=72 and atomname='OE1') color blue
set echo site2_label {-0.191 29.947 66.153}
echo pyv 0.217
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
