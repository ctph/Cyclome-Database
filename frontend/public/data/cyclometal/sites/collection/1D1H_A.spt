# 1D1H_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.179 A | donors A:ASP14:OD2;A:GLY8:O;A:GLU1:OE1;A:ASP14:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1D1H_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.179 A) ----
select (resno=1 or resno=8 or resno=14) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=1 or resno=8 or resno=14) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-6.917 -3.365 -5.112} color red
draw site1_b1 width 0.06 line {-6.917 -3.365 -5.112} (chain='A' and resno=14 and atomname='OD2') color red
draw site1_b2 width 0.06 line {-6.917 -3.365 -5.112} (chain='A' and resno=8 and atomname='O') color red
draw site1_b3 width 0.06 line {-6.917 -3.365 -5.112} (chain='A' and resno=1 and atomname='OE1') color red
draw site1_b4 width 0.06 line {-6.917 -3.365 -5.112} (chain='A' and resno=14 and atomname='O') color red
set echo site1_label {-6.917 -3.365 -5.112}
echo bva 0.179
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
