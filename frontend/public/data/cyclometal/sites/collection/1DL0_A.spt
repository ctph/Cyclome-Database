load "1DL0_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.395 A) ----
select (resno=25 or resno=28 or resno=29 or resno=30) and chain='A'
