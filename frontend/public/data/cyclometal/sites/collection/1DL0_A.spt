draw site1_center sphere diameter 1.4 {22.902 -3.766 8.505} color red
draw site1_b1 width 0.06 line {22.902 -3.766 8.505} (chain='A' and resno=30 and atomname='OG') color red
draw site1_b2 width 0.06 line {22.902 -3.766 8.505} (chain='A' and resno=29 and atomname='O') color red
