# 2M75_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.310 A | donors A:CYS6:O;A:PRO9:O;A:ALA16:O;A:CYS14:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): pyv RMSD 0.339 A | donors A:GLU34:O;A:GLU34:OE2;A:SER39:O;A:CYS32:O | metals: cobalt,copper,manganese,nickel

load "2M75_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.310 A) ----
select (resno=6 or resno=9 or resno=14 or resno=16) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=9 or resno=14 or resno=16) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-11.381 9.634 3.892} color red
draw site1_b1 width 0.06 line {-11.381 9.634 3.892} (chain='A' and resno=6 and atomname='O') color red
draw site1_b2 width 0.06 line {-11.381 9.634 3.892} (chain='A' and resno=9 and atomname='O') color red
draw site1_b3 width 0.06 line {-11.381 9.634 3.892} (chain='A' and resno=16 and atomname='O') color red
draw site1_b4 width 0.06 line {-11.381 9.634 3.892} (chain='A' and resno=14 and atomname='O') color red
set echo site1_label {-11.381 9.634 3.892}
echo bva 0.310
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.339 A) ----
select (resno=32 or resno=34 or resno=39) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=32 or resno=34 or resno=39) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-0.744 -7.430 5.342} color blue
draw site2_b1 width 0.06 line {-0.744 -7.430 5.342} (chain='A' and resno=34 and atomname='O') color blue
draw site2_b2 width 0.06 line {-0.744 -7.430 5.342} (chain='A' and resno=34 and atomname='OE2') color blue
draw site2_b3 width 0.06 line {-0.744 -7.430 5.342} (chain='A' and resno=39 and atomname='O') color blue
draw site2_b4 width 0.06 line {-0.744 -7.430 5.342} (chain='A' and resno=32 and atomname='O') color blue
set echo site2_label {-0.744 -7.430 5.342}
echo pyv 0.339
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
