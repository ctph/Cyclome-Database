# 1TOC_T: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.384 A | donors T:GLU106:O;T:GLU118:OE2;T:CYS89:O;T:PRO116:O | metals: cobalt,copper,manganese,nickel,samarium

load "1TOC_T.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.384 A) ----
select (resno=89 or resno=106 or resno=116 or resno=118) and chain='T'
wireframe 0.18
color wireframe cpk
select (resno=89 or resno=106 or resno=116 or resno=118) and chain='T' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {96.033 -7.457 17.234} color red
draw site1_b1 width 0.06 line {96.033 -7.457 17.234} (chain='T' and resno=106 and atomname='O') color red
draw site1_b2 width 0.06 line {96.033 -7.457 17.234} (chain='T' and resno=118 and atomname='OE2') color red
draw site1_b3 width 0.06 line {96.033 -7.457 17.234} (chain='T' and resno=89 and atomname='O') color red
draw site1_b4 width 0.06 line {96.033 -7.457 17.234} (chain='T' and resno=116 and atomname='O') color red
set echo site1_label {96.033 -7.457 17.234}
echo tet 0.384
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
