# 2LEW_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.500 A | donors A:ARG13:O;A:PRO30:O;A:ARG16:O;A:TYR5:OH | metals: cobalt,copper,manganese,nickel,samarium

load "2LEW_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.500 A) ----
select (resno=5 or resno=13 or resno=16 or resno=30) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=13 or resno=16 or resno=30) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-3.604 4.606 -1.551} color red
draw site1_b1 width 0.06 line {-3.604 4.606 -1.551} (chain='A' and resno=13 and atomname='O') color red
draw site1_b2 width 0.06 line {-3.604 4.606 -1.551} (chain='A' and resno=30 and atomname='O') color red
draw site1_b3 width 0.06 line {-3.604 4.606 -1.551} (chain='A' and resno=16 and atomname='O') color red
draw site1_b4 width 0.06 line {-3.604 4.606 -1.551} (chain='A' and resno=5 and atomname='OH') color red
set echo site1_label {-3.604 4.606 -1.551}
echo tet 0.500
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
