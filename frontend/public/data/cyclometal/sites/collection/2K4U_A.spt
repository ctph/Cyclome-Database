draw site1_center sphere diameter 1.4 {-3.892 1.430 -3.300} color red
draw site1_b1 width 0.06 line {-3.892 1.430 -3.300} (chain='A' and resno=35 and atomname='OG1') color red
draw site1_b2 width 0.06 line {-3.892 1.430 -3.300} (chain='A' and resno=33 and atomname='O') color red
