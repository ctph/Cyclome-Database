load "2K4U_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.416 A) ----
select (resno=24 or resno=33 or resno=35) and chain='A'
