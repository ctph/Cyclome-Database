load "1MCV_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.076 A) ----
select (resno=72 or resno=75 or resno=77 or resno=80) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=72 or resno=75 or resno=77 or resno=80) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.146 6.970 24.793} color red
draw site1_b1 width 0.06 line {4.146 6.970 24.793} (chain='A' and resno=72 and atomname='O') color red
draw site1_b2 width 0.06 line {4.146 6.970 24.793} (chain='A' and resno=75 and atomname='O') color red
draw site1_b3 width 0.06 line {4.146 6.970 24.793} (chain='A' and resno=80 and atomname='OE2') color red
draw site1_b4 width 0.06 line {4.146 6.970 24.793} (chain='A' and resno=77 and atomname='OD1') color red
set echo site1_label {4.146 6.970 24.793}
echo pyv 0.076
color echo black
font echo 18

