# 1ETL_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.361 A | donors A:ASN11:O;A:CYS17:OXT;A:CYS14:O;A:PRO12:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1ETL_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.361 A) ----
select (resno=11 or resno=12 or resno=14 or resno=17) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=12 or resno=14 or resno=17) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {17.252 6.059 -3.441} color red
draw site1_b1 width 0.06 line {17.252 6.059 -3.441} (chain='A' and resno=11 and atomname='O') color red
draw site1_b2 width 0.06 line {17.252 6.059 -3.441} (chain='A' and resno=17 and atomname='OXT') color red
draw site1_b3 width 0.06 line {17.252 6.059 -3.441} (chain='A' and resno=14 and atomname='O') color red
draw site1_b4 width 0.06 line {17.252 6.059 -3.441} (chain='A' and resno=12 and atomname='O') color red
set echo site1_label {17.252 6.059 -3.441}
echo bva 0.361
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
