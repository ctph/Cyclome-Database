# 1H9I_E: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.163 A | donors E:THR229:OG1;E:LEU99:O;E:MET180:SD;E:ASN179:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): spl RMSD 0.182 A | donors E:GLY140:O;E:PRO152:O;E:LEU154:O;E:TRP141:O | metals: cobalt,copper,europium,manganese,nickel

load "1H9I_E.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.163 A) ----
select (resno=99 or resno=179 or resno=180 or resno=229) and chain='E'
wireframe 0.18
color wireframe cpk
select (resno=99 or resno=179 or resno=180 or resno=229) and chain='E' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {41.959 93.097 -1.456} color red
draw site1_b1 width 0.06 line {41.959 93.097 -1.456} (chain='E' and resno=229 and atomname='OG1') color red
draw site1_b2 width 0.06 line {41.959 93.097 -1.456} (chain='E' and resno=99 and atomname='O') color red
draw site1_b3 width 0.06 line {41.959 93.097 -1.456} (chain='E' and resno=180 and atomname='SD') color red
draw site1_b4 width 0.06 line {41.959 93.097 -1.456} (chain='E' and resno=179 and atomname='O') color red
set echo site1_label {41.959 93.097 -1.456}
echo bvp 0.163
color echo black
font echo 18

# ---- Site 2: spl (RMSD 0.182 A) ----
select (resno=140 or resno=141 or resno=152 or resno=154) and chain='E'
wireframe 0.18
color wireframe cpk
select (resno=140 or resno=141 or resno=152 or resno=154) and chain='E' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {61.744 98.658 6.337} color blue
draw site2_b1 width 0.06 line {61.744 98.658 6.337} (chain='E' and resno=140 and atomname='O') color blue
draw site2_b2 width 0.06 line {61.744 98.658 6.337} (chain='E' and resno=152 and atomname='O') color blue
draw site2_b3 width 0.06 line {61.744 98.658 6.337} (chain='E' and resno=154 and atomname='O') color blue
draw site2_b4 width 0.06 line {61.744 98.658 6.337} (chain='E' and resno=141 and atomname='O') color blue
set echo site2_label {61.744 98.658 6.337}
echo spl 0.182
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
