# 7N25_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.406 A | donors A:MET10:SD;A:ARG7:O;A:ASN11:OD1;A:MET10:O | metals: cobalt,copper,manganese,nickel

load "7N25_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.406 A) ----
select (resno=7 or resno=10 or resno=11) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=7 or resno=10 or resno=11) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {2.605 -7.819 -4.318} color red
draw site1_b1 width 0.06 line {2.605 -7.819 -4.318} (chain='A' and resno=10 and atomname='SD') color red
draw site1_b2 width 0.06 line {2.605 -7.819 -4.318} (chain='A' and resno=7 and atomname='O') color red
draw site1_b3 width 0.06 line {2.605 -7.819 -4.318} (chain='A' and resno=11 and atomname='OD1') color red
draw site1_b4 width 0.06 line {2.605 -7.819 -4.318} (chain='A' and resno=10 and atomname='O') color red
set echo site1_label {2.605 -7.819 -4.318}
echo pyv 0.406
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
