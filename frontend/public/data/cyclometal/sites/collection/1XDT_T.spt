draw site1_center sphere diameter 1.4 {26.689 26.517 56.846} color red
draw site1_b1 width 0.06 line {26.689 26.517 56.846} (chain='T' and resno=369 and atomname='O') color red
draw site1_b2 width 0.06 line {26.689 26.517 56.846} (chain='T' and resno=372 and atomname='O') color red
