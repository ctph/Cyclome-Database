load "1XDT_T.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.154 A) ----
select (resno=202 or resno=369 or resno=372) and chain='T'
