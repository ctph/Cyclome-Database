# 4V1D_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.243 A | donors A:GLN3:OE1;A:LEU4:O;A:TRP107:O;A:VAL2:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): spl RMSD 0.479 A | donors A:GLN3:OE1;A:THR23:O;A:LEU4:O;A:SER25:OG | metals: cobalt,copper,europium,manganese,nickel

load "4V1D_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.243 A) ----
select (resno=2 or resno=3 or resno=4 or resno=107) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=3 or resno=4 or resno=107) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {72.294 45.925 133.107} color red
draw site1_b1 width 0.06 line {72.294 45.925 133.107} (chain='A' and resno=3 and atomname='OE1') color red
draw site1_b2 width 0.06 line {72.294 45.925 133.107} (chain='A' and resno=4 and atomname='O') color red
draw site1_b3 width 0.06 line {72.294 45.925 133.107} (chain='A' and resno=107 and atomname='O') color red
draw site1_b4 width 0.06 line {72.294 45.925 133.107} (chain='A' and resno=2 and atomname='O') color red
set echo site1_label {72.294 45.925 133.107}
echo bvp 0.243
color echo black
font echo 18

# ---- Site 2: spl (RMSD 0.479 A) ----
select (resno=3 or resno=4 or resno=23 or resno=25) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=4 or resno=23 or resno=25) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {68.758 44.095 134.839} color blue
draw site2_b1 width 0.06 line {68.758 44.095 134.839} (chain='A' and resno=3 and atomname='OE1') color blue
draw site2_b2 width 0.06 line {68.758 44.095 134.839} (chain='A' and resno=23 and atomname='O') color blue
draw site2_b3 width 0.06 line {68.758 44.095 134.839} (chain='A' and resno=4 and atomname='O') color blue
draw site2_b4 width 0.06 line {68.758 44.095 134.839} (chain='A' and resno=25 and atomname='OG') color blue
set echo site2_label {68.758 44.095 134.839}
echo spl 0.479
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
