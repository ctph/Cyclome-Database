# 6ATL_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.192 A | donors C:SER0:OG;C:ASP34:OD1;C:ASP34:O;C:CYS35:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bva RMSD 0.337 A | donors C:THR29:O;C:ASP34:OD2;C:CYS33:O;C:LYS27:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 3 (green): bvp RMSD 0.379 A | donors C:SER0:OG;C:ASP34:OD1;C:ASP34:O;C:CYS35:O | metals: cobalt,copper,manganese,nickel

load "6ATL_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.192 A) ----
select (resno=0 or resno=34 or resno=35) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=0 or resno=34 or resno=35) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {15.955 24.663 14.235} color red
draw site1_b1 width 0.06 line {15.955 24.663 14.235} (chain='C' and resno=0 and atomname='OG') color red
draw site1_b2 width 0.06 line {15.955 24.663 14.235} (chain='C' and resno=34 and atomname='OD1') color red
draw site1_b3 width 0.06 line {15.955 24.663 14.235} (chain='C' and resno=34 and atomname='O') color red
draw site1_b4 width 0.06 line {15.955 24.663 14.235} (chain='C' and resno=35 and atomname='O') color red
set echo site1_label {15.955 24.663 14.235}
echo pyv 0.192
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.337 A) ----
select (resno=27 or resno=29 or resno=33 or resno=34) and chain='C'
wireframe 0.18
color wireframe cpk
