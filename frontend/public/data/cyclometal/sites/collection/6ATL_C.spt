color wireframe blue
draw site2_center sphere diameter 1.4 {14.304 22.910 19.641} color blue
draw site2_b1 width 0.06 line {14.304 22.910 19.641} (chain='C' and resno=29 and atomname='O') color blue
draw site2_b2 width 0.06 line {14.304 22.910 19.641} (chain='C' and resno=34 and atomname='OD2') color blue
draw site2_b3 width 0.06 line {14.304 22.910 19.641} (chain='C' and resno=33 and atomname='O') color blue
draw site2_b4 width 0.06 line {14.304 22.910 19.641} (chain='C' and resno=27 and atomname='O') color blue
set echo site2_label {14.304 22.910 19.641}
echo bva 0.337
color echo black
font echo 18

# ---- Site 3: bvp (RMSD 0.379 A) ----
select (resno=0 or resno=34 or resno=35) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=0 or resno=34 or resno=35) and chain='C' and carbon
