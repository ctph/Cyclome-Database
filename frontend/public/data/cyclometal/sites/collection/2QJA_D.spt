# 2QJA_D: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.497 A | donors D:ILE99:O;D:ARG88:O;D:ASP89:OD2;D:GLN86:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2QJA_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.497 A) ----
select (resno=86 or resno=88 or resno=89 or resno=99) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=86 or resno=88 or resno=89 or resno=99) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {42.657 0.568 19.490} color red
draw site1_b1 width 0.06 line {42.657 0.568 19.490} (chain='D' and resno=99 and atomname='O') color red
draw site1_b2 width 0.06 line {42.657 0.568 19.490} (chain='D' and resno=88 and atomname='O') color red
draw site1_b3 width 0.06 line {42.657 0.568 19.490} (chain='D' and resno=89 and atomname='OD2') color red
draw site1_b4 width 0.06 line {42.657 0.568 19.490} (chain='D' and resno=86 and atomname='O') color red
set echo site1_label {42.657 0.568 19.490}
echo bva 0.497
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
