# 1SH1_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.284 A | donors A:GLU8:OE2;A:ALA15:O;A:PRO16:O;A:THR18:OG1 | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): tbp RMSD 0.423 A | donors A:LEU23:O;A:SER25:O;A:ASP22:O;A:GLY24:O;A:ASP42:OD1 | metals: cobalt,copper,manganese,nickel

load "1SH1_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.284 A) ----
select (resno=8 or resno=15 or resno=16 or resno=18) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=8 or resno=15 or resno=16 or resno=18) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {9.230 1.575 -9.957} color red
draw site1_b1 width 0.06 line {9.230 1.575 -9.957} (chain='A' and resno=8 and atomname='OE2') color red
draw site1_b2 width 0.06 line {9.230 1.575 -9.957} (chain='A' and resno=15 and atomname='O') color red
draw site1_b3 width 0.06 line {9.230 1.575 -9.957} (chain='A' and resno=16 and atomname='O') color red
draw site1_b4 width 0.06 line {9.230 1.575 -9.957} (chain='A' and resno=18 and atomname='OG1') color red
set echo site1_label {9.230 1.575 -9.957}
echo tet 0.284
color echo black
font echo 18

# ---- Site 2: tbp (RMSD 0.423 A) ----
select (resno=22 or resno=23 or resno=24 or resno=25 or resno=42) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=22 or resno=23 or resno=24 or resno=25 or resno=42) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {10.091 4.692 6.967} color blue
draw site2_b1 width 0.06 line {10.091 4.692 6.967} (chain='A' and resno=23 and atomname='O') color blue
draw site2_b2 width 0.06 line {10.091 4.692 6.967} (chain='A' and resno=25 and atomname='O') color blue
draw site2_b3 width 0.06 line {10.091 4.692 6.967} (chain='A' and resno=22 and atomname='O') color blue
draw site2_b4 width 0.06 line {10.091 4.692 6.967} (chain='A' and resno=24 and atomname='O') color blue
draw site2_b5 width 0.06 line {10.091 4.692 6.967} (chain='A' and resno=42 and atomname='OD1') color blue
set echo site2_label {10.091 4.692 6.967}
echo tbp 0.423
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
