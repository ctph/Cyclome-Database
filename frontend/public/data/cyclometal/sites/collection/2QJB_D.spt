# Site 2 (blue): spl RMSD 0.326 A | donors D:THR72:O;D:MET62:SD;D:THR74:OG1;D:ILE63:O | metals: cobalt,copper,europium,manganese,nickel
# Site 3 (green): spy RMSD 0.485 A | donors D:ILE63:O;D:GLU64:OE2;D:MET62:SD;D:THR72:O;D:THR74:OG1 | metals: cobalt,copper,europium,gadolinium,holmium,manganese,nickel,praseodymium,samarium,terbium,ytterbium

load "2QJB_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.186 A) ----
select (resno=62 or resno=63 or resno=64 or resno=72) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=62 or resno=63 or resno=64 or resno=72) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {23.134 -50.647 -12.744} color red
draw site1_b1 width 0.06 line {23.134 -50.647 -12.744} (chain='D' and resno=72 and atomname='O') color red
draw site1_b2 width 0.06 line {23.134 -50.647 -12.744} (chain='D' and resno=64 and atomname='OE2') color red
draw site1_b3 width 0.06 line {23.134 -50.647 -12.744} (chain='D' and resno=62 and atomname='SD') color red
draw site1_b4 width 0.06 line {23.134 -50.647 -12.744} (chain='D' and resno=63 and atomname='O') color red
set echo site1_label {23.134 -50.647 -12.744}
echo bvp 0.186
color echo black
font echo 18

