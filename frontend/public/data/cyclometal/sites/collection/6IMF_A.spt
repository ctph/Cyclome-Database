# 6IMF_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.346 A | donors A:ASN35:O;A:ILE220:O;A:LYS123:O;A:TYR122:OH | metals: cobalt,copper,manganese,nickel,samarium

load "6IMF_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.346 A) ----
select (resno=35 or resno=122 or resno=123 or resno=220) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=35 or resno=122 or resno=123 or resno=220) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {33.438 49.126 10.391} color red
draw site1_b1 width 0.06 line {33.438 49.126 10.391} (chain='A' and resno=35 and atomname='O') color red
draw site1_b2 width 0.06 line {33.438 49.126 10.391} (chain='A' and resno=220 and atomname='O') color red
draw site1_b3 width 0.06 line {33.438 49.126 10.391} (chain='A' and resno=123 and atomname='O') color red
draw site1_b4 width 0.06 line {33.438 49.126 10.391} (chain='A' and resno=122 and atomname='OH') color red
set echo site1_label {33.438 49.126 10.391}
echo tet 0.346
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
