# 2LJS_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.365 A | donors A:GLY19:O;A:CYS21:O;A:ASP14:O;A:CYS17:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bva RMSD 0.368 A | donors A:CYS21:O;A:CYS17:O;A:GLY19:O;A:PRO18:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 3 (green): tet RMSD 0.391 A | donors A:CYS17:O;A:PRO18:O;A:GLY19:O;A:CYS21:O | metals: cobalt,copper,manganese,nickel,samarium

load "2LJS_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.365 A) ----
select (resno=14 or resno=17 or resno=19 or resno=21) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=14 or resno=17 or resno=19 or resno=21) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.151 -3.524 4.533} color red
draw site1_b1 width 0.06 line {3.151 -3.524 4.533} (chain='A' and resno=19 and atomname='O') color red
draw site1_b2 width 0.06 line {3.151 -3.524 4.533} (chain='A' and resno=21 and atomname='O') color red
draw site1_b3 width 0.06 line {3.151 -3.524 4.533} (chain='A' and resno=14 and atomname='O') color red
draw site1_b4 width 0.06 line {3.151 -3.524 4.533} (chain='A' and resno=17 and atomname='O') color red
set echo site1_label {3.151 -3.524 4.533}
echo pyv 0.365
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.368 A) ----
select (resno=17 or resno=18 or resno=19 or resno=21) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=17 or resno=18 or resno=19 or resno=21) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {4.078 -2.798 3.406} color blue
draw site2_b1 width 0.06 line {4.078 -2.798 3.406} (chain='A' and resno=21 and atomname='O') color blue
draw site2_b2 width 0.06 line {4.078 -2.798 3.406} (chain='A' and resno=17 and atomname='O') color blue
draw site2_b3 width 0.06 line {4.078 -2.798 3.406} (chain='A' and resno=19 and atomname='O') color blue
draw site2_b4 width 0.06 line {4.078 -2.798 3.406} (chain='A' and resno=18 and atomname='O') color blue
set echo site2_label {4.078 -2.798 3.406}
echo bva 0.368
color echo black
font echo 18

# ---- Site 3: tet (RMSD 0.391 A) ----
select (resno=17 or resno=18 or resno=19 or resno=21) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=17 or resno=18 or resno=19 or resno=21) and chain='A' and carbon
color wireframe green
draw site3_center sphere diameter 1.4 {4.363 -2.551 2.892} color green
draw site3_b1 width 0.06 line {4.363 -2.551 2.892} (chain='A' and resno=17 and atomname='O') color green
draw site3_b2 width 0.06 line {4.363 -2.551 2.892} (chain='A' and resno=18 and atomname='O') color green
draw site3_b3 width 0.06 line {4.363 -2.551 2.892} (chain='A' and resno=19 and atomname='O') color green
draw site3_b4 width 0.06 line {4.363 -2.551 2.892} (chain='A' and resno=21 and atomname='O') color green
set echo site3_label {4.363 -2.551 2.892}
echo tet 0.391
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
