# 1P8B_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.385 A | donors A:PHE10:O;A:PRO9:O;A:GLU11:O;A:MET12:SD | metals: cobalt,copper,manganese,nickel,samarium

load "1P8B_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.385 A) ----
select (resno=9 or resno=10 or resno=11 or resno=12) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=9 or resno=10 or resno=11 or resno=12) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.236 8.487 -0.128} color red
draw site1_b1 width 0.06 line {0.236 8.487 -0.128} (chain='A' and resno=10 and atomname='O') color red
draw site1_b2 width 0.06 line {0.236 8.487 -0.128} (chain='A' and resno=9 and atomname='O') color red
draw site1_b3 width 0.06 line {0.236 8.487 -0.128} (chain='A' and resno=11 and atomname='O') color red
draw site1_b4 width 0.06 line {0.236 8.487 -0.128} (chain='A' and resno=12 and atomname='SD') color red
set echo site1_label {0.236 8.487 -0.128}
echo tet 0.385
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
