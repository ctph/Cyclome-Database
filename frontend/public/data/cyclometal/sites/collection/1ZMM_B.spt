# 1ZMM_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.373 A | donors B:GLU13:OE2;B:CYS29:O;B:SER3:O;B:SER3:OG | metals: cobalt,copper,manganese,nickel

load "1ZMM_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.373 A) ----
select (resno=3 or resno=13 or resno=29) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=13 or resno=29) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {11.012 -5.092 -0.280} color red
draw site1_b1 width 0.06 line {11.012 -5.092 -0.280} (chain='B' and resno=13 and atomname='OE2') color red
draw site1_b2 width 0.06 line {11.012 -5.092 -0.280} (chain='B' and resno=29 and atomname='O') color red
draw site1_b3 width 0.06 line {11.012 -5.092 -0.280} (chain='B' and resno=3 and atomname='O') color red
draw site1_b4 width 0.06 line {11.012 -5.092 -0.280} (chain='B' and resno=3 and atomname='OG') color red
set echo site1_label {11.012 -5.092 -0.280}
echo pyv 0.373
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
