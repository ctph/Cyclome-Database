# 2PJI_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.369 A | donors A:GLU34:OE2;A:LEU31:O;A:SER39:OG;A:CYS33:O | metals: cobalt,copper,manganese,nickel,samarium

load "2PJI_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.369 A) ----
select (resno=31 or resno=33 or resno=34 or resno=39) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=31 or resno=33 or resno=34 or resno=39) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.998 7.794 -3.184} color red
draw site1_b1 width 0.06 line {-0.998 7.794 -3.184} (chain='A' and resno=34 and atomname='OE2') color red
draw site1_b2 width 0.06 line {-0.998 7.794 -3.184} (chain='A' and resno=31 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.998 7.794 -3.184} (chain='A' and resno=39 and atomname='OG') color red
draw site1_b4 width 0.06 line {-0.998 7.794 -3.184} (chain='A' and resno=33 and atomname='O') color red
set echo site1_label {-0.998 7.794 -3.184}
echo tet 0.369
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
