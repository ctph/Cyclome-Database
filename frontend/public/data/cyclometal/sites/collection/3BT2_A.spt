# Site 1 (red): tet RMSD 0.275 A | donors A:LEU80:O;A:VAL79:O;A:GLN82:O;A:HIS85:ND1 | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): tet RMSD 0.315 A | donors A:PHE57:O;A:GLU43:O;A:ASP45:OD2;A:ASN15:OD1 | metals: cobalt,copper,manganese,nickel,samarium
# Site 3 (green): bva RMSD 0.407 A | donors A:ARG110:O;A:ARG108:O;A:ASN54:O;A:ARG109:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "3BT2_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.275 A) ----
select (resno=79 or resno=80 or resno=82 or resno=85) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=79 or resno=80 or resno=82 or resno=85) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {40.328 -46.200 82.205} color red
draw site1_b1 width 0.06 line {40.328 -46.200 82.205} (chain='A' and resno=80 and atomname='O') color red
draw site1_b2 width 0.06 line {40.328 -46.200 82.205} (chain='A' and resno=79 and atomname='O') color red
draw site1_b3 width 0.06 line {40.328 -46.200 82.205} (chain='A' and resno=82 and atomname='O') color red
draw site1_b4 width 0.06 line {40.328 -46.200 82.205} (chain='A' and resno=85 and atomname='ND1') color red
set echo site1_label {40.328 -46.200 82.205}
echo tet 0.275
color echo black
font echo 18

