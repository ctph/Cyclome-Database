# Site 1 (red): pyv RMSD 0.343 A | donors A:GLY41:O;A:TYR6:OH;A:PRO38:O;A:LEU40:O | metals: cobalt,copper,manganese,nickel

load "1OMY_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.343 A) ----
select (resno=6 or resno=38 or resno=40 or resno=41) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=38 or resno=40 or resno=41) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {24.307 11.907 -2.513} color red
draw site1_b1 width 0.06 line {24.307 11.907 -2.513} (chain='A' and resno=41 and atomname='O') color red
draw site1_b2 width 0.06 line {24.307 11.907 -2.513} (chain='A' and resno=6 and atomname='OH') color red
draw site1_b3 width 0.06 line {24.307 11.907 -2.513} (chain='A' and resno=38 and atomname='O') color red
draw site1_b4 width 0.06 line {24.307 11.907 -2.513} (chain='A' and resno=40 and atomname='O') color red
set echo site1_label {24.307 11.907 -2.513}
echo pyv 0.343
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
