# 1I6G_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.356 A | donors A:LYS12:O;A:SER14:OG;A:MET38:O;A:LEU13:O | metals: cobalt,copper,manganese,nickel

load "1I6G_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.356 A) ----
select (resno=12 or resno=13 or resno=14 or resno=38) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=12 or resno=13 or resno=14 or resno=38) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.030 -6.292 0.845} color red
draw site1_b1 width 0.06 line {4.030 -6.292 0.845} (chain='A' and resno=12 and atomname='O') color red
draw site1_b2 width 0.06 line {4.030 -6.292 0.845} (chain='A' and resno=14 and atomname='OG') color red
draw site1_b3 width 0.06 line {4.030 -6.292 0.845} (chain='A' and resno=38 and atomname='O') color red
draw site1_b4 width 0.06 line {4.030 -6.292 0.845} (chain='A' and resno=13 and atomname='O') color red
set echo site1_label {4.030 -6.292 0.845}
echo pyv 0.356
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
