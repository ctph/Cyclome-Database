# 2K3G_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.236 A | donors A:MET78:SD;A:GLN86:O;A:GLY82:O;A:HIS58:NE2 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.314 A | donors A:ASN56:OD1;A:THR32:OG1;A:GLU30:O;A:THR32:O | metals: cobalt,copper,manganese,nickel
# Site 3 (green): bva RMSD 0.317 A | donors A:ASP84:O;A:GLN86:O;A:HIS58:NE2;A:GLY82:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2K3G_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.236 A) ----
select (resno=58 or resno=78 or resno=82 or resno=86) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=58 or resno=78 or resno=82 or resno=86) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {84.346 8.133 6.093} color red
draw site1_b1 width 0.06 line {84.346 8.133 6.093} (chain='A' and resno=78 and atomname='SD') color red
draw site1_b2 width 0.06 line {84.346 8.133 6.093} (chain='A' and resno=86 and atomname='O') color red
draw site1_b3 width 0.06 line {84.346 8.133 6.093} (chain='A' and resno=82 and atomname='O') color red
draw site1_b4 width 0.06 line {84.346 8.133 6.093} (chain='A' and resno=58 and atomname='NE2') color red
set echo site1_label {84.346 8.133 6.093}
echo bvp 0.236
color echo black
font echo 18

