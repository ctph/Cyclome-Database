draw site2_b2 width 0.06 line {86.701 18.568 1.659} (chain='A' and resno=32 and atomname='OG1') color blue
draw site2_b3 width 0.06 line {86.701 18.568 1.659} (chain='A' and resno=30 and atomname='O') color blue
