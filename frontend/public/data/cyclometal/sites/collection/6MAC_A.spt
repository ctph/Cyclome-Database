# 6MAC_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.221 A | donors A:GLY68:O;A:GLN62:OE1;A:ASN65:O;A:ALA70:O | metals: cobalt,copper,europium,manganese,nickel
# Site 2 (blue): pyv RMSD 0.292 A | donors A:VAL61:O;A:GLN62:OE1;A:ALA70:O;A:PRO66:O | metals: cobalt,copper,manganese,nickel

load "6MAC_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.221 A) ----
select (resno=62 or resno=65 or resno=68 or resno=70) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=62 or resno=65 or resno=68 or resno=70) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {6.064 17.589 -2.387} color red
draw site1_b1 width 0.06 line {6.064 17.589 -2.387} (chain='A' and resno=68 and atomname='O') color red
draw site1_b2 width 0.06 line {6.064 17.589 -2.387} (chain='A' and resno=62 and atomname='OE1') color red
draw site1_b3 width 0.06 line {6.064 17.589 -2.387} (chain='A' and resno=65 and atomname='O') color red
draw site1_b4 width 0.06 line {6.064 17.589 -2.387} (chain='A' and resno=70 and atomname='O') color red
set echo site1_label {6.064 17.589 -2.387}
echo spl 0.221
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.292 A) ----
select (resno=61 or resno=62 or resno=66 or resno=70) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=61 or resno=62 or resno=66 or resno=70) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {7.899 18.147 -2.809} color blue
draw site2_b1 width 0.06 line {7.899 18.147 -2.809} (chain='A' and resno=61 and atomname='O') color blue
draw site2_b2 width 0.06 line {7.899 18.147 -2.809} (chain='A' and resno=62 and atomname='OE1') color blue
draw site2_b3 width 0.06 line {7.899 18.147 -2.809} (chain='A' and resno=70 and atomname='O') color blue
draw site2_b4 width 0.06 line {7.899 18.147 -2.809} (chain='A' and resno=66 and atomname='O') color blue
set echo site2_label {7.899 18.147 -2.809}
echo pyv 0.292
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
