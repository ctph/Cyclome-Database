# 1F3K_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.243 A | donors A:ASP5:OD2;A:GLN3:O;A:GLU6:OE2;A:ASP5:O | metals: cobalt,copper,manganese,nickel

load "1F3K_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.243 A) ----
select (resno=3 or resno=5 or resno=6) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=5 or resno=6) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-1.672 1.436 -9.311} color red
draw site1_b1 width 0.06 line {-1.672 1.436 -9.311} (chain='A' and resno=5 and atomname='OD2') color red
draw site1_b2 width 0.06 line {-1.672 1.436 -9.311} (chain='A' and resno=3 and atomname='O') color red
draw site1_b3 width 0.06 line {-1.672 1.436 -9.311} (chain='A' and resno=6 and atomname='OE2') color red
draw site1_b4 width 0.06 line {-1.672 1.436 -9.311} (chain='A' and resno=5 and atomname='O') color red
set echo site1_label {-1.672 1.436 -9.311}
echo pyv 0.243
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
