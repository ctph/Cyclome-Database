# 2F2I_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.341 A | donors A:LYS21:O;A:SER18:OG;A:THR23:OG1;A:THR16:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2F2I_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.341 A) ----
select (resno=16 or resno=18 or resno=21 or resno=23) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=16 or resno=18 or resno=21 or resno=23) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-1.852 3.363 1.807} color red
draw site1_b1 width 0.06 line {-1.852 3.363 1.807} (chain='A' and resno=21 and atomname='O') color red
draw site1_b2 width 0.06 line {-1.852 3.363 1.807} (chain='A' and resno=18 and atomname='OG') color red
draw site1_b3 width 0.06 line {-1.852 3.363 1.807} (chain='A' and resno=23 and atomname='OG1') color red
draw site1_b4 width 0.06 line {-1.852 3.363 1.807} (chain='A' and resno=16 and atomname='O') color red
set echo site1_label {-1.852 3.363 1.807}
echo bva 0.341
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
