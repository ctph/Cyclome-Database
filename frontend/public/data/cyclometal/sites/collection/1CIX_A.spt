# 1CIX_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.353 A | donors A:TYR38:OH;A:VAL12:O;A:GLN5:OE1;A:THR20:O | metals: cobalt,copper,manganese,nickel,samarium

load "1CIX_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.353 A) ----
select (resno=5 or resno=12 or resno=20 or resno=38) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=12 or resno=20 or resno=38) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.654 3.072 1.680} color red
draw site1_b1 width 0.06 line {3.654 3.072 1.680} (chain='A' and resno=38 and atomname='OH') color red
draw site1_b2 width 0.06 line {3.654 3.072 1.680} (chain='A' and resno=12 and atomname='O') color red
draw site1_b3 width 0.06 line {3.654 3.072 1.680} (chain='A' and resno=5 and atomname='OE1') color red
draw site1_b4 width 0.06 line {3.654 3.072 1.680} (chain='A' and resno=20 and atomname='O') color red
set echo site1_label {3.654 3.072 1.680}
echo tet 0.353
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
