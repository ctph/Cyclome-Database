# Site 1 (red): bva RMSD 0.471 A | donors A:GLY38:O;A:LEU25:O;A:CYS24:O;A:ASN26:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "6AVD_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.471 A) ----
select (resno=24 or resno=25 or resno=26 or resno=38) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=24 or resno=25 or resno=26 or resno=38) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {27.016 2.589 -0.266} color red
draw site1_b1 width 0.06 line {27.016 2.589 -0.266} (chain='A' and resno=38 and atomname='O') color red
draw site1_b2 width 0.06 line {27.016 2.589 -0.266} (chain='A' and resno=25 and atomname='O') color red
draw site1_b3 width 0.06 line {27.016 2.589 -0.266} (chain='A' and resno=24 and atomname='O') color red
draw site1_b4 width 0.06 line {27.016 2.589 -0.266} (chain='A' and resno=26 and atomname='O') color red
set echo site1_label {27.016 2.589 -0.266}
echo bva 0.471
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
