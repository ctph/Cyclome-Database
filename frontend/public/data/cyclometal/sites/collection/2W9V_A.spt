# 2W9V_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.228 A | donors A:VAL27:O;A:SER28:OG;A:PRO43:O;A:GLY44:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.309 A | donors A:VAL27:O;A:SER28:OG;A:PRO43:O;A:GLY44:OXT | metals: cobalt,copper,manganese,nickel

load "2W9V_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.228 A) ----
select (resno=27 or resno=28 or resno=43 or resno=44) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=27 or resno=28 or resno=43 or resno=44) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {11.528 -9.788 2.814} color red
draw site1_b1 width 0.06 line {11.528 -9.788 2.814} (chain='A' and resno=27 and atomname='O') color red
draw site1_b2 width 0.06 line {11.528 -9.788 2.814} (chain='A' and resno=28 and atomname='OG') color red
draw site1_b3 width 0.06 line {11.528 -9.788 2.814} (chain='A' and resno=43 and atomname='O') color red
draw site1_b4 width 0.06 line {11.528 -9.788 2.814} (chain='A' and resno=44 and atomname='O') color red
set echo site1_label {11.528 -9.788 2.814}
echo bvp 0.228
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.309 A) ----
select (resno=27 or resno=28 or resno=43 or resno=44) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=27 or resno=28 or resno=43 or resno=44) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {11.397 -9.766 2.778} color blue
draw site2_b1 width 0.06 line {11.397 -9.766 2.778} (chain='A' and resno=27 and atomname='O') color blue
draw site2_b2 width 0.06 line {11.397 -9.766 2.778} (chain='A' and resno=28 and atomname='OG') color blue
draw site2_b3 width 0.06 line {11.397 -9.766 2.778} (chain='A' and resno=43 and atomname='O') color blue
draw site2_b4 width 0.06 line {11.397 -9.766 2.778} (chain='A' and resno=44 and atomname='OXT') color blue
set echo site2_label {11.397 -9.766 2.778}
echo pyv 0.309
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
