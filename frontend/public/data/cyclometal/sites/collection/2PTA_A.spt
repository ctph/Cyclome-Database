# 2PTA_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.411 A | donors A:ASN25:OD1;A:PRO24:O;A:ALA26:O;A:TYR14:OH | metals: cobalt,copper,manganese,nickel

load "2PTA_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.411 A) ----
select (resno=14 or resno=24 or resno=25 or resno=26) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=14 or resno=24 or resno=25 or resno=26) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-3.161 1.190 6.809} color red
draw site1_b1 width 0.06 line {-3.161 1.190 6.809} (chain='A' and resno=25 and atomname='OD1') color red
draw site1_b2 width 0.06 line {-3.161 1.190 6.809} (chain='A' and resno=24 and atomname='O') color red
draw site1_b3 width 0.06 line {-3.161 1.190 6.809} (chain='A' and resno=26 and atomname='O') color red
draw site1_b4 width 0.06 line {-3.161 1.190 6.809} (chain='A' and resno=14 and atomname='OH') color red
set echo site1_label {-3.161 1.190 6.809}
echo pyv 0.411
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
