# Site 2 (blue): tet RMSD 0.416 A | donors A:ASN35:OD1;A:ARG5:O;A:CYS44:O;A:CYS34:O | metals: cobalt,copper,manganese,nickel,samarium
# Site 3 (green): tet RMSD 0.440 A | donors A:ALA41:O;A:SER26:OG;A:GLU43:O;A:VAL24:O | metals: cobalt,copper,manganese,nickel,samarium

load "2H9X_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.290 A) ----
select (resno=24 or resno=26 or resno=41 or resno=43) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=24 or resno=26 or resno=41 or resno=43) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {19.930 22.753 33.871} color red
draw site1_b1 width 0.06 line {19.930 22.753 33.871} (chain='A' and resno=41 and atomname='O') color red
draw site1_b2 width 0.06 line {19.930 22.753 33.871} (chain='A' and resno=26 and atomname='OG') color red
draw site1_b3 width 0.06 line {19.930 22.753 33.871} (chain='A' and resno=43 and atomname='O') color red
draw site1_b4 width 0.06 line {19.930 22.753 33.871} (chain='A' and resno=24 and atomname='O') color red
set echo site1_label {19.930 22.753 33.871}
echo bva 0.290
color echo black
font echo 18

