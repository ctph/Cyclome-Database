# 1JJZ_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.218 A | donors A:SER23:OG;A:CYS22:O;A:THR21:OG1;A:THR28:OG1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.435 A | donors A:SER23:OG;A:CYS22:O;A:THR21:OG1;A:THR28:OG1 | metals: cobalt,copper,manganese,nickel

load "1JJZ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.218 A) ----
select (resno=21 or resno=22 or resno=23 or resno=28) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=21 or resno=22 or resno=23 or resno=28) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.372 0.360 6.627} color red
draw site1_b1 width 0.06 line {-0.372 0.360 6.627} (chain='A' and resno=23 and atomname='OG') color red
draw site1_b2 width 0.06 line {-0.372 0.360 6.627} (chain='A' and resno=22 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.372 0.360 6.627} (chain='A' and resno=21 and atomname='OG1') color red
draw site1_b4 width 0.06 line {-0.372 0.360 6.627} (chain='A' and resno=28 and atomname='OG1') color red
set echo site1_label {-0.372 0.360 6.627}
echo bvp 0.218
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.435 A) ----
select (resno=21 or resno=22 or resno=23 or resno=28) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=21 or resno=22 or resno=23 or resno=28) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-0.474 0.360 6.983} color blue
draw site2_b1 width 0.06 line {-0.474 0.360 6.983} (chain='A' and resno=23 and atomname='OG') color blue
draw site2_b2 width 0.06 line {-0.474 0.360 6.983} (chain='A' and resno=22 and atomname='O') color blue
draw site2_b3 width 0.06 line {-0.474 0.360 6.983} (chain='A' and resno=21 and atomname='OG1') color blue
draw site2_b4 width 0.06 line {-0.474 0.360 6.983} (chain='A' and resno=28 and atomname='OG1') color blue
set echo site2_label {-0.474 0.360 6.983}
echo pyv 0.435
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
