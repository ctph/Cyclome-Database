load "2ODY_F.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.278 A) ----
select (resno=95 or resno=98 or resno=101 or resno=119) and chain='F'
wireframe 0.18
color wireframe cpk
select (resno=95 or resno=98 or resno=101 or resno=119) and chain='F' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {18.138 49.900 89.374} color red
draw site1_b1 width 0.06 line {18.138 49.900 89.374} (chain='F' and resno=95 and atomname='OG') color red
draw site1_b2 width 0.06 line {18.138 49.900 89.374} (chain='F' and resno=98 and atomname='O') color red
draw site1_b3 width 0.06 line {18.138 49.900 89.374} (chain='F' and resno=101 and atomname='OE1') color red
draw site1_b4 width 0.06 line {18.138 49.900 89.374} (chain='F' and resno=119 and atomname='O') color red
set echo site1_label {18.138 49.900 89.374}
echo bva 0.278
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
