# Site 1 (red): pyv RMSD 0.206 A | donors C:PRO117:O;C:LEU116:O;C:ALA92:O;C:THR93:O | metals: cobalt,copper,manganese,nickel

load "1NYU_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.206 A) ----
select (resno=92 or resno=93 or resno=116 or resno=117) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=92 or resno=93 or resno=116 or resno=117) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {54.642 75.210 -4.825} color red
draw site1_b1 width 0.06 line {54.642 75.210 -4.825} (chain='C' and resno=117 and atomname='O') color red
draw site1_b2 width 0.06 line {54.642 75.210 -4.825} (chain='C' and resno=116 and atomname='O') color red
draw site1_b3 width 0.06 line {54.642 75.210 -4.825} (chain='C' and resno=92 and atomname='O') color red
draw site1_b4 width 0.06 line {54.642 75.210 -4.825} (chain='C' and resno=93 and atomname='O') color red
set echo site1_label {54.642 75.210 -4.825}
echo pyv 0.206
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
