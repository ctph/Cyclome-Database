# 2GOO_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.229 A | donors B:HIS58:ND1;B:ASN56:O;B:TYR80:O;B:MET78:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2GOO_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.229 A) ----
select (resno=56 or resno=58 or resno=78 or resno=80) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=56 or resno=58 or resno=78 or resno=80) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-39.386 50.169 -12.332} color red
draw site1_b1 width 0.06 line {-39.386 50.169 -12.332} (chain='B' and resno=58 and atomname='ND1') color red
draw site1_b2 width 0.06 line {-39.386 50.169 -12.332} (chain='B' and resno=56 and atomname='O') color red
draw site1_b3 width 0.06 line {-39.386 50.169 -12.332} (chain='B' and resno=80 and atomname='O') color red
draw site1_b4 width 0.06 line {-39.386 50.169 -12.332} (chain='B' and resno=78 and atomname='O') color red
set echo site1_label {-39.386 50.169 -12.332}
echo bva 0.229
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
