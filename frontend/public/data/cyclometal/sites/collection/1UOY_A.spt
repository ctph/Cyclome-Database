load "1UOY_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.420 A) ----
select (resno=14 or resno=31 or resno=34 or resno=45) and chain='A'
