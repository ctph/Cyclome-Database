color wireframe red
draw site1_center sphere diameter 1.4 {9.782 18.567 1.755} color red
draw site1_b1 width 0.06 line {9.782 18.567 1.755} (chain='A' and resno=45 and atomname='OE2') color red
draw site1_b2 width 0.06 line {9.782 18.567 1.755} (chain='A' and resno=34 and atomname='O') color red
draw site1_b3 width 0.06 line {9.782 18.567 1.755} (chain='A' and resno=31 and atomname='OD1') color red
draw site1_b4 width 0.06 line {9.782 18.567 1.755} (chain='A' and resno=14 and atomname='OG1') color red
set echo site1_label {9.782 18.567 1.755}
echo tet 0.420
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
