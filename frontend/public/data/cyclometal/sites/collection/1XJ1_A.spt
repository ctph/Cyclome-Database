# 1XJ1_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.221 A | donors A:ASP42:OD2;A:VAL15:O;A:ASP40:O;A:GLY43:O | metals: cobalt,copper,manganese,nickel,samarium

load "1XJ1_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.221 A) ----
select (resno=15 or resno=40 or resno=42 or resno=43) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=15 or resno=40 or resno=42 or resno=43) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {2.056 -14.771 -1.873} color red
draw site1_b1 width 0.06 line {2.056 -14.771 -1.873} (chain='A' and resno=42 and atomname='OD2') color red
draw site1_b2 width 0.06 line {2.056 -14.771 -1.873} (chain='A' and resno=15 and atomname='O') color red
draw site1_b3 width 0.06 line {2.056 -14.771 -1.873} (chain='A' and resno=40 and atomname='O') color red
draw site1_b4 width 0.06 line {2.056 -14.771 -1.873} (chain='A' and resno=43 and atomname='O') color red
set echo site1_label {2.056 -14.771 -1.873}
echo tet 0.221
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
