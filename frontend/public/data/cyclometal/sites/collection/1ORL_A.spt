# 1ORL_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.468 A | donors A:CYS32:O;A:ILE34:O;A:GLU24:OE2;A:ARG23:O | metals: cobalt,copper,manganese,nickel,samarium

load "1ORL_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.468 A) ----
select (resno=23 or resno=24 or resno=32 or resno=34) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=23 or resno=24 or resno=32 or resno=34) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.218 0.094 0.078} color red
draw site1_b1 width 0.06 line {-5.218 0.094 0.078} (chain='A' and resno=32 and atomname='O') color red
draw site1_b2 width 0.06 line {-5.218 0.094 0.078} (chain='A' and resno=34 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.218 0.094 0.078} (chain='A' and resno=24 and atomname='OE2') color red
draw site1_b4 width 0.06 line {-5.218 0.094 0.078} (chain='A' and resno=23 and atomname='O') color red
set echo site1_label {-5.218 0.094 0.078}
echo tet 0.468
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
