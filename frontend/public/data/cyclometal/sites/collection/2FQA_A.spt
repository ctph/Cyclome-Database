# 2FQA_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.483 A | donors A:SER4:O;A:LYS13:O;A:CYS14:O;A:THR16:OG1 | metals: cobalt,copper,manganese,nickel

load "2FQA_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.483 A) ----
select (resno=4 or resno=13 or resno=14 or resno=16) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=13 or resno=14 or resno=16) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.128 3.744 -2.926} color red
draw site1_b1 width 0.06 line {1.128 3.744 -2.926} (chain='A' and resno=4 and atomname='O') color red
draw site1_b2 width 0.06 line {1.128 3.744 -2.926} (chain='A' and resno=13 and atomname='O') color red
draw site1_b3 width 0.06 line {1.128 3.744 -2.926} (chain='A' and resno=14 and atomname='O') color red
draw site1_b4 width 0.06 line {1.128 3.744 -2.926} (chain='A' and resno=16 and atomname='OG1') color red
set echo site1_label {1.128 3.744 -2.926}
echo pyv 0.483
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
