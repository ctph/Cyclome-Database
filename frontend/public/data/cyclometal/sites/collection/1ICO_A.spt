# 1ICO_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.435 A | donors A:THR11:O;A:TYR3:O;A:GLU4:OE2;A:TYR5:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1ICO_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.435 A) ----
select (resno=3 or resno=4 or resno=5 or resno=11) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=4 or resno=5 or resno=11) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {32.191 20.778 -19.828} color red
draw site1_b1 width 0.06 line {32.191 20.778 -19.828} (chain='A' and resno=11 and atomname='O') color red
draw site1_b2 width 0.06 line {32.191 20.778 -19.828} (chain='A' and resno=3 and atomname='O') color red
draw site1_b3 width 0.06 line {32.191 20.778 -19.828} (chain='A' and resno=4 and atomname='OE2') color red
draw site1_b4 width 0.06 line {32.191 20.778 -19.828} (chain='A' and resno=5 and atomname='O') color red
set echo site1_label {32.191 20.778 -19.828}
echo bva 0.435
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
