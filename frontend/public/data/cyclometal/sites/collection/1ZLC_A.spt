# 1ZLC_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.316 A | donors A:CYS4:O;A:THR11:OG1;A:ASN14:O;A:CYS10:O | metals: cobalt,copper,manganese,nickel

load "1ZLC_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.316 A) ----
select (resno=4 or resno=10 or resno=11 or resno=14) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=10 or resno=11 or resno=14) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.171 -0.876 0.089} color red
draw site1_b1 width 0.06 line {0.171 -0.876 0.089} (chain='A' and resno=4 and atomname='O') color red
draw site1_b2 width 0.06 line {0.171 -0.876 0.089} (chain='A' and resno=11 and atomname='OG1') color red
draw site1_b3 width 0.06 line {0.171 -0.876 0.089} (chain='A' and resno=14 and atomname='O') color red
draw site1_b4 width 0.06 line {0.171 -0.876 0.089} (chain='A' and resno=10 and atomname='O') color red
set echo site1_label {0.171 -0.876 0.089}
echo pyv 0.316
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
