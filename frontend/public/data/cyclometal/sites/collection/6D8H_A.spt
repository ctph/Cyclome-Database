load "6D8H_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.383 A) ----
select (resno=13 or resno=16 or resno=17 or resno=31) and chain='A'
