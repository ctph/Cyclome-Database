# 2H7Z_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.464 A | donors A:GLU12:OE1;A:LYS49:O;A:TYR33:OH;A:CYS51:O | metals: cobalt,copper,manganese,nickel

load "2H7Z_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.464 A) ----
select (resno=12 or resno=33 or resno=49 or resno=51) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=12 or resno=33 or resno=49 or resno=51) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {11.699 -17.210 9.667} color red
draw site1_b1 width 0.06 line {11.699 -17.210 9.667} (chain='A' and resno=12 and atomname='OE1') color red
draw site1_b2 width 0.06 line {11.699 -17.210 9.667} (chain='A' and resno=49 and atomname='O') color red
draw site1_b3 width 0.06 line {11.699 -17.210 9.667} (chain='A' and resno=33 and atomname='OH') color red
draw site1_b4 width 0.06 line {11.699 -17.210 9.667} (chain='A' and resno=51 and atomname='O') color red
set echo site1_label {11.699 -17.210 9.667}
echo bvp 0.464
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
