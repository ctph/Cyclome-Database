# 5E5Q_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.333 A | donors B:LYS53:O;B:TYR50:O;B:CYS62:O;B:SER60:OG | metals: cobalt,copper,manganese,nickel

load "5E5Q_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.333 A) ----
select (resno=50 or resno=53 or resno=60 or resno=62) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=50 or resno=53 or resno=60 or resno=62) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {46.635 -9.659 7.952} color red
draw site1_b1 width 0.06 line {46.635 -9.659 7.952} (chain='B' and resno=53 and atomname='O') color red
draw site1_b2 width 0.06 line {46.635 -9.659 7.952} (chain='B' and resno=50 and atomname='O') color red
draw site1_b3 width 0.06 line {46.635 -9.659 7.952} (chain='B' and resno=62 and atomname='O') color red
draw site1_b4 width 0.06 line {46.635 -9.659 7.952} (chain='B' and resno=60 and atomname='OG') color red
set echo site1_label {46.635 -9.659 7.952}
echo bvp 0.333
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
