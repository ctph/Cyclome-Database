# 4R5R_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.226 A | donors B:CYS14:O;B:SER8:O;B:CYS19:O;B:ALA16:O | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): tet RMSD 0.319 A | donors B:ALA16:O;B:LYS20:O;B:CYS6:O;B:ASN11:O | metals: cobalt,copper,manganese,nickel,samarium

load "4R5R_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.226 A) ----
select (resno=8 or resno=14 or resno=16 or resno=19) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=8 or resno=14 or resno=16 or resno=19) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-1.588 34.073 -40.588} color red
draw site1_b1 width 0.06 line {-1.588 34.073 -40.588} (chain='B' and resno=14 and atomname='O') color red
draw site1_b2 width 0.06 line {-1.588 34.073 -40.588} (chain='B' and resno=8 and atomname='O') color red
draw site1_b3 width 0.06 line {-1.588 34.073 -40.588} (chain='B' and resno=19 and atomname='O') color red
draw site1_b4 width 0.06 line {-1.588 34.073 -40.588} (chain='B' and resno=16 and atomname='O') color red
set echo site1_label {-1.588 34.073 -40.588}
echo tet 0.226
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.319 A) ----
select (resno=6 or resno=11 or resno=16 or resno=20) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=11 or resno=16 or resno=20) and chain='B' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-1.250 33.615 -39.992} color blue
draw site2_b1 width 0.06 line {-1.250 33.615 -39.992} (chain='B' and resno=16 and atomname='O') color blue
draw site2_b2 width 0.06 line {-1.250 33.615 -39.992} (chain='B' and resno=20 and atomname='O') color blue
draw site2_b3 width 0.06 line {-1.250 33.615 -39.992} (chain='B' and resno=6 and atomname='O') color blue
draw site2_b4 width 0.06 line {-1.250 33.615 -39.992} (chain='B' and resno=11 and atomname='O') color blue
set echo site2_label {-1.250 33.615 -39.992}
echo tet 0.319
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
