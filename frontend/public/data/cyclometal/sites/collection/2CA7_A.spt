# 2CA7_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.280 A | donors A:THR56:O;A:CYS57:O;A:ASP2:O;A:TYR59:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): spy RMSD 0.493 A | donors A:CYS7:O;A:LEU9:O;A:LEU6:O;A:TYR25:O;A:ASN45:OD1 | metals: cobalt,copper,europium,gadolinium,holmium,manganese,nickel,praseodymium,samarium,terbium,ytterbium

load "2CA7_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.280 A) ----
select (resno=2 or resno=56 or resno=57 or resno=59) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=56 or resno=57 or resno=59) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.167 -11.801 -2.806} color red
draw site1_b1 width 0.06 line {-0.167 -11.801 -2.806} (chain='A' and resno=56 and atomname='O') color red
draw site1_b2 width 0.06 line {-0.167 -11.801 -2.806} (chain='A' and resno=57 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.167 -11.801 -2.806} (chain='A' and resno=2 and atomname='O') color red
draw site1_b4 width 0.06 line {-0.167 -11.801 -2.806} (chain='A' and resno=59 and atomname='O') color red
set echo site1_label {-0.167 -11.801 -2.806}
echo bvp 0.280
color echo black
font echo 18

# ---- Site 2: spy (RMSD 0.493 A) ----
select (resno=6 or resno=7 or resno=9 or resno=25 or resno=45) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=7 or resno=9 or resno=25 or resno=45) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {3.496 -3.152 -0.725} color blue
draw site2_b1 width 0.06 line {3.496 -3.152 -0.725} (chain='A' and resno=7 and atomname='O') color blue
draw site2_b2 width 0.06 line {3.496 -3.152 -0.725} (chain='A' and resno=9 and atomname='O') color blue
draw site2_b3 width 0.06 line {3.496 -3.152 -0.725} (chain='A' and resno=6 and atomname='O') color blue
draw site2_b4 width 0.06 line {3.496 -3.152 -0.725} (chain='A' and resno=25 and atomname='O') color blue
draw site2_b5 width 0.06 line {3.496 -3.152 -0.725} (chain='A' and resno=45 and atomname='OD1') color blue
set echo site2_label {3.496 -3.152 -0.725}
echo spy 0.493
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
