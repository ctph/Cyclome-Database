# 1MMC_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.354 A | donors A:TYR20:OH;A:GLU3:OE2;A:GLY19:O;A:GLY2:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1MMC_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.354 A) ----
select (resno=2 or resno=3 or resno=19 or resno=20) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=3 or resno=19 or resno=20) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-3.667 7.330 -4.681} color red
draw site1_b1 width 0.06 line {-3.667 7.330 -4.681} (chain='A' and resno=20 and atomname='OH') color red
draw site1_b2 width 0.06 line {-3.667 7.330 -4.681} (chain='A' and resno=3 and atomname='OE2') color red
draw site1_b3 width 0.06 line {-3.667 7.330 -4.681} (chain='A' and resno=19 and atomname='O') color red
draw site1_b4 width 0.06 line {-3.667 7.330 -4.681} (chain='A' and resno=2 and atomname='O') color red
set echo site1_label {-3.667 7.330 -4.681}
echo bva 0.354
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
