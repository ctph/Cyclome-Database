# 6LSQ_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.181 A | donors A:ASP29:OD1;A:ALA23:O;A:GLY25:O;A:ASP27:O | metals: cobalt,copper,manganese,nickel

load "6LSQ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.181 A) ----
select (resno=23 or resno=25 or resno=27 or resno=29) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=23 or resno=25 or resno=27 or resno=29) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-24.901 8.915 4.985} color red
draw site1_b1 width 0.06 line {-24.901 8.915 4.985} (chain='A' and resno=29 and atomname='OD1') color red
draw site1_b2 width 0.06 line {-24.901 8.915 4.985} (chain='A' and resno=23 and atomname='O') color red
draw site1_b3 width 0.06 line {-24.901 8.915 4.985} (chain='A' and resno=25 and atomname='O') color red
draw site1_b4 width 0.06 line {-24.901 8.915 4.985} (chain='A' and resno=27 and atomname='O') color red
set echo site1_label {-24.901 8.915 4.985}
echo bvp 0.181
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
