# 2JRY_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.346 A | donors A:PHE4:O;A:ALA16:O;A:ASP17:OD1;A:ASP17:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2JRY_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.346 A) ----
select (resno=4 or resno=16 or resno=17) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=16 or resno=17) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.650 -6.016 7.490} color red
draw site1_b1 width 0.06 line {3.650 -6.016 7.490} (chain='A' and resno=4 and atomname='O') color red
draw site1_b2 width 0.06 line {3.650 -6.016 7.490} (chain='A' and resno=16 and atomname='O') color red
draw site1_b3 width 0.06 line {3.650 -6.016 7.490} (chain='A' and resno=17 and atomname='OD1') color red
draw site1_b4 width 0.06 line {3.650 -6.016 7.490} (chain='A' and resno=17 and atomname='O') color red
set echo site1_label {3.650 -6.016 7.490}
echo bva 0.346
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
