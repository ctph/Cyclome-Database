load "1BQF_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.254 A) ----
select (resno=10 or resno=12 or resno=21 or resno=22) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=10 or resno=12 or resno=21 or resno=22) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.152 -5.702 3.350} color red
draw site1_b1 width 0.06 line {1.152 -5.702 3.350} (chain='A' and resno=12 and atomname='SD') color red
draw site1_b2 width 0.06 line {1.152 -5.702 3.350} (chain='A' and resno=21 and atomname='O') color red
