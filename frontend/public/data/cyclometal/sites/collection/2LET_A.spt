# 2LET_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.269 A | donors A:CYS15:O;A:CYS19:O;A:ASP12:O;A:LEU16:O | metals: cobalt,copper,europium,manganese,nickel
# Site 2 (blue): bva RMSD 0.398 A | donors A:CYS9:O;A:CYS21:O;A:PRO23:O;A:PHE26:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2LET_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.269 A) ----
select (resno=12 or resno=15 or resno=16 or resno=19) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=12 or resno=15 or resno=16 or resno=19) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.522 -5.002 2.205} color red
draw site1_b1 width 0.06 line {3.522 -5.002 2.205} (chain='A' and resno=15 and atomname='O') color red
draw site1_b2 width 0.06 line {3.522 -5.002 2.205} (chain='A' and resno=19 and atomname='O') color red
draw site1_b3 width 0.06 line {3.522 -5.002 2.205} (chain='A' and resno=12 and atomname='O') color red
draw site1_b4 width 0.06 line {3.522 -5.002 2.205} (chain='A' and resno=16 and atomname='O') color red
set echo site1_label {3.522 -5.002 2.205}
echo spl 0.269
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.398 A) ----
select (resno=9 or resno=21 or resno=23 or resno=26) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=9 or resno=21 or resno=23 or resno=26) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-7.083 -3.750 3.840} color blue
draw site2_b1 width 0.06 line {-7.083 -3.750 3.840} (chain='A' and resno=9 and atomname='O') color blue
draw site2_b2 width 0.06 line {-7.083 -3.750 3.840} (chain='A' and resno=21 and atomname='O') color blue
draw site2_b3 width 0.06 line {-7.083 -3.750 3.840} (chain='A' and resno=23 and atomname='O') color blue
draw site2_b4 width 0.06 line {-7.083 -3.750 3.840} (chain='A' and resno=26 and atomname='O') color blue
set echo site2_label {-7.083 -3.750 3.840}
echo bva 0.398
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
