# 1TCJ_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.296 A | donors A:LYS9:O;A:CYS15:O;A:ASP12:O;A:CYS10:O | metals: cobalt,copper,manganese,nickel

load "1TCJ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.296 A) ----
select (resno=9 or resno=10 or resno=12 or resno=15) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=9 or resno=10 or resno=12 or resno=15) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.924 2.950 -11.549} color red
draw site1_b1 width 0.06 line {1.924 2.950 -11.549} (chain='A' and resno=9 and atomname='O') color red
draw site1_b2 width 0.06 line {1.924 2.950 -11.549} (chain='A' and resno=15 and atomname='O') color red
draw site1_b3 width 0.06 line {1.924 2.950 -11.549} (chain='A' and resno=12 and atomname='O') color red
draw site1_b4 width 0.06 line {1.924 2.950 -11.549} (chain='A' and resno=10 and atomname='O') color red
set echo site1_label {1.924 2.950 -11.549}
echo pyv 0.296
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
