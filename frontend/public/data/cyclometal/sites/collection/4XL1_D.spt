# 4XL1_D: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.166 A | donors D:ASN490:O;D:THR491:O;D:ASP507:OD2;D:ASN490:OD1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bvp RMSD 0.174 A | donors D:ASP452:OD1;D:ASP469:OD2;D:ASP469:O;D:GLN470:O | metals: cobalt,copper,manganese,nickel
# Site 3 (green): bvp RMSD 0.180 A | donors D:GLY443:O;D:ASP452:OD1;D:GLN470:O;D:GLU455:OE2 | metals: cobalt,copper,manganese,nickel

load "4XL1_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.166 A) ----
select (resno=490 or resno=491 or resno=507) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=490 or resno=491 or resno=507) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {5.219 -10.034 5.842} color red
draw site1_b1 width 0.06 line {5.219 -10.034 5.842} (chain='D' and resno=490 and atomname='O') color red
draw site1_b2 width 0.06 line {5.219 -10.034 5.842} (chain='D' and resno=491 and atomname='O') color red
draw site1_b3 width 0.06 line {5.219 -10.034 5.842} (chain='D' and resno=507 and atomname='OD2') color red
draw site1_b4 width 0.06 line {5.219 -10.034 5.842} (chain='D' and resno=490 and atomname='OD1') color red
set echo site1_label {5.219 -10.034 5.842}
echo pyv 0.166
color echo black
font echo 18

# ---- Site 2: bvp (RMSD 0.174 A) ----
select (resno=452 or resno=469 or resno=470) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=452 or resno=469 or resno=470) and chain='D' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {8.655 -39.430 -1.358} color blue
draw site2_b1 width 0.06 line {8.655 -39.430 -1.358} (chain='D' and resno=452 and atomname='OD1') color blue
draw site2_b2 width 0.06 line {8.655 -39.430 -1.358} (chain='D' and resno=469 and atomname='OD2') color blue
draw site2_b3 width 0.06 line {8.655 -39.430 -1.358} (chain='D' and resno=469 and atomname='O') color blue
draw site2_b4 width 0.06 line {8.655 -39.430 -1.358} (chain='D' and resno=470 and atomname='O') color blue
set echo site2_label {8.655 -39.430 -1.358}
echo bvp 0.174
color echo black
font echo 18

# ---- Site 3: bvp (RMSD 0.180 A) ----
select (resno=443 or resno=452 or resno=455 or resno=470) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=443 or resno=452 or resno=455 or resno=470) and chain='D' and carbon
color wireframe green
draw site3_center sphere diameter 1.4 {8.020 -41.327 2.225} color green
draw site3_b1 width 0.06 line {8.020 -41.327 2.225} (chain='D' and resno=443 and atomname='O') color green
draw site3_b2 width 0.06 line {8.020 -41.327 2.225} (chain='D' and resno=452 and atomname='OD1') color green
draw site3_b3 width 0.06 line {8.020 -41.327 2.225} (chain='D' and resno=470 and atomname='O') color green
draw site3_b4 width 0.06 line {8.020 -41.327 2.225} (chain='D' and resno=455 and atomname='OE2') color green
set echo site3_label {8.020 -41.327 2.225}
echo bvp 0.180
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
