# 1BGK_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.197 A | donors A:ASP4:O;A:ARG3:O;A:ALA28:O;A:ASN29:O | metals: cobalt,copper,manganese,nickel

load "1BGK_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.197 A) ----
select (resno=3 or resno=4 or resno=28 or resno=29) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=4 or resno=28 or resno=29) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.345 -1.062 -0.125} color red
draw site1_b1 width 0.06 line {-5.345 -1.062 -0.125} (chain='A' and resno=4 and atomname='O') color red
draw site1_b2 width 0.06 line {-5.345 -1.062 -0.125} (chain='A' and resno=3 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.345 -1.062 -0.125} (chain='A' and resno=28 and atomname='O') color red
draw site1_b4 width 0.06 line {-5.345 -1.062 -0.125} (chain='A' and resno=29 and atomname='O') color red
set echo site1_label {-5.345 -1.062 -0.125}
echo bvp 0.197
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
