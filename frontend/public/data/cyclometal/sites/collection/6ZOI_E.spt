# 6ZOI_E: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.328 A | donors E:SER27:OG;E:ASN8:O;E:CYS7:O;E:ASN8:OD1 | metals: cobalt,copper,manganese,nickel

load "6ZOI_E.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.328 A) ----
select (resno=7 or resno=8 or resno=27) and chain='E'
wireframe 0.18
color wireframe cpk
select (resno=7 or resno=8 or resno=27) and chain='E' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {26.384 12.180 -2.089} color red
draw site1_b1 width 0.06 line {26.384 12.180 -2.089} (chain='E' and resno=27 and atomname='OG') color red
draw site1_b2 width 0.06 line {26.384 12.180 -2.089} (chain='E' and resno=8 and atomname='O') color red
draw site1_b3 width 0.06 line {26.384 12.180 -2.089} (chain='E' and resno=7 and atomname='O') color red
draw site1_b4 width 0.06 line {26.384 12.180 -2.089} (chain='E' and resno=8 and atomname='OD1') color red
set echo site1_label {26.384 12.180 -2.089}
echo pyv 0.328
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
