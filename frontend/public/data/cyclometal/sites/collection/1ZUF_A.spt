# 1ZUF_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.330 A | donors A:CYS39:O;A:HIS12:ND1;A:GLU41:OE1;A:ALA28:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): tet RMSD 0.462 A | donors A:ALA28:O;A:GLU41:OE1;A:HIS12:ND1;A:CYS39:O | metals: cobalt,copper,manganese,nickel,samarium

load "1ZUF_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.330 A) ----
select (resno=12 or resno=28 or resno=39 or resno=41) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=12 or resno=28 or resno=39 or resno=41) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-13.983 -3.872 -1.675} color red
draw site1_b1 width 0.06 line {-13.983 -3.872 -1.675} (chain='A' and resno=39 and atomname='O') color red
draw site1_b2 width 0.06 line {-13.983 -3.872 -1.675} (chain='A' and resno=12 and atomname='ND1') color red
draw site1_b3 width 0.06 line {-13.983 -3.872 -1.675} (chain='A' and resno=41 and atomname='OE1') color red
draw site1_b4 width 0.06 line {-13.983 -3.872 -1.675} (chain='A' and resno=28 and atomname='O') color red
set echo site1_label {-13.983 -3.872 -1.675}
echo bva 0.330
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.462 A) ----
select (resno=12 or resno=28 or resno=39 or resno=41) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=12 or resno=28 or resno=39 or resno=41) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-13.670 -3.112 -2.287} color blue
draw site2_b1 width 0.06 line {-13.670 -3.112 -2.287} (chain='A' and resno=28 and atomname='O') color blue
draw site2_b2 width 0.06 line {-13.670 -3.112 -2.287} (chain='A' and resno=41 and atomname='OE1') color blue
draw site2_b3 width 0.06 line {-13.670 -3.112 -2.287} (chain='A' and resno=12 and atomname='ND1') color blue
draw site2_b4 width 0.06 line {-13.670 -3.112 -2.287} (chain='A' and resno=39 and atomname='O') color blue
set echo site2_label {-13.670 -3.112 -2.287}
echo tet 0.462
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
