# Site 1 (red): tet RMSD 0.413 A | donors A:SER112:OG;A:GLN81:OE1;A:SER53:O;A:ASP55:O | metals: cobalt,copper,manganese,nickel,samarium

load "2PJY_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.413 A) ----
select (resno=53 or resno=55 or resno=81 or resno=112) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=53 or resno=55 or resno=81 or resno=112) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-6.285 -5.920 -3.592} color red
draw site1_b1 width 0.06 line {-6.285 -5.920 -3.592} (chain='A' and resno=112 and atomname='OG') color red
draw site1_b2 width 0.06 line {-6.285 -5.920 -3.592} (chain='A' and resno=81 and atomname='OE1') color red
draw site1_b3 width 0.06 line {-6.285 -5.920 -3.592} (chain='A' and resno=53 and atomname='O') color red
draw site1_b4 width 0.06 line {-6.285 -5.920 -3.592} (chain='A' and resno=55 and atomname='O') color red
set echo site1_label {-6.285 -5.920 -3.592}
echo tet 0.413
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
