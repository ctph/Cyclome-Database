# 2W9U_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.422 A | donors A:ASP3:OD2;A:ASP3:O;A:CYS4:O;A:MET2:O | metals: cobalt,copper,manganese,nickel

load "2W9U_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.422 A) ----
select (resno=2 or resno=3 or resno=4) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=3 or resno=4) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-14.636 -3.225 4.720} color red
draw site1_b1 width 0.06 line {-14.636 -3.225 4.720} (chain='A' and resno=3 and atomname='OD2') color red
draw site1_b2 width 0.06 line {-14.636 -3.225 4.720} (chain='A' and resno=3 and atomname='O') color red
draw site1_b3 width 0.06 line {-14.636 -3.225 4.720} (chain='A' and resno=4 and atomname='O') color red
draw site1_b4 width 0.06 line {-14.636 -3.225 4.720} (chain='A' and resno=2 and atomname='O') color red
set echo site1_label {-14.636 -3.225 4.720}
echo pyv 0.422
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
