# 1MCT_I: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.141 A | donors I:ALA18:O;I:CYS20:O;I:ASP13:O;I:CYS16:O | metals: cobalt,copper,manganese,nickel

load "1MCT_I.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.141 A) ----
select (resno=13 or resno=16 or resno=18 or resno=20) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=13 or resno=16 or resno=18 or resno=20) and chain='I' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {7.784 23.194 4.338} color red
draw site1_b1 width 0.06 line {7.784 23.194 4.338} (chain='I' and resno=18 and atomname='O') color red
draw site1_b2 width 0.06 line {7.784 23.194 4.338} (chain='I' and resno=20 and atomname='O') color red
draw site1_b3 width 0.06 line {7.784 23.194 4.338} (chain='I' and resno=13 and atomname='O') color red
draw site1_b4 width 0.06 line {7.784 23.194 4.338} (chain='I' and resno=16 and atomname='O') color red
set echo site1_label {7.784 23.194 4.338}
echo bvp 0.141
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
