# 5IMT_D: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.297 A | donors D:HIS44:ND1;D:HIS44:O;D:ASP49:O;D:ASP49:OD2 | metals: cobalt,copper,manganese,nickel

load "5IMT_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.297 A) ----
select (resno=44 or resno=49) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=44 or resno=49) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {95.495 59.704 121.124} color red
draw site1_b1 width 0.06 line {95.495 59.704 121.124} (chain='D' and resno=44 and atomname='ND1') color red
draw site1_b2 width 0.06 line {95.495 59.704 121.124} (chain='D' and resno=44 and atomname='O') color red
draw site1_b3 width 0.06 line {95.495 59.704 121.124} (chain='D' and resno=49 and atomname='O') color red
draw site1_b4 width 0.06 line {95.495 59.704 121.124} (chain='D' and resno=49 and atomname='OD2') color red
set echo site1_label {95.495 59.704 121.124}
echo pyv 0.297
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
