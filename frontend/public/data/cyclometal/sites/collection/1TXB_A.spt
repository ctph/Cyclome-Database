# 1TXB_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.250 A | donors A:GLY35:O;A:SER32:O;A:SER33:OG;A:TRP69:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): spl RMSD 0.260 A | donors A:ASP19:O;A:ASP61:O;A:ILE20:O;A:THR60:O | metals: cobalt,copper,europium,manganese,nickel

load "1TXB_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.250 A) ----
select (resno=32 or resno=33 or resno=35 or resno=69) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=32 or resno=33 or resno=35 or resno=69) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-10.782 1.159 0.061} color red
draw site1_b1 width 0.06 line {-10.782 1.159 0.061} (chain='A' and resno=35 and atomname='O') color red
draw site1_b2 width 0.06 line {-10.782 1.159 0.061} (chain='A' and resno=32 and atomname='O') color red
draw site1_b3 width 0.06 line {-10.782 1.159 0.061} (chain='A' and resno=33 and atomname='OG') color red
draw site1_b4 width 0.06 line {-10.782 1.159 0.061} (chain='A' and resno=69 and atomname='O') color red
set echo site1_label {-10.782 1.159 0.061}
echo bvp 0.250
color echo black
font echo 18

# ---- Site 2: spl (RMSD 0.260 A) ----
select (resno=19 or resno=20 or resno=60 or resno=61) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=19 or resno=20 or resno=60 or resno=61) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {10.103 -0.863 -5.303} color blue
draw site2_b1 width 0.06 line {10.103 -0.863 -5.303} (chain='A' and resno=19 and atomname='O') color blue
draw site2_b2 width 0.06 line {10.103 -0.863 -5.303} (chain='A' and resno=61 and atomname='O') color blue
draw site2_b3 width 0.06 line {10.103 -0.863 -5.303} (chain='A' and resno=20 and atomname='O') color blue
draw site2_b4 width 0.06 line {10.103 -0.863 -5.303} (chain='A' and resno=60 and atomname='O') color blue
set echo site2_label {10.103 -0.863 -5.303}
echo spl 0.260
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
