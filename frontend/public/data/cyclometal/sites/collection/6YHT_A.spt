# 6YHT_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.370 A | donors A:GLY14:O;A:SER13:O;A:ASN38:OD1;A:SER13:OG | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "6YHT_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.370 A) ----
select (resno=13 or resno=14 or resno=38) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=13 or resno=14 or resno=38) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-2.319 -29.793 -8.218} color red
draw site1_b1 width 0.06 line {-2.319 -29.793 -8.218} (chain='A' and resno=14 and atomname='O') color red
draw site1_b2 width 0.06 line {-2.319 -29.793 -8.218} (chain='A' and resno=13 and atomname='O') color red
draw site1_b3 width 0.06 line {-2.319 -29.793 -8.218} (chain='A' and resno=38 and atomname='OD1') color red
draw site1_b4 width 0.06 line {-2.319 -29.793 -8.218} (chain='A' and resno=13 and atomname='OG') color red
set echo site1_label {-2.319 -29.793 -8.218}
echo bva 0.370
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
