# 2PO8_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.400 A | donors A:GLY16:O;A:ALA17:O;A:SER30:O;A:SER30:OG | metals: cobalt,copper,manganese,nickel

load "2PO8_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.400 A) ----
select (resno=16 or resno=17 or resno=30) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=16 or resno=17 or resno=30) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.103 -0.474 7.377} color red
draw site1_b1 width 0.06 line {4.103 -0.474 7.377} (chain='A' and resno=16 and atomname='O') color red
draw site1_b2 width 0.06 line {4.103 -0.474 7.377} (chain='A' and resno=17 and atomname='O') color red
draw site1_b3 width 0.06 line {4.103 -0.474 7.377} (chain='A' and resno=30 and atomname='O') color red
draw site1_b4 width 0.06 line {4.103 -0.474 7.377} (chain='A' and resno=30 and atomname='OG') color red
set echo site1_label {4.103 -0.474 7.377}
echo pyv 0.400
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
