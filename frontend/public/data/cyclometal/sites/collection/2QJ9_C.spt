color wireframe red
draw site1_center sphere diameter 1.4 {44.675 -24.085 17.213} color red
draw site1_b1 width 0.06 line {44.675 -24.085 17.213} (chain='C' and resno=73 and atomname='O') color red
draw site1_b2 width 0.06 line {44.675 -24.085 17.213} (chain='C' and resno=72 and atomname='OG1') color red
draw site1_b3 width 0.06 line {44.675 -24.085 17.213} (chain='C' and resno=64 and atomname='OE1') color red
draw site1_b4 width 0.06 line {44.675 -24.085 17.213} (chain='C' and resno=62 and atomname='O') color red
set echo site1_label {44.675 -24.085 17.213}
echo bvp 0.145
color echo black
font echo 18

