# Site 2 (blue): bva RMSD 0.295 A | donors C:HIS58:ND1;C:ASN56:O;C:TYR80:O;C:MET78:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2QJ9_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.145 A) ----
select (resno=62 or resno=64 or resno=72 or resno=73) and chain='C'
wireframe 0.18
color wireframe cpk
