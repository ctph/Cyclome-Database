# 2PJF_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.431 A | donors A:CYS4:O;A:ASP5:O;A:SER7:OG;A:CYS6:O | metals: cobalt,copper,manganese,nickel

load "2PJF_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.431 A) ----
select (resno=4 or resno=5 or resno=6 or resno=7) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=5 or resno=6 or resno=7) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-7.986 1.380 9.270} color red
draw site1_b1 width 0.06 line {-7.986 1.380 9.270} (chain='A' and resno=4 and atomname='O') color red
draw site1_b2 width 0.06 line {-7.986 1.380 9.270} (chain='A' and resno=5 and atomname='O') color red
draw site1_b3 width 0.06 line {-7.986 1.380 9.270} (chain='A' and resno=7 and atomname='OG') color red
draw site1_b4 width 0.06 line {-7.986 1.380 9.270} (chain='A' and resno=6 and atomname='O') color red
set echo site1_label {-7.986 1.380 9.270}
echo pyv 0.431
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
