# 1NB1_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.155 A | donors A:THR16:O;A:THR23:O;A:THR16:OG1;A:THR23:OG1 | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): pyv RMSD 0.288 A | donors A:THR16:OG1;A:THR23:OG1;A:SER18:OG;A:THR16:O | metals: cobalt,copper,manganese,nickel

load "1NB1_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.155 A) ----
select (resno=16 or resno=23) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=16 or resno=23) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.479 2.667 1.458} color red
draw site1_b1 width 0.06 line {0.479 2.667 1.458} (chain='A' and resno=16 and atomname='O') color red
draw site1_b2 width 0.06 line {0.479 2.667 1.458} (chain='A' and resno=23 and atomname='O') color red
draw site1_b3 width 0.06 line {0.479 2.667 1.458} (chain='A' and resno=16 and atomname='OG1') color red
draw site1_b4 width 0.06 line {0.479 2.667 1.458} (chain='A' and resno=23 and atomname='OG1') color red
set echo site1_label {0.479 2.667 1.458}
echo tet 0.155
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.288 A) ----
select (resno=16 or resno=18 or resno=23) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=16 or resno=18 or resno=23) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-1.213 3.090 2.364} color blue
draw site2_b1 width 0.06 line {-1.213 3.090 2.364} (chain='A' and resno=16 and atomname='OG1') color blue
draw site2_b2 width 0.06 line {-1.213 3.090 2.364} (chain='A' and resno=23 and atomname='OG1') color blue
draw site2_b3 width 0.06 line {-1.213 3.090 2.364} (chain='A' and resno=18 and atomname='OG') color blue
draw site2_b4 width 0.06 line {-1.213 3.090 2.364} (chain='A' and resno=16 and atomname='O') color blue
set echo site2_label {-1.213 3.090 2.364}
echo pyv 0.288
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
