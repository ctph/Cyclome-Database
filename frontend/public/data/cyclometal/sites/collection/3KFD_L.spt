# 3KFD_L: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.316 A | donors L:THR35:OG1;L:THR35:O;L:THR37:OG1;L:GLU36:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): spl RMSD 0.319 A | donors L:GLN11:O;L:THR23:OG1;L:CYS24:O;L:HIS81:NE2 | metals: cobalt,copper,europium,manganese,nickel

load "3KFD_L.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.316 A) ----
select (resno=35 or resno=36 or resno=37) and chain='L'
wireframe 0.18
color wireframe cpk
select (resno=35 or resno=36 or resno=37) and chain='L' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-8.926 -66.915 15.533} color red
draw site1_b1 width 0.06 line {-8.926 -66.915 15.533} (chain='L' and resno=35 and atomname='OG1') color red
draw site1_b2 width 0.06 line {-8.926 -66.915 15.533} (chain='L' and resno=35 and atomname='O') color red
draw site1_b3 width 0.06 line {-8.926 -66.915 15.533} (chain='L' and resno=37 and atomname='OG1') color red
draw site1_b4 width 0.06 line {-8.926 -66.915 15.533} (chain='L' and resno=36 and atomname='O') color red
set echo site1_label {-8.926 -66.915 15.533}
echo pyv 0.316
color echo black
font echo 18

# ---- Site 2: spl (RMSD 0.319 A) ----
select (resno=11 or resno=23 or resno=24 or resno=81) and chain='L'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=23 or resno=24 or resno=81) and chain='L' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-30.977 -66.742 24.083} color blue
draw site2_b1 width 0.06 line {-30.977 -66.742 24.083} (chain='L' and resno=11 and atomname='O') color blue
draw site2_b2 width 0.06 line {-30.977 -66.742 24.083} (chain='L' and resno=23 and atomname='OG1') color blue
draw site2_b3 width 0.06 line {-30.977 -66.742 24.083} (chain='L' and resno=24 and atomname='O') color blue
draw site2_b4 width 0.06 line {-30.977 -66.742 24.083} (chain='L' and resno=81 and atomname='NE2') color blue
set echo site2_label {-30.977 -66.742 24.083}
echo spl 0.319
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
