# 2YBR_G: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.295 A | donors G:LEU79:O;G:SER80:OG;G:SER21:OG;G:LEU20:O | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): pyv RMSD 0.318 A | donors G:ASN84:OD1;G:GLN82:O;G:THR69:OG1;G:ARG67:O | metals: cobalt,copper,manganese,nickel

load "2YBR_G.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.295 A) ----
select (resno=20 or resno=21 or resno=79 or resno=80) and chain='G'
wireframe 0.18
color wireframe cpk
select (resno=20 or resno=21 or resno=79 or resno=80) and chain='G' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-43.237 16.175 53.533} color red
draw site1_b1 width 0.06 line {-43.237 16.175 53.533} (chain='G' and resno=79 and atomname='O') color red
draw site1_b2 width 0.06 line {-43.237 16.175 53.533} (chain='G' and resno=80 and atomname='OG') color red
draw site1_b3 width 0.06 line {-43.237 16.175 53.533} (chain='G' and resno=21 and atomname='OG') color red
draw site1_b4 width 0.06 line {-43.237 16.175 53.533} (chain='G' and resno=20 and atomname='O') color red
set echo site1_label {-43.237 16.175 53.533}
echo tet 0.295
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.318 A) ----
select (resno=67 or resno=69 or resno=82 or resno=84) and chain='G'
wireframe 0.18
color wireframe cpk
select (resno=67 or resno=69 or resno=82 or resno=84) and chain='G' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-52.239 11.795 59.989} color blue
draw site2_b1 width 0.06 line {-52.239 11.795 59.989} (chain='G' and resno=84 and atomname='OD1') color blue
draw site2_b2 width 0.06 line {-52.239 11.795 59.989} (chain='G' and resno=82 and atomname='O') color blue
draw site2_b3 width 0.06 line {-52.239 11.795 59.989} (chain='G' and resno=69 and atomname='OG1') color blue
draw site2_b4 width 0.06 line {-52.239 11.795 59.989} (chain='G' and resno=67 and atomname='O') color blue
set echo site2_label {-52.239 11.795 59.989}
echo pyv 0.318
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
