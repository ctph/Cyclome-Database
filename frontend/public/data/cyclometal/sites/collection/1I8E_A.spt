# 1I8E_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.349 A | donors A:CYS10:O;A:TYR11:O;A:CYS2:O;A:TYR3:O | metals: cobalt,copper,manganese,nickel

load "1I8E_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.349 A) ----
select (resno=2 or resno=3 or resno=10 or resno=11) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=3 or resno=10 or resno=11) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.518 7.647 -1.438} color red
draw site1_b1 width 0.06 line {-5.518 7.647 -1.438} (chain='A' and resno=10 and atomname='O') color red
draw site1_b2 width 0.06 line {-5.518 7.647 -1.438} (chain='A' and resno=11 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.518 7.647 -1.438} (chain='A' and resno=2 and atomname='O') color red
draw site1_b4 width 0.06 line {-5.518 7.647 -1.438} (chain='A' and resno=3 and atomname='O') color red
set echo site1_label {-5.518 7.647 -1.438}
echo pyv 0.349
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
