# Site 1 (red): bva RMSD 0.458 A | donors A:TYR32:OH;A:CYS24:O;A:TYR23:O;A:PHE30:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1MR0_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.458 A) ----
select (resno=23 or resno=24 or resno=30 or resno=32) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=23 or resno=24 or resno=30 or resno=32) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.877 4.156 -4.952} color red
draw site1_b1 width 0.06 line {1.877 4.156 -4.952} (chain='A' and resno=32 and atomname='OH') color red
draw site1_b2 width 0.06 line {1.877 4.156 -4.952} (chain='A' and resno=24 and atomname='O') color red
draw site1_b3 width 0.06 line {1.877 4.156 -4.952} (chain='A' and resno=23 and atomname='O') color red
draw site1_b4 width 0.06 line {1.877 4.156 -4.952} (chain='A' and resno=30 and atomname='O') color red
set echo site1_label {1.877 4.156 -4.952}
echo bva 0.458
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
