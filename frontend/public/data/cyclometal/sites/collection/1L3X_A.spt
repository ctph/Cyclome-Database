draw site1_center sphere diameter 1.4 {-3.387 10.981 6.191} color red
draw site1_b1 width 0.06 line {-3.387 10.981 6.191} (chain='A' and resno=5 and atomname='OE2') color red
draw site1_b2 width 0.06 line {-3.387 10.981 6.191} (chain='A' and resno=4 and atomname='O') color red
