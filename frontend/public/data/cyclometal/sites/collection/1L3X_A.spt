draw site1_b4 width 0.06 line {-3.387 10.981 6.191} (chain='A' and resno=3 and atomname='O') color red
set echo site1_label {-3.387 10.981 6.191}
echo pyv 0.388
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
