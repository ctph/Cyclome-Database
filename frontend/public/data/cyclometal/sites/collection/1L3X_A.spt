load "1L3X_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.388 A) ----
select (resno=3 or resno=4 or resno=5) and chain='A'
