# 1AS5_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.422 A | donors A:LYS9:O;A:CYS4:O;A:CYS5:O;A:LEU6:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bvp RMSD 0.477 A | donors A:CYS5:O;A:LEU6:O;A:LYS9:O;A:CYS4:O | metals: cobalt,copper,manganese,nickel

load "1AS5_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.422 A) ----
select (resno=4 or resno=5 or resno=6 or resno=9) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=5 or resno=6 or resno=9) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {2.581 -3.824 -1.905} color red
draw site1_b1 width 0.06 line {2.581 -3.824 -1.905} (chain='A' and resno=9 and atomname='O') color red
draw site1_b2 width 0.06 line {2.581 -3.824 -1.905} (chain='A' and resno=4 and atomname='O') color red
draw site1_b3 width 0.06 line {2.581 -3.824 -1.905} (chain='A' and resno=5 and atomname='O') color red
draw site1_b4 width 0.06 line {2.581 -3.824 -1.905} (chain='A' and resno=6 and atomname='O') color red
set echo site1_label {2.581 -3.824 -1.905}
echo pyv 0.422
color echo black
font echo 18

# ---- Site 2: bvp (RMSD 0.477 A) ----
select (resno=4 or resno=5 or resno=6 or resno=9) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=5 or resno=6 or resno=9) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {2.772 -3.549 -1.809} color blue
draw site2_b1 width 0.06 line {2.772 -3.549 -1.809} (chain='A' and resno=5 and atomname='O') color blue
draw site2_b2 width 0.06 line {2.772 -3.549 -1.809} (chain='A' and resno=6 and atomname='O') color blue
draw site2_b3 width 0.06 line {2.772 -3.549 -1.809} (chain='A' and resno=9 and atomname='O') color blue
draw site2_b4 width 0.06 line {2.772 -3.549 -1.809} (chain='A' and resno=4 and atomname='O') color blue
set echo site2_label {2.772 -3.549 -1.809}
echo bvp 0.477
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
