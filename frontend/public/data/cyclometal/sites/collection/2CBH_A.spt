# 2CBH_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.405 A | donors A:THR17:O;A:VAL18:O;A:GLN2:OE1;A:PRO16:O | metals: cobalt,copper,manganese,nickel,samarium

load "2CBH_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.405 A) ----
select (resno=2 or resno=16 or resno=17 or resno=18) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=16 or resno=17 or resno=18) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-3.095 3.000 2.242} color red
draw site1_b1 width 0.06 line {-3.095 3.000 2.242} (chain='A' and resno=17 and atomname='O') color red
draw site1_b2 width 0.06 line {-3.095 3.000 2.242} (chain='A' and resno=18 and atomname='O') color red
draw site1_b3 width 0.06 line {-3.095 3.000 2.242} (chain='A' and resno=2 and atomname='OE1') color red
draw site1_b4 width 0.06 line {-3.095 3.000 2.242} (chain='A' and resno=16 and atomname='O') color red
set echo site1_label {-3.095 3.000 2.242}
echo tet 0.405
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
