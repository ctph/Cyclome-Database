# 2QC1_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.435 A | donors A:MET27:SD;A:MET27:O;A:ARG25:O;A:GLU56:OE2 | metals: cobalt,copper,manganese,nickel,samarium

load "2QC1_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.435 A) ----
select (resno=25 or resno=27 or resno=56) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=25 or resno=27 or resno=56) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {8.553 -5.147 -9.681} color red
draw site1_b1 width 0.06 line {8.553 -5.147 -9.681} (chain='A' and resno=27 and atomname='SD') color red
draw site1_b2 width 0.06 line {8.553 -5.147 -9.681} (chain='A' and resno=27 and atomname='O') color red
draw site1_b3 width 0.06 line {8.553 -5.147 -9.681} (chain='A' and resno=25 and atomname='O') color red
draw site1_b4 width 0.06 line {8.553 -5.147 -9.681} (chain='A' and resno=56 and atomname='OE2') color red
set echo site1_label {8.553 -5.147 -9.681}
echo tet 0.435
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
