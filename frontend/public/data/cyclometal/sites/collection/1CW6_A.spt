draw site2_center sphere diameter 1.4 {-11.284 1.278 4.786} color blue
draw site2_b1 width 0.06 line {-11.284 1.278 4.786} (chain='A' and resno=10 and atomname='OG1') color blue
draw site2_b2 width 0.06 line {-11.284 1.278 4.786} (chain='A' and resno=8 and atomname='O') color blue
draw site2_b3 width 0.06 line {-11.284 1.278 4.786} (chain='A' and resno=15 and atomname='OG') color blue
draw site2_b4 width 0.06 line {-11.284 1.278 4.786} (chain='A' and resno=13 and atomname='O') color blue
set echo site2_label {-11.284 1.278 4.786}
