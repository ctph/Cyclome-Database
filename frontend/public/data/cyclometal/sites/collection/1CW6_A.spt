# 1CW6_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.422 A | donors A:HIS8:O;A:THR10:OG1;A:GLY13:O;A:SER15:OG | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): bva RMSD 0.489 A | donors A:THR10:OG1;A:HIS8:O;A:SER15:OG;A:GLY13:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1CW6_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.422 A) ----
select (resno=8 or resno=10 or resno=13 or resno=15) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=8 or resno=10 or resno=13 or resno=15) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-11.736 0.941 4.396} color red
draw site1_b1 width 0.06 line {-11.736 0.941 4.396} (chain='A' and resno=8 and atomname='O') color red
draw site1_b2 width 0.06 line {-11.736 0.941 4.396} (chain='A' and resno=10 and atomname='OG1') color red
draw site1_b3 width 0.06 line {-11.736 0.941 4.396} (chain='A' and resno=13 and atomname='O') color red
draw site1_b4 width 0.06 line {-11.736 0.941 4.396} (chain='A' and resno=15 and atomname='OG') color red
set echo site1_label {-11.736 0.941 4.396}
echo tet 0.422
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.489 A) ----
select (resno=8 or resno=10 or resno=13 or resno=15) and chain='A'
wireframe 0.18
color wireframe cpk
