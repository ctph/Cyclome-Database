color wireframe blue
draw site2_center sphere diameter 1.4 {-4.711 2.826 11.442} color blue
draw site2_b1 width 0.06 line {-4.711 2.826 11.442} (chain='A' and resno=70 and atomname='OG1') color blue
draw site2_b2 width 0.06 line {-4.711 2.826 11.442} (chain='A' and resno=81 and atomname='O') color blue
draw site2_b3 width 0.06 line {-4.711 2.826 11.442} (chain='A' and resno=52 and atomname='O') color blue
draw site2_b4 width 0.06 line {-4.711 2.826 11.442} (chain='A' and resno=69 and atomname='O') color blue
draw site2_b5 width 0.06 line {-4.711 2.826 11.442} (chain='A' and resno=73 and atomname='OD1') color blue
