# 3QB4_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.277 A | donors A:PRO81:O;A:ALA66:O;A:CYS52:O;A:THR70:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): tpv RMSD 0.468 A | donors A:THR70:OG1;A:PRO81:O;A:CYS52:O;A:GLN69:O;A:ASN73:OD1 | metals: cobalt,copper,manganese

load "3QB4_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.277 A) ----
select (resno=52 or resno=66 or resno=70 or resno=81) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=52 or resno=66 or resno=70 or resno=81) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.090 2.358 12.507} color red
draw site1_b1 width 0.06 line {-5.090 2.358 12.507} (chain='A' and resno=81 and atomname='O') color red
draw site1_b2 width 0.06 line {-5.090 2.358 12.507} (chain='A' and resno=66 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.090 2.358 12.507} (chain='A' and resno=52 and atomname='O') color red
draw site1_b4 width 0.06 line {-5.090 2.358 12.507} (chain='A' and resno=70 and atomname='O') color red
set echo site1_label {-5.090 2.358 12.507}
echo bva 0.277
color echo black
font echo 18

# ---- Site 2: tpv (RMSD 0.468 A) ----
