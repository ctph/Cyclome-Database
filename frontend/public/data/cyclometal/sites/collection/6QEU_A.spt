# 6QEU_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.233 A | donors A:PHE46:O;A:HIS47:ND1;A:LEU68:O;A:HIS47:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "6QEU_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.233 A) ----
select (resno=46 or resno=47 or resno=68) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=46 or resno=47 or resno=68) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {8.112 -5.057 0.050} color red
draw site1_b1 width 0.06 line {8.112 -5.057 0.050} (chain='A' and resno=46 and atomname='O') color red
draw site1_b2 width 0.06 line {8.112 -5.057 0.050} (chain='A' and resno=47 and atomname='ND1') color red
draw site1_b3 width 0.06 line {8.112 -5.057 0.050} (chain='A' and resno=68 and atomname='O') color red
draw site1_b4 width 0.06 line {8.112 -5.057 0.050} (chain='A' and resno=47 and atomname='O') color red
set echo site1_label {8.112 -5.057 0.050}
echo bva 0.233
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
