# 1ES7_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.304 A | donors B:ASP266:OD1;B:GLU270:OE2;B:GLU265:OE1;B:GLU265:O | metals: cobalt,copper,manganese,nickel

load "1ES7_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.304 A) ----
select (resno=265 or resno=266 or resno=270) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=265 or resno=266 or resno=270) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-10.244 55.204 50.287} color red
draw site1_b1 width 0.06 line {-10.244 55.204 50.287} (chain='B' and resno=266 and atomname='OD1') color red
draw site1_b2 width 0.06 line {-10.244 55.204 50.287} (chain='B' and resno=270 and atomname='OE2') color red
draw site1_b3 width 0.06 line {-10.244 55.204 50.287} (chain='B' and resno=265 and atomname='OE1') color red
draw site1_b4 width 0.06 line {-10.244 55.204 50.287} (chain='B' and resno=265 and atomname='O') color red
set echo site1_label {-10.244 55.204 50.287}
echo bvp 0.304
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
