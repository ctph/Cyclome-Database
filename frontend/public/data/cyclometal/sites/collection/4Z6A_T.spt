# 4Z6A_T: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.190 A | donors T:PRO206:O;T:SER205:OG;T:SER188:OG;T:SER205:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bvp RMSD 0.234 A | donors T:ASN171:O;T:LEU151:O;T:LYS149:O;T:ASN171:OD1 | metals: cobalt,copper,manganese,nickel

load "4Z6A_T.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.190 A) ----
select (resno=188 or resno=205 or resno=206) and chain='T'
wireframe 0.18
color wireframe cpk
select (resno=188 or resno=205 or resno=206) and chain='T' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.073 -13.968 -14.080} color red
draw site1_b1 width 0.06 line {-0.073 -13.968 -14.080} (chain='T' and resno=206 and atomname='O') color red
draw site1_b2 width 0.06 line {-0.073 -13.968 -14.080} (chain='T' and resno=205 and atomname='OG') color red
draw site1_b3 width 0.06 line {-0.073 -13.968 -14.080} (chain='T' and resno=188 and atomname='OG') color red
draw site1_b4 width 0.06 line {-0.073 -13.968 -14.080} (chain='T' and resno=205 and atomname='O') color red
set echo site1_label {-0.073 -13.968 -14.080}
echo pyv 0.190
color echo black
font echo 18

# ---- Site 2: bvp (RMSD 0.234 A) ----
select (resno=149 or resno=151 or resno=171) and chain='T'
wireframe 0.18
color wireframe cpk
select (resno=149 or resno=151 or resno=171) and chain='T' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-13.873 -4.586 -3.910} color blue
draw site2_b1 width 0.06 line {-13.873 -4.586 -3.910} (chain='T' and resno=171 and atomname='O') color blue
draw site2_b2 width 0.06 line {-13.873 -4.586 -3.910} (chain='T' and resno=151 and atomname='O') color blue
draw site2_b3 width 0.06 line {-13.873 -4.586 -3.910} (chain='T' and resno=149 and atomname='O') color blue
draw site2_b4 width 0.06 line {-13.873 -4.586 -3.910} (chain='T' and resno=171 and atomname='OD1') color blue
set echo site2_label {-13.873 -4.586 -3.910}
echo bvp 0.234
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
