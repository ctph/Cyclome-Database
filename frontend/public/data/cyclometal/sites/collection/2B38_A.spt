# 2B38_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.375 A | donors A:THR16:OG1;A:LYS25:O;A:ASP26:OD1;A:ASP26:O | metals: cobalt,copper,manganese,nickel

load "2B38_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.375 A) ----
select (resno=16 or resno=25 or resno=26) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=16 or resno=25 or resno=26) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {4.772 5.512 6.069} color red
draw site1_b1 width 0.06 line {4.772 5.512 6.069} (chain='A' and resno=16 and atomname='OG1') color red
draw site1_b2 width 0.06 line {4.772 5.512 6.069} (chain='A' and resno=25 and atomname='O') color red
draw site1_b3 width 0.06 line {4.772 5.512 6.069} (chain='A' and resno=26 and atomname='OD1') color red
draw site1_b4 width 0.06 line {4.772 5.512 6.069} (chain='A' and resno=26 and atomname='O') color red
set echo site1_label {4.772 5.512 6.069}
echo pyv 0.375
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
