# 2H5F_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.275 A | donors B:HIS31:O;B:PRO6:O;B:MET32:SD;B:LEU28:O | metals: cobalt,copper,europium,manganese,nickel

load "2H5F_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.275 A) ----
select (resno=6 or resno=28 or resno=31 or resno=32) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=28 or resno=31 or resno=32) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {70.776 4.585 2.744} color red
draw site1_b1 width 0.06 line {70.776 4.585 2.744} (chain='B' and resno=31 and atomname='O') color red
draw site1_b2 width 0.06 line {70.776 4.585 2.744} (chain='B' and resno=6 and atomname='O') color red
draw site1_b3 width 0.06 line {70.776 4.585 2.744} (chain='B' and resno=32 and atomname='SD') color red
draw site1_b4 width 0.06 line {70.776 4.585 2.744} (chain='B' and resno=28 and atomname='O') color red
set echo site1_label {70.776 4.585 2.744}
echo spl 0.275
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
