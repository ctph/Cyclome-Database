# Site 1 (red): tet RMSD 0.470 A | donors A:CYS10:O;A:MET8:O;A:CYS6:O;A:PRO7:O | metals: cobalt,copper,manganese,nickel,samarium

load "1DU9_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.470 A) ----
select (resno=6 or resno=7 or resno=8 or resno=10) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=7 or resno=8 or resno=10) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.804 -1.273 5.958} color red
draw site1_b1 width 0.06 line {0.804 -1.273 5.958} (chain='A' and resno=10 and atomname='O') color red
draw site1_b2 width 0.06 line {0.804 -1.273 5.958} (chain='A' and resno=8 and atomname='O') color red
draw site1_b3 width 0.06 line {0.804 -1.273 5.958} (chain='A' and resno=6 and atomname='O') color red
draw site1_b4 width 0.06 line {0.804 -1.273 5.958} (chain='A' and resno=7 and atomname='O') color red
set echo site1_label {0.804 -1.273 5.958}
echo tet 0.470
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
