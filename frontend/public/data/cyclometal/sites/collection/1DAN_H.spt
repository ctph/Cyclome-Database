# 1DAN_H: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.071 A | donors H:GLU70:OE1;H:GLU75:O;H:GLU80:OE2;H:ASP72:O | metals: cobalt,copper,europium,manganese,nickel
# Site 2 (blue): spl RMSD 0.421 A | donors H:THR49:O;H:LEU108:O;H:ILE50:O;H:GLN110:O | metals: cobalt,copper,europium,manganese,nickel

load "1DAN_H.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.071 A) ----
select (resno=70 or resno=72 or resno=75 or resno=80) and chain='H'
wireframe 0.18
color wireframe cpk
select (resno=70 or resno=72 or resno=75 or resno=80) and chain='H' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {7.537 7.071 4.873} color red
draw site1_b1 width 0.06 line {7.537 7.071 4.873} (chain='H' and resno=70 and atomname='OE1') color red
draw site1_b2 width 0.06 line {7.537 7.071 4.873} (chain='H' and resno=75 and atomname='O') color red
draw site1_b3 width 0.06 line {7.537 7.071 4.873} (chain='H' and resno=80 and atomname='OE2') color red
draw site1_b4 width 0.06 line {7.537 7.071 4.873} (chain='H' and resno=72 and atomname='O') color red
set echo site1_label {7.537 7.071 4.873}
echo spl 0.071
color echo black
font echo 18

# ---- Site 2: spl (RMSD 0.421 A) ----
select (resno=49 or resno=50 or resno=108 or resno=110) and chain='H'
wireframe 0.18
color wireframe cpk
select (resno=49 or resno=50 or resno=108 or resno=110) and chain='H' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {14.118 25.302 1.061} color blue
draw site2_b1 width 0.06 line {14.118 25.302 1.061} (chain='H' and resno=49 and atomname='O') color blue
draw site2_b2 width 0.06 line {14.118 25.302 1.061} (chain='H' and resno=108 and atomname='O') color blue
draw site2_b3 width 0.06 line {14.118 25.302 1.061} (chain='H' and resno=50 and atomname='O') color blue
draw site2_b4 width 0.06 line {14.118 25.302 1.061} (chain='H' and resno=110 and atomname='O') color blue
set echo site2_label {14.118 25.302 1.061}
echo spl 0.421
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
