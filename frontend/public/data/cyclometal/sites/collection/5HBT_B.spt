# 5HBT_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.313 A | donors B:ILE131:O;B:THR133:OG1;B:HIS134:O;B:GLU139:OE1 | metals: cobalt,copper,manganese,nickel,samarium

load "5HBT_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.313 A) ----
select (resno=131 or resno=133 or resno=134 or resno=139) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=131 or resno=133 or resno=134 or resno=139) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {17.773 0.355 -17.715} color red
draw site1_b1 width 0.06 line {17.773 0.355 -17.715} (chain='B' and resno=131 and atomname='O') color red
draw site1_b2 width 0.06 line {17.773 0.355 -17.715} (chain='B' and resno=133 and atomname='OG1') color red
draw site1_b3 width 0.06 line {17.773 0.355 -17.715} (chain='B' and resno=134 and atomname='O') color red
draw site1_b4 width 0.06 line {17.773 0.355 -17.715} (chain='B' and resno=139 and atomname='OE1') color red
set echo site1_label {17.773 0.355 -17.715}
echo tet 0.313
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
