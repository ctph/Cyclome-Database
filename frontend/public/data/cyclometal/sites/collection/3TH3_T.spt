load "3TH3_T.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.221 A) ----
select (resno=187 or resno=188 or resno=205 or resno=206) and chain='T'
