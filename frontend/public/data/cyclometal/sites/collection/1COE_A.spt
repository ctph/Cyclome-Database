# 1COE_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.350 A | donors A:SER9:O;A:THR11:O;A:ASN5:O;A:GLN7:O | metals: cobalt,copper,manganese,nickel

load "1COE_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.350 A) ----
select (resno=5 or resno=7 or resno=9 or resno=11) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=7 or resno=9 or resno=11) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-2.847 -9.004 -4.589} color red
draw site1_b1 width 0.06 line {-2.847 -9.004 -4.589} (chain='A' and resno=9 and atomname='O') color red
draw site1_b2 width 0.06 line {-2.847 -9.004 -4.589} (chain='A' and resno=11 and atomname='O') color red
draw site1_b3 width 0.06 line {-2.847 -9.004 -4.589} (chain='A' and resno=5 and atomname='O') color red
draw site1_b4 width 0.06 line {-2.847 -9.004 -4.589} (chain='A' and resno=7 and atomname='O') color red
set echo site1_label {-2.847 -9.004 -4.589}
echo pyv 0.350
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
