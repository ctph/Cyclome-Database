load "1DAN_T.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.303 A) ----
select (resno=54 or resno=55 or resno=56) and chain='T'
