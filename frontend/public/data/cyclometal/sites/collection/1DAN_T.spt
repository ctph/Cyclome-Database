color wireframe red
draw site1_center sphere diameter 1.4 {38.773 30.692 48.975} color red
draw site1_b1 width 0.06 line {38.773 30.692 48.975} (chain='T' and resno=55 and atomname='OG1') color red
draw site1_b2 width 0.06 line {38.773 30.692 48.975} (chain='T' and resno=56 and atomname='OE1') color red
