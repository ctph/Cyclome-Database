# 1VB8_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.327 A | donors A:SER19:OG;A:TYR26:O;A:SER21:OG;A:SER19:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.420 A | donors A:CYS10:O;A:THR13:OG1;A:THR13:O;A:CYS18:O | metals: cobalt,copper,manganese,nickel

load "1VB8_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.327 A) ----
select (resno=19 or resno=21 or resno=26) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=19 or resno=21 or resno=26) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.211 6.393 1.682} color red
draw site1_b1 width 0.06 line {-0.211 6.393 1.682} (chain='A' and resno=19 and atomname='OG') color red
draw site1_b2 width 0.06 line {-0.211 6.393 1.682} (chain='A' and resno=26 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.211 6.393 1.682} (chain='A' and resno=21 and atomname='OG') color red
draw site1_b4 width 0.06 line {-0.211 6.393 1.682} (chain='A' and resno=19 and atomname='O') color red
set echo site1_label {-0.211 6.393 1.682}
echo pyv 0.327
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.420 A) ----
select (resno=10 or resno=13 or resno=18) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=10 or resno=13 or resno=18) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {2.139 -1.314 4.643} color blue
draw site2_b1 width 0.06 line {2.139 -1.314 4.643} (chain='A' and resno=10 and atomname='O') color blue
draw site2_b2 width 0.06 line {2.139 -1.314 4.643} (chain='A' and resno=13 and atomname='OG1') color blue
draw site2_b3 width 0.06 line {2.139 -1.314 4.643} (chain='A' and resno=13 and atomname='O') color blue
draw site2_b4 width 0.06 line {2.139 -1.314 4.643} (chain='A' and resno=18 and atomname='O') color blue
set echo site2_label {2.139 -1.314 4.643}
echo pyv 0.420
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
