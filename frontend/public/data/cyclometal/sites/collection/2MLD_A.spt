# 2MLD_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.475 A | donors A:LYS31:O;A:VAL5:O;A:ASN29:O;A:CYS7:O | metals: cobalt,copper,manganese,nickel,samarium

load "2MLD_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.475 A) ----
select (resno=5 or resno=7 or resno=29 or resno=31) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=7 or resno=29 or resno=31) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {7.807 -3.188 -2.226} color red
draw site1_b1 width 0.06 line {7.807 -3.188 -2.226} (chain='A' and resno=31 and atomname='O') color red
draw site1_b2 width 0.06 line {7.807 -3.188 -2.226} (chain='A' and resno=5 and atomname='O') color red
draw site1_b3 width 0.06 line {7.807 -3.188 -2.226} (chain='A' and resno=29 and atomname='O') color red
draw site1_b4 width 0.06 line {7.807 -3.188 -2.226} (chain='A' and resno=7 and atomname='O') color red
set echo site1_label {7.807 -3.188 -2.226}
echo tet 0.475
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
