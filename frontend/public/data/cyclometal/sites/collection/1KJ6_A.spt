load "1KJ6_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.324 A) ----
select (resno=4 or resno=5 or resno=7) and chain='A'
