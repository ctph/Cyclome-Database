draw site1_center sphere diameter 1.4 {11.964 1.609 6.155} color red
draw site1_b1 width 0.06 line {11.964 1.609 6.155} (chain='A' and resno=4 and atomname='OD1') color red
draw site1_b2 width 0.06 line {11.964 1.609 6.155} (chain='A' and resno=5 and atomname='O') color red
