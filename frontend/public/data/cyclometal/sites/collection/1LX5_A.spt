# 1LX5_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.282 A | donors A:SER46:OG;A:GLU60:O;A:TYR44:OH;A:VAL45:O | metals: cobalt,copper,manganese,nickel

load "1LX5_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.282 A) ----
select (resno=44 or resno=45 or resno=46 or resno=60) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=44 or resno=45 or resno=46 or resno=60) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {95.750 33.461 42.548} color red
draw site1_b1 width 0.06 line {95.750 33.461 42.548} (chain='A' and resno=46 and atomname='OG') color red
draw site1_b2 width 0.06 line {95.750 33.461 42.548} (chain='A' and resno=60 and atomname='O') color red
draw site1_b3 width 0.06 line {95.750 33.461 42.548} (chain='A' and resno=44 and atomname='OH') color red
draw site1_b4 width 0.06 line {95.750 33.461 42.548} (chain='A' and resno=45 and atomname='O') color red
set echo site1_label {95.750 33.461 42.548}
echo pyv 0.282
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
