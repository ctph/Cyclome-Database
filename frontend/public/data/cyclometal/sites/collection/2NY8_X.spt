# Site 1 (red): pyv RMSD 0.465 A | donors X:TYR29:O;X:ASN31:O;X:CYS3:O;X:VAL35:O | metals: cobalt,copper,manganese,nickel

load "2NY8_X.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.465 A) ----
select (resno=3 or resno=29 or resno=31 or resno=35) and chain='X'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=29 or resno=31 or resno=35) and chain='X' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-3.534 0.734 -0.675} color red
draw site1_b1 width 0.06 line {-3.534 0.734 -0.675} (chain='X' and resno=29 and atomname='O') color red
draw site1_b2 width 0.06 line {-3.534 0.734 -0.675} (chain='X' and resno=31 and atomname='O') color red
draw site1_b3 width 0.06 line {-3.534 0.734 -0.675} (chain='X' and resno=3 and atomname='O') color red
draw site1_b4 width 0.06 line {-3.534 0.734 -0.675} (chain='X' and resno=35 and atomname='O') color red
set echo site1_label {-3.534 0.734 -0.675}
echo pyv 0.465
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
