# Site 1 (red): bvp RMSD 0.311 A | donors A:GLY19:O;A:THR12:O;A:LYS11:O;A:GLN23:OE1 | metals: cobalt,copper,manganese,nickel

load "1CW5_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.311 A) ----
select (resno=11 or resno=12 or resno=19 or resno=23) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=12 or resno=19 or resno=23) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-1.939 1.442 -0.824} color red
draw site1_b1 width 0.06 line {-1.939 1.442 -0.824} (chain='A' and resno=19 and atomname='O') color red
draw site1_b2 width 0.06 line {-1.939 1.442 -0.824} (chain='A' and resno=12 and atomname='O') color red
draw site1_b3 width 0.06 line {-1.939 1.442 -0.824} (chain='A' and resno=11 and atomname='O') color red
draw site1_b4 width 0.06 line {-1.939 1.442 -0.824} (chain='A' and resno=23 and atomname='OE1') color red
set echo site1_label {-1.939 1.442 -0.824}
