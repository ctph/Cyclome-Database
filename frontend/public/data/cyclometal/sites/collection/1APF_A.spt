# 1APF_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.385 A | donors A:CYS4:O;A:ASN16:OD1;A:PRO3:O;A:THR17:O | metals: cobalt,copper,europium,manganese,nickel

load "1APF_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.385 A) ----
select (resno=3 or resno=4 or resno=16 or resno=17) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=4 or resno=16 or resno=17) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {32.387 7.950 3.106} color red
draw site1_b1 width 0.06 line {32.387 7.950 3.106} (chain='A' and resno=4 and atomname='O') color red
draw site1_b2 width 0.06 line {32.387 7.950 3.106} (chain='A' and resno=16 and atomname='OD1') color red
draw site1_b3 width 0.06 line {32.387 7.950 3.106} (chain='A' and resno=3 and atomname='O') color red
draw site1_b4 width 0.06 line {32.387 7.950 3.106} (chain='A' and resno=17 and atomname='O') color red
set echo site1_label {32.387 7.950 3.106}
echo spl 0.385
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
