# Site 1 (red): bva RMSD 0.287 A | donors A:PRO5:O;A:ARG15:O;A:CYS20:O;A:GLU18:OE1 | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1RMR_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.287 A) ----
select (resno=5 or resno=15 or resno=18 or resno=20) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=15 or resno=18 or resno=20) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {82.846 3.214 18.672} color red
draw site1_b1 width 0.06 line {82.846 3.214 18.672} (chain='A' and resno=5 and atomname='O') color red
draw site1_b2 width 0.06 line {82.846 3.214 18.672} (chain='A' and resno=15 and atomname='O') color red
draw site1_b3 width 0.06 line {82.846 3.214 18.672} (chain='A' and resno=20 and atomname='O') color red
draw site1_b4 width 0.06 line {82.846 3.214 18.672} (chain='A' and resno=18 and atomname='OE1') color red
set echo site1_label {82.846 3.214 18.672}
echo bva 0.287
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
