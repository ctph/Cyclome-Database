load "1NYS_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.231 A) ----
select (resno=94 or resno=95 or resno=115 or resno=116) and chain='A'
