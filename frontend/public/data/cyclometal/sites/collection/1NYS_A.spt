color wireframe red
draw site1_center sphere diameter 1.4 {80.463 32.449 -22.733} color red
draw site1_b1 width 0.06 line {80.463 32.449 -22.733} (chain='A' and resno=116 and atomname='O') color red
draw site1_b2 width 0.06 line {80.463 32.449 -22.733} (chain='A' and resno=94 and atomname='O') color red
draw site1_b3 width 0.06 line {80.463 32.449 -22.733} (chain='A' and resno=95 and atomname='O') color red
