# 1PQR_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.391 A | donors A:CYS24:O;A:TYR23:O;A:ARG26:O;A:SER28:OG | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): tet RMSD 0.444 A | donors A:ARG26:O;A:TYR23:O;A:SER28:OG;A:CYS24:O | metals: cobalt,copper,manganese,nickel,samarium

load "1PQR_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.391 A) ----
select (resno=23 or resno=24 or resno=26 or resno=28) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=23 or resno=24 or resno=26 or resno=28) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-1.140 7.819 -3.569} color red
draw site1_b1 width 0.06 line {-1.140 7.819 -3.569} (chain='A' and resno=24 and atomname='O') color red
draw site1_b2 width 0.06 line {-1.140 7.819 -3.569} (chain='A' and resno=23 and atomname='O') color red
draw site1_b3 width 0.06 line {-1.140 7.819 -3.569} (chain='A' and resno=26 and atomname='O') color red
draw site1_b4 width 0.06 line {-1.140 7.819 -3.569} (chain='A' and resno=28 and atomname='OG') color red
set echo site1_label {-1.140 7.819 -3.569}
echo bva 0.391
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.444 A) ----
select (resno=23 or resno=24 or resno=26 or resno=28) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=23 or resno=24 or resno=26 or resno=28) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-1.525 7.893 -3.140} color blue
draw site2_b1 width 0.06 line {-1.525 7.893 -3.140} (chain='A' and resno=26 and atomname='O') color blue
draw site2_b2 width 0.06 line {-1.525 7.893 -3.140} (chain='A' and resno=23 and atomname='O') color blue
draw site2_b3 width 0.06 line {-1.525 7.893 -3.140} (chain='A' and resno=28 and atomname='OG') color blue
draw site2_b4 width 0.06 line {-1.525 7.893 -3.140} (chain='A' and resno=24 and atomname='O') color blue
set echo site2_label {-1.525 7.893 -3.140}
echo tet 0.444
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
