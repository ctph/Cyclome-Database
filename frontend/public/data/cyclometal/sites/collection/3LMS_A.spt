# 3LMS_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.187 A | donors A:ASP255:OD2;A:TYR192:O;A:SER194:O;A:TYR192:OH | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): pyv RMSD 0.209 A | donors A:THR236:OG1;A:SER234:OG;A:ILE230:O;A:SER234:O | metals: cobalt,copper,manganese,nickel
# Site 3 (green): spy RMSD 0.378 A | donors A:SER234:OG;A:SER234:O;A:THR236:OG1;A:ILE230:O;A:THR236:O | metals: cobalt,copper,europium,gadolinium,holmium,manganese,nickel,praseodymium,samarium,terbium,ytterbium

load "3LMS_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.187 A) ----
select (resno=192 or resno=194 or resno=255) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=192 or resno=194 or resno=255) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {23.012 80.052 32.512} color red
draw site1_b1 width 0.06 line {23.012 80.052 32.512} (chain='A' and resno=255 and atomname='OD2') color red
draw site1_b2 width 0.06 line {23.012 80.052 32.512} (chain='A' and resno=192 and atomname='O') color red
draw site1_b3 width 0.06 line {23.012 80.052 32.512} (chain='A' and resno=194 and atomname='O') color red
draw site1_b4 width 0.06 line {23.012 80.052 32.512} (chain='A' and resno=192 and atomname='OH') color red
set echo site1_label {23.012 80.052 32.512}
echo tet 0.187
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.209 A) ----
select (resno=230 or resno=234 or resno=236) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=230 or resno=234 or resno=236) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {30.220 63.260 41.285} color blue
draw site2_b1 width 0.06 line {30.220 63.260 41.285} (chain='A' and resno=236 and atomname='OG1') color blue
draw site2_b2 width 0.06 line {30.220 63.260 41.285} (chain='A' and resno=234 and atomname='OG') color blue
draw site2_b3 width 0.06 line {30.220 63.260 41.285} (chain='A' and resno=230 and atomname='O') color blue
draw site2_b4 width 0.06 line {30.220 63.260 41.285} (chain='A' and resno=234 and atomname='O') color blue
set echo site2_label {30.220 63.260 41.285}
echo pyv 0.209
color echo black
font echo 18

# ---- Site 3: spy (RMSD 0.378 A) ----
select (resno=230 or resno=234 or resno=236) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=230 or resno=234 or resno=236) and chain='A' and carbon
color wireframe green
draw site3_center sphere diameter 1.4 {30.062 63.100 41.264} color green
draw site3_b1 width 0.06 line {30.062 63.100 41.264} (chain='A' and resno=234 and atomname='OG') color green
draw site3_b2 width 0.06 line {30.062 63.100 41.264} (chain='A' and resno=234 and atomname='O') color green
draw site3_b3 width 0.06 line {30.062 63.100 41.264} (chain='A' and resno=236 and atomname='OG1') color green
draw site3_b4 width 0.06 line {30.062 63.100 41.264} (chain='A' and resno=230 and atomname='O') color green
draw site3_b5 width 0.06 line {30.062 63.100 41.264} (chain='A' and resno=236 and atomname='O') color green
set echo site3_label {30.062 63.100 41.264}
echo spy 0.378
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
