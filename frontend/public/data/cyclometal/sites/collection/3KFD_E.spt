color wireframe cpk
select (resno=68 or resno=69 or resno=107) and chain='E' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-47.170 -55.204 36.036} color red
draw site1_b1 width 0.06 line {-47.170 -55.204 36.036} (chain='E' and resno=107 and atomname='O') color red
draw site1_b2 width 0.06 line {-47.170 -55.204 36.036} (chain='E' and resno=68 and atomname='O') color red
draw site1_b3 width 0.06 line {-47.170 -55.204 36.036} (chain='E' and resno=68 and atomname='OD1') color red
draw site1_b4 width 0.06 line {-47.170 -55.204 36.036} (chain='E' and resno=69 and atomname='OD1') color red
set echo site1_label {-47.170 -55.204 36.036}
echo tet 0.327
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
