# Site 1 (red): tet RMSD 0.327 A | donors E:GLY107:O;E:ASN68:O;E:ASN68:OD1;E:ASP69:OD1 | metals: cobalt,copper,manganese,nickel,samarium

load "3KFD_E.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.327 A) ----
select (resno=68 or resno=69 or resno=107) and chain='E'
