# 2PUQ_T: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.233 A | donors T:SER77:OG;T:VAL75:O;T:TYR94:O;T:LEU93:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.295 A | donors T:ASN199:O;T:THR106:O;T:LEU104:O;T:ASN199:OD1 | metals: cobalt,copper,manganese,nickel,samarium

load "2PUQ_T.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.233 A) ----
select (resno=75 or resno=77 or resno=93 or resno=94) and chain='T'
wireframe 0.18
color wireframe cpk
select (resno=75 or resno=77 or resno=93 or resno=94) and chain='T' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-41.673 1.818 -1.511} color red
draw site1_b1 width 0.06 line {-41.673 1.818 -1.511} (chain='T' and resno=77 and atomname='OG') color red
draw site1_b2 width 0.06 line {-41.673 1.818 -1.511} (chain='T' and resno=75 and atomname='O') color red
draw site1_b3 width 0.06 line {-41.673 1.818 -1.511} (chain='T' and resno=94 and atomname='O') color red
draw site1_b4 width 0.06 line {-41.673 1.818 -1.511} (chain='T' and resno=93 and atomname='O') color red
set echo site1_label {-41.673 1.818 -1.511}
echo pyv 0.233
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.295 A) ----
select (resno=104 or resno=106 or resno=199) and chain='T'
wireframe 0.18
color wireframe cpk
select (resno=104 or resno=106 or resno=199) and chain='T' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-41.937 15.871 21.968} color blue
draw site2_b1 width 0.06 line {-41.937 15.871 21.968} (chain='T' and resno=199 and atomname='O') color blue
draw site2_b2 width 0.06 line {-41.937 15.871 21.968} (chain='T' and resno=106 and atomname='O') color blue
draw site2_b3 width 0.06 line {-41.937 15.871 21.968} (chain='T' and resno=104 and atomname='O') color blue
draw site2_b4 width 0.06 line {-41.937 15.871 21.968} (chain='T' and resno=199 and atomname='OD1') color blue
set echo site2_label {-41.937 15.871 21.968}
echo tet 0.295
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
