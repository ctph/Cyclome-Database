# Site 1 (red): pyv RMSD 0.364 A | donors A:LEU12:O;A:ASP13:OD1;A:GLN10:O;A:PHE9:O | metals: cobalt,copper,manganese,nickel

load "2N8E_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.364 A) ----
select (resno=9 or resno=10 or resno=12 or resno=13) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=9 or resno=10 or resno=12 or resno=13) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.551 -7.274 -4.677} color red
draw site1_b1 width 0.06 line {-5.551 -7.274 -4.677} (chain='A' and resno=12 and atomname='O') color red
draw site1_b2 width 0.06 line {-5.551 -7.274 -4.677} (chain='A' and resno=13 and atomname='OD1') color red
draw site1_b3 width 0.06 line {-5.551 -7.274 -4.677} (chain='A' and resno=10 and atomname='O') color red
draw site1_b4 width 0.06 line {-5.551 -7.274 -4.677} (chain='A' and resno=9 and atomname='O') color red
set echo site1_label {-5.551 -7.274 -4.677}
echo pyv 0.364
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
