# 3C5T_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.331 A | donors A:TYR69:OH;A:LEU123:O;A:GLU127:OE1;A:CYS126:O | metals: cobalt,copper,manganese,nickel

load "3C5T_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.331 A) ----
select (resno=69 or resno=123 or resno=126 or resno=127) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=69 or resno=123 or resno=126 or resno=127) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-35.330 15.011 -0.594} color red
draw site1_b1 width 0.06 line {-35.330 15.011 -0.594} (chain='A' and resno=69 and atomname='OH') color red
draw site1_b2 width 0.06 line {-35.330 15.011 -0.594} (chain='A' and resno=123 and atomname='O') color red
draw site1_b3 width 0.06 line {-35.330 15.011 -0.594} (chain='A' and resno=127 and atomname='OE1') color red
draw site1_b4 width 0.06 line {-35.330 15.011 -0.594} (chain='A' and resno=126 and atomname='O') color red
set echo site1_label {-35.330 15.011 -0.594}
echo pyv 0.331
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
