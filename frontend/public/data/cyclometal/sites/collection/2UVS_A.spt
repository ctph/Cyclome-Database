# 2UVS_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 4 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.292 A | donors A:CYS33:O;A:LYS32:O;A:CYS28:O;A:LYS27:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.307 A | donors A:HIS34:ND1;A:LYS27:O;A:LYS32:O;A:CYS28:O | metals: cobalt,copper,manganese,nickel
# Site 3 (green): pyv RMSD 0.319 A | donors A:LYS32:O;A:LYS27:O;A:HIS34:ND1;A:CYS33:O | metals: cobalt,copper,manganese,nickel
# Site 4 (orange): spy RMSD 0.385 A | donors A:CYS33:O;A:LYS27:O;A:HIS34:ND1;A:LYS32:O;A:CYS28:O | metals: cobalt,copper,europium,gadolinium,holmium,manganese,nickel,praseodymium,samarium,terbium,ytterbium

load "2UVS_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.292 A) ----
select (resno=27 or resno=28 or resno=32 or resno=33) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=27 or resno=28 or resno=32 or resno=33) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {0.194 -4.949 2.959} color red
draw site1_b1 width 0.06 line {0.194 -4.949 2.959} (chain='A' and resno=33 and atomname='O') color red
draw site1_b2 width 0.06 line {0.194 -4.949 2.959} (chain='A' and resno=32 and atomname='O') color red
draw site1_b3 width 0.06 line {0.194 -4.949 2.959} (chain='A' and resno=28 and atomname='O') color red
draw site1_b4 width 0.06 line {0.194 -4.949 2.959} (chain='A' and resno=27 and atomname='O') color red
set echo site1_label {0.194 -4.949 2.959}
echo pyv 0.292
color echo black
font echo 18

