# 1IGX_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.137 A | donors A:SER353:O;A:SER516:OG;A:GLN192:OE1;A:HIS90:NE2 | metals: cobalt,copper,europium,manganese,nickel
# Site 2 (blue): tet RMSD 0.335 A | donors A:PHE518:O;A:HIS90:NE2;A:ASN515:O;A:LEU352:O | metals: cobalt,copper,manganese,nickel,samarium
# Site 3 (green): tpv RMSD 0.387 A | donors A:SER353:O;A:PHE518:O;A:HIS90:NE2;A:GLN192:OE1;A:SER516:OG | metals: cobalt,copper,manganese

load "1IGX_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.137 A) ----
select (resno=90 or resno=192 or resno=353 or resno=516) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=90 or resno=192 or resno=353 or resno=516) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {254.949 109.411 -47.662} color red
draw site1_b1 width 0.06 line {254.949 109.411 -47.662} (chain='A' and resno=353 and atomname='O') color red
draw site1_b2 width 0.06 line {254.949 109.411 -47.662} (chain='A' and resno=516 and atomname='OG') color red
draw site1_b3 width 0.06 line {254.949 109.411 -47.662} (chain='A' and resno=192 and atomname='OE1') color red
draw site1_b4 width 0.06 line {254.949 109.411 -47.662} (chain='A' and resno=90 and atomname='NE2') color red
set echo site1_label {254.949 109.411 -47.662}
echo spl 0.137
color echo black
font echo 18

