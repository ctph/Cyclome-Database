color wireframe red
draw site1_center sphere diameter 1.4 {-4.450 29.947 6.972} color red
draw site1_b1 width 0.06 line {-4.450 29.947 6.972} (chain='A' and resno=19 and atomname='O') color red
draw site1_b2 width 0.06 line {-4.450 29.947 6.972} (chain='A' and resno=16 and atomname='O') color red
draw site1_b3 width 0.06 line {-4.450 29.947 6.972} (chain='A' and resno=14 and atomname='O') color red
