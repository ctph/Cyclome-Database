load "4R5U_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.228 A) ----
select (resno=8 or resno=14 or resno=16 or resno=19) and chain='A'
