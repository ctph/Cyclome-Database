# 3D4U_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.199 A | donors A:HIS196:O;A:GLU72:OE1;A:GLU72:O;A:SER197:OG | metals: cobalt,copper,manganese,nickel

load "3D4U_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.199 A) ----
select (resno=72 or resno=196 or resno=197) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=72 or resno=196 or resno=197) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {10.929 24.612 88.927} color red
draw site1_b1 width 0.06 line {10.929 24.612 88.927} (chain='A' and resno=196 and atomname='O') color red
draw site1_b2 width 0.06 line {10.929 24.612 88.927} (chain='A' and resno=72 and atomname='OE1') color red
draw site1_b3 width 0.06 line {10.929 24.612 88.927} (chain='A' and resno=72 and atomname='O') color red
draw site1_b4 width 0.06 line {10.929 24.612 88.927} (chain='A' and resno=197 and atomname='OG') color red
set echo site1_label {10.929 24.612 88.927}
echo pyv 0.199
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
