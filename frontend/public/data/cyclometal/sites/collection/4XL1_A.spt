# 4XL1_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.200 A | donors A:GLN470:OE1;A:GLU473:OE2;A:ILE471:O;A:GLU473:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.203 A | donors A:ASP507:OD2;A:ASN490:OD1;A:ASN490:O;A:THR491:O | metals: cobalt,copper,manganese,nickel
# Site 3 (green): tet RMSD 0.329 A | donors A:GLU473:O;A:GLN470:OE1;A:GLU473:OE1;A:PHE474:O | metals: cobalt,copper,manganese,nickel,samarium

load "4XL1_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.200 A) ----
select (resno=470 or resno=471 or resno=473) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=470 or resno=471 or resno=473) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {22.344 8.898 -6.218} color red
draw site1_b1 width 0.06 line {22.344 8.898 -6.218} (chain='A' and resno=470 and atomname='OE1') color red
draw site1_b2 width 0.06 line {22.344 8.898 -6.218} (chain='A' and resno=473 and atomname='OE2') color red
draw site1_b3 width 0.06 line {22.344 8.898 -6.218} (chain='A' and resno=471 and atomname='O') color red
draw site1_b4 width 0.06 line {22.344 8.898 -6.218} (chain='A' and resno=473 and atomname='O') color red
set echo site1_label {22.344 8.898 -6.218}
echo bvp 0.200
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.203 A) ----
select (resno=490 or resno=491 or resno=507) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=490 or resno=491 or resno=507) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {31.203 -14.527 4.830} color blue
draw site2_b1 width 0.06 line {31.203 -14.527 4.830} (chain='A' and resno=507 and atomname='OD2') color blue
draw site2_b2 width 0.06 line {31.203 -14.527 4.830} (chain='A' and resno=490 and atomname='OD1') color blue
draw site2_b3 width 0.06 line {31.203 -14.527 4.830} (chain='A' and resno=490 and atomname='O') color blue
draw site2_b4 width 0.06 line {31.203 -14.527 4.830} (chain='A' and resno=491 and atomname='O') color blue
set echo site2_label {31.203 -14.527 4.830}
echo pyv 0.203
color echo black
font echo 18

# ---- Site 3: tet (RMSD 0.329 A) ----
select (resno=470 or resno=473 or resno=474) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=470 or resno=473 or resno=474) and chain='A' and carbon
color wireframe green
draw site3_center sphere diameter 1.4 {24.217 6.860 -4.665} color green
draw site3_b1 width 0.06 line {24.217 6.860 -4.665} (chain='A' and resno=473 and atomname='O') color green
draw site3_b2 width 0.06 line {24.217 6.860 -4.665} (chain='A' and resno=470 and atomname='OE1') color green
draw site3_b3 width 0.06 line {24.217 6.860 -4.665} (chain='A' and resno=473 and atomname='OE1') color green
draw site3_b4 width 0.06 line {24.217 6.860 -4.665} (chain='A' and resno=474 and atomname='O') color green
set echo site3_label {24.217 6.860 -4.665}
echo tet 0.329
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
