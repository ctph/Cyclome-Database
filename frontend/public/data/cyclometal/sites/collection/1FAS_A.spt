# 1FAS_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.243 A | donors A:THR1:OG1;A:GLY18:O;A:GLU19:O;A:ASN20:O | metals: cobalt,copper,manganese,nickel

load "1FAS_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.243 A) ----
select (resno=1 or resno=18 or resno=19 or resno=20) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=1 or resno=18 or resno=19 or resno=20) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {47.642 17.625 4.938} color red
draw site1_b1 width 0.06 line {47.642 17.625 4.938} (chain='A' and resno=1 and atomname='OG1') color red
draw site1_b2 width 0.06 line {47.642 17.625 4.938} (chain='A' and resno=18 and atomname='O') color red
draw site1_b3 width 0.06 line {47.642 17.625 4.938} (chain='A' and resno=19 and atomname='O') color red
draw site1_b4 width 0.06 line {47.642 17.625 4.938} (chain='A' and resno=20 and atomname='O') color red
set echo site1_label {47.642 17.625 4.938}
echo pyv 0.243
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
