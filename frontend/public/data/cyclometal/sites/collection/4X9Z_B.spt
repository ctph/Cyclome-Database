# 4X9Z_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.211 A | donors B:CYS6:SG;B:CYS18:SG;B:PRO5:O;B:LYS17:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): tet RMSD 0.457 A | donors B:CYS6:SG;B:CYS18:SG;B:LYS17:O;B:GLY16:O | metals: cobalt,copper,manganese,nickel,samarium

load "4X9Z_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.211 A) ----
select (resno=5 or resno=6 or resno=17 or resno=18) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=6 or resno=17 or resno=18) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-6.743 -6.735 15.759} color red
draw site1_b1 width 0.06 line {-6.743 -6.735 15.759} (chain='B' and resno=6 and atomname='SG') color red
draw site1_b2 width 0.06 line {-6.743 -6.735 15.759} (chain='B' and resno=18 and atomname='SG') color red
draw site1_b3 width 0.06 line {-6.743 -6.735 15.759} (chain='B' and resno=5 and atomname='O') color red
draw site1_b4 width 0.06 line {-6.743 -6.735 15.759} (chain='B' and resno=17 and atomname='O') color red
set echo site1_label {-6.743 -6.735 15.759}
echo bva 0.211
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.457 A) ----
select (resno=6 or resno=16 or resno=17 or resno=18) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=6 or resno=16 or resno=17 or resno=18) and chain='B' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-5.753 -8.828 16.023} color blue
draw site2_b1 width 0.06 line {-5.753 -8.828 16.023} (chain='B' and resno=6 and atomname='SG') color blue
draw site2_b2 width 0.06 line {-5.753 -8.828 16.023} (chain='B' and resno=18 and atomname='SG') color blue
draw site2_b3 width 0.06 line {-5.753 -8.828 16.023} (chain='B' and resno=17 and atomname='O') color blue
draw site2_b4 width 0.06 line {-5.753 -8.828 16.023} (chain='B' and resno=16 and atomname='O') color blue
set echo site2_label {-5.753 -8.828 16.023}
echo tet 0.457
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
