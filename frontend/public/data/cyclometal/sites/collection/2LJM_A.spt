# 2LJM_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.202 A | donors A:LEU67:O;A:GLY15:O;A:GLU14:O;A:GLU69:OE2 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bva RMSD 0.244 A | donors A:TYR20:O;A:VAL22:O;A:TYR49:OH;A:VAL72:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2LJM_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.202 A) ----
select (resno=14 or resno=15 or resno=67 or resno=69) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=14 or resno=15 or resno=67 or resno=69) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.608 7.736 19.944} color red
draw site1_b1 width 0.06 line {-5.608 7.736 19.944} (chain='A' and resno=67 and atomname='O') color red
draw site1_b2 width 0.06 line {-5.608 7.736 19.944} (chain='A' and resno=15 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.608 7.736 19.944} (chain='A' and resno=14 and atomname='O') color red
draw site1_b4 width 0.06 line {-5.608 7.736 19.944} (chain='A' and resno=69 and atomname='OE2') color red
set echo site1_label {-5.608 7.736 19.944}
echo bvp 0.202
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.244 A) ----
select (resno=20 or resno=22 or resno=49 or resno=72) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=20 or resno=22 or resno=49 or resno=72) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {2.031 13.151 27.316} color blue
draw site2_b1 width 0.06 line {2.031 13.151 27.316} (chain='A' and resno=20 and atomname='O') color blue
draw site2_b2 width 0.06 line {2.031 13.151 27.316} (chain='A' and resno=22 and atomname='O') color blue
draw site2_b3 width 0.06 line {2.031 13.151 27.316} (chain='A' and resno=49 and atomname='OH') color blue
draw site2_b4 width 0.06 line {2.031 13.151 27.316} (chain='A' and resno=72 and atomname='O') color blue
set echo site2_label {2.031 13.151 27.316}
echo bva 0.244
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
