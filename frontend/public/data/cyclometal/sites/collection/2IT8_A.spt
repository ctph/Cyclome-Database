# 2IT8_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.397 A | donors A:GLY18:O;A:CYS20:O;A:CYS16:O;A:PRO17:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): pyv RMSD 0.403 A | donors A:ASP13:O;A:CYS16:O;A:GLY18:O;A:CYS20:O | metals: cobalt,copper,manganese,nickel

load "2IT8_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.397 A) ----
select (resno=16 or resno=17 or resno=18 or resno=20) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=16 or resno=17 or resno=18 or resno=20) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.708 -0.337 6.084} color red
draw site1_b1 width 0.06 line {-0.708 -0.337 6.084} (chain='A' and resno=18 and atomname='O') color red
draw site1_b2 width 0.06 line {-0.708 -0.337 6.084} (chain='A' and resno=20 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.708 -0.337 6.084} (chain='A' and resno=16 and atomname='O') color red
draw site1_b4 width 0.06 line {-0.708 -0.337 6.084} (chain='A' and resno=17 and atomname='O') color red
set echo site1_label {-0.708 -0.337 6.084}
echo bva 0.397
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.403 A) ----
select (resno=13 or resno=16 or resno=18 or resno=20) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=13 or resno=16 or resno=18 or resno=20) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {0.890 -0.656 6.746} color blue
draw site2_b1 width 0.06 line {0.890 -0.656 6.746} (chain='A' and resno=13 and atomname='O') color blue
draw site2_b2 width 0.06 line {0.890 -0.656 6.746} (chain='A' and resno=16 and atomname='O') color blue
draw site2_b3 width 0.06 line {0.890 -0.656 6.746} (chain='A' and resno=18 and atomname='O') color blue
draw site2_b4 width 0.06 line {0.890 -0.656 6.746} (chain='A' and resno=20 and atomname='O') color blue
set echo site2_label {0.890 -0.656 6.746}
echo pyv 0.403
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
