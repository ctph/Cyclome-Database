# 1PPE_I: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.205 A | donors I:ALA18:O;I:CYS20:O;I:ASP13:O;I:CYS16:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.424 A | donors I:ASP13:O;I:CYS16:O;I:ALA18:O;I:CYS20:O | metals: cobalt,copper,manganese,nickel

load "1PPE_I.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.205 A) ----
select (resno=13 or resno=16 or resno=18 or resno=20) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=13 or resno=16 or resno=18 or resno=20) and chain='I' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-3.551 8.834 5.536} color red
draw site1_b1 width 0.06 line {-3.551 8.834 5.536} (chain='I' and resno=18 and atomname='O') color red
draw site1_b2 width 0.06 line {-3.551 8.834 5.536} (chain='I' and resno=20 and atomname='O') color red
draw site1_b3 width 0.06 line {-3.551 8.834 5.536} (chain='I' and resno=13 and atomname='O') color red
draw site1_b4 width 0.06 line {-3.551 8.834 5.536} (chain='I' and resno=16 and atomname='O') color red
set echo site1_label {-3.551 8.834 5.536}
echo bvp 0.205
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.424 A) ----
select (resno=13 or resno=16 or resno=18 or resno=20) and chain='I'
wireframe 0.18
color wireframe cpk
select (resno=13 or resno=16 or resno=18 or resno=20) and chain='I' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-3.894 8.900 5.543} color blue
draw site2_b1 width 0.06 line {-3.894 8.900 5.543} (chain='I' and resno=13 and atomname='O') color blue
draw site2_b2 width 0.06 line {-3.894 8.900 5.543} (chain='I' and resno=16 and atomname='O') color blue
draw site2_b3 width 0.06 line {-3.894 8.900 5.543} (chain='I' and resno=18 and atomname='O') color blue
draw site2_b4 width 0.06 line {-3.894 8.900 5.543} (chain='I' and resno=20 and atomname='O') color blue
set echo site2_label {-3.894 8.900 5.543}
echo pyv 0.424
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
