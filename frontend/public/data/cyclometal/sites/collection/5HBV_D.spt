# 5HBV_D: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.336 A | donors D:SER70:OG;D:SER68:O;D:LEU80:O;D:PHE79:O | metals: cobalt,copper,manganese,nickel

load "5HBV_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.336 A) ----
select (resno=68 or resno=70 or resno=79 or resno=80) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=68 or resno=70 or resno=79 or resno=80) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {48.127 -14.655 52.122} color red
draw site1_b1 width 0.06 line {48.127 -14.655 52.122} (chain='D' and resno=70 and atomname='OG') color red
draw site1_b2 width 0.06 line {48.127 -14.655 52.122} (chain='D' and resno=68 and atomname='O') color red
draw site1_b3 width 0.06 line {48.127 -14.655 52.122} (chain='D' and resno=80 and atomname='O') color red
draw site1_b4 width 0.06 line {48.127 -14.655 52.122} (chain='D' and resno=79 and atomname='O') color red
set echo site1_label {48.127 -14.655 52.122}
echo pyv 0.336
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
