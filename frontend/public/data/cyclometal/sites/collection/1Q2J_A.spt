# 1Q2J_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.432 A | donors A:CYS22:O;A:CYS15:O;A:ARG16:O;A:SER19:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): tet RMSD 0.479 A | donors A:CYS15:O;A:CYS22:O;A:SER19:O;A:ARG16:O | metals: cobalt,copper,manganese,nickel,samarium

load "1Q2J_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.432 A) ----
select (resno=15 or resno=16 or resno=19 or resno=22) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=15 or resno=16 or resno=19 or resno=22) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {21.932 25.619 18.563} color red
draw site1_b1 width 0.06 line {21.932 25.619 18.563} (chain='A' and resno=22 and atomname='O') color red
draw site1_b2 width 0.06 line {21.932 25.619 18.563} (chain='A' and resno=15 and atomname='O') color red
draw site1_b3 width 0.06 line {21.932 25.619 18.563} (chain='A' and resno=16 and atomname='O') color red
draw site1_b4 width 0.06 line {21.932 25.619 18.563} (chain='A' and resno=19 and atomname='O') color red
set echo site1_label {21.932 25.619 18.563}
echo bva 0.432
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.479 A) ----
select (resno=15 or resno=16 or resno=19 or resno=22) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=15 or resno=16 or resno=19 or resno=22) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {22.469 26.151 18.756} color blue
draw site2_b1 width 0.06 line {22.469 26.151 18.756} (chain='A' and resno=15 and atomname='O') color blue
draw site2_b2 width 0.06 line {22.469 26.151 18.756} (chain='A' and resno=22 and atomname='O') color blue
draw site2_b3 width 0.06 line {22.469 26.151 18.756} (chain='A' and resno=19 and atomname='O') color blue
draw site2_b4 width 0.06 line {22.469 26.151 18.756} (chain='A' and resno=16 and atomname='O') color blue
set echo site2_label {22.469 26.151 18.756}
