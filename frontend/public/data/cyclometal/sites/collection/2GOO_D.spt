# 2GOO_D: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tbp RMSD 0.499 A | donors D:LYS11:O;D:SER13:OG;D:SER12:O;D:GLU46:OE1;D:GLU46:O | metals: cobalt,copper,manganese,nickel

load "2GOO_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tbp (RMSD 0.499 A) ----
select (resno=11 or resno=12 or resno=13 or resno=46) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=11 or resno=12 or resno=13 or resno=46) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-30.768 25.997 20.089} color red
draw site1_b1 width 0.06 line {-30.768 25.997 20.089} (chain='D' and resno=11 and atomname='O') color red
draw site1_b2 width 0.06 line {-30.768 25.997 20.089} (chain='D' and resno=13 and atomname='OG') color red
draw site1_b3 width 0.06 line {-30.768 25.997 20.089} (chain='D' and resno=12 and atomname='O') color red
draw site1_b4 width 0.06 line {-30.768 25.997 20.089} (chain='D' and resno=46 and atomname='OE1') color red
draw site1_b5 width 0.06 line {-30.768 25.997 20.089} (chain='D' and resno=46 and atomname='O') color red
set echo site1_label {-30.768 25.997 20.089}
echo tbp 0.499
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
