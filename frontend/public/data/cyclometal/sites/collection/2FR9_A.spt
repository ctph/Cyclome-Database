# 2FR9_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.465 A | donors A:CYS2:O;A:ASN4:O;A:GLY8:O;A:HIS10:O | metals: cobalt,copper,manganese,nickel

load "2FR9_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.465 A) ----
select (resno=2 or resno=4 or resno=8 or resno=10) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=4 or resno=8 or resno=10) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.676 0.458 -3.031} color red
draw site1_b1 width 0.06 line {1.676 0.458 -3.031} (chain='A' and resno=2 and atomname='O') color red
draw site1_b2 width 0.06 line {1.676 0.458 -3.031} (chain='A' and resno=4 and atomname='O') color red
draw site1_b3 width 0.06 line {1.676 0.458 -3.031} (chain='A' and resno=8 and atomname='O') color red
draw site1_b4 width 0.06 line {1.676 0.458 -3.031} (chain='A' and resno=10 and atomname='O') color red
set echo site1_label {1.676 0.458 -3.031}
echo bvp 0.465
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
