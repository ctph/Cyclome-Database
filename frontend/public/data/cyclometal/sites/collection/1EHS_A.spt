# 1EHS_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.306 A | donors A:ALA44:O;A:VAL43:O;A:GLY47:O;A:CYS48:O | metals: cobalt,copper,manganese,nickel

load "1EHS_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.306 A) ----
select (resno=43 or resno=44 or resno=47 or resno=48) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=43 or resno=44 or resno=47 or resno=48) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {5.954 -8.404 2.780} color red
draw site1_b1 width 0.06 line {5.954 -8.404 2.780} (chain='A' and resno=44 and atomname='O') color red
draw site1_b2 width 0.06 line {5.954 -8.404 2.780} (chain='A' and resno=43 and atomname='O') color red
draw site1_b3 width 0.06 line {5.954 -8.404 2.780} (chain='A' and resno=47 and atomname='O') color red
draw site1_b4 width 0.06 line {5.954 -8.404 2.780} (chain='A' and resno=48 and atomname='O') color red
set echo site1_label {5.954 -8.404 2.780}
echo pyv 0.306
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
