# 4AML_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.314 A | donors A:GLN36:OE1;A:CYS18:O;A:ASN37:OD1;A:GLN36:O | metals: cobalt,copper,manganese,nickel

load "4AML_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.314 A) ----
select (resno=18 or resno=36 or resno=37) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=18 or resno=36 or resno=37) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-18.889 23.086 6.109} color red
draw site1_b1 width 0.06 line {-18.889 23.086 6.109} (chain='A' and resno=36 and atomname='OE1') color red
draw site1_b2 width 0.06 line {-18.889 23.086 6.109} (chain='A' and resno=18 and atomname='O') color red
draw site1_b3 width 0.06 line {-18.889 23.086 6.109} (chain='A' and resno=37 and atomname='OD1') color red
draw site1_b4 width 0.06 line {-18.889 23.086 6.109} (chain='A' and resno=36 and atomname='O') color red
set echo site1_label {-18.889 23.086 6.109}
echo pyv 0.314
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
