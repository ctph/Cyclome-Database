# ---- Site 3: tbp (RMSD 0.395 A) ----
select (resno=729 or resno=732 or resno=734) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=729 or resno=732 or resno=734) and chain='A' and carbon
