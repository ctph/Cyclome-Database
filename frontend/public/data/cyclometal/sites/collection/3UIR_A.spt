draw site2_b1 width 0.06 line {40.538 59.328 47.535} (chain='A' and resno=613 and atomname='O') color blue
draw site2_b2 width 0.06 line {40.538 59.328 47.535} (chain='A' and resno=614 and atomname='O') color blue
draw site2_b3 width 0.06 line {40.538 59.328 47.535} (chain='A' and resno=634 and atomname='OE2') color blue
draw site2_b4 width 0.06 line {40.538 59.328 47.535} (chain='A' and resno=612 and atomname='O') color blue
set echo site2_label {40.538 59.328 47.535}
