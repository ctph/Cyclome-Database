# 3UIR_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.248 A | donors A:ASP646:OD2;A:SER760:O;A:SER741:OG;A:THR759:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.270 A | donors A:SER613:O;A:TYR614:O;A:GLU634:OE2;A:SER612:O | metals: cobalt,copper,manganese,nickel
# Site 3 (green): tbp RMSD 0.395 A | donors A:HIS729:O;A:HIS729:ND1;A:THR734:O;A:GLY732:O;A:THR734:OG1 | metals: cobalt,copper,manganese,nickel

load "3UIR_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.248 A) ----
select (resno=646 or resno=741 or resno=759 or resno=760) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=646 or resno=741 or resno=759 or resno=760) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {49.345 43.851 53.259} color red
draw site1_b1 width 0.06 line {49.345 43.851 53.259} (chain='A' and resno=646 and atomname='OD2') color red
draw site1_b2 width 0.06 line {49.345 43.851 53.259} (chain='A' and resno=760 and atomname='O') color red
draw site1_b3 width 0.06 line {49.345 43.851 53.259} (chain='A' and resno=741 and atomname='OG') color red
draw site1_b4 width 0.06 line {49.345 43.851 53.259} (chain='A' and resno=759 and atomname='O') color red
set echo site1_label {49.345 43.851 53.259}
echo pyv 0.248
color echo black
font echo 18

