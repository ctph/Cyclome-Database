# 2X8B_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.210 A | donors A:TYR449:OH;A:GLU81:O;A:GLU81:OE2;A:SER438:OG | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.239 A | donors A:ALA179:O;A:PHE37:O;A:GLN181:OE1;A:GLU185:OE1 | metals: cobalt,copper,manganese,nickel,samarium

load "2X8B_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.210 A) ----
select (resno=81 or resno=438 or resno=449) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=81 or resno=438 or resno=449) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {130.122 102.249 -132.395} color red
draw site1_b1 width 0.06 line {130.122 102.249 -132.395} (chain='A' and resno=449 and atomname='OH') color red
draw site1_b2 width 0.06 line {130.122 102.249 -132.395} (chain='A' and resno=81 and atomname='O') color red
draw site1_b3 width 0.06 line {130.122 102.249 -132.395} (chain='A' and resno=81 and atomname='OE2') color red
draw site1_b4 width 0.06 line {130.122 102.249 -132.395} (chain='A' and resno=438 and atomname='OG') color red
set echo site1_label {130.122 102.249 -132.395}
echo pyv 0.210
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.239 A) ----
select (resno=37 or resno=179 or resno=181 or resno=185) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=37 or resno=179 or resno=181 or resno=185) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {121.436 114.069 -161.522} color blue
draw site2_b1 width 0.06 line {121.436 114.069 -161.522} (chain='A' and resno=179 and atomname='O') color blue
draw site2_b2 width 0.06 line {121.436 114.069 -161.522} (chain='A' and resno=37 and atomname='O') color blue
draw site2_b3 width 0.06 line {121.436 114.069 -161.522} (chain='A' and resno=181 and atomname='OE1') color blue
draw site2_b4 width 0.06 line {121.436 114.069 -161.522} (chain='A' and resno=185 and atomname='OE1') color blue
set echo site2_label {121.436 114.069 -161.522}
echo tet 0.239
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
