# 7O2K_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.234 A | donors A:LYS5:O;A:ALA10:O;A:ILE7:O;A:ASN4:OD1 | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): bva RMSD 0.307 A | donors A:GLY17:O;A:ASP40:O;A:ASN19:OD1;A:ILE39:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "7O2K_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.234 A) ----
select (resno=4 or resno=5 or resno=7 or resno=10) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=5 or resno=7 or resno=10) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-11.226 -2.680 1.777} color red
draw site1_b1 width 0.06 line {-11.226 -2.680 1.777} (chain='A' and resno=5 and atomname='O') color red
draw site1_b2 width 0.06 line {-11.226 -2.680 1.777} (chain='A' and resno=10 and atomname='O') color red
draw site1_b3 width 0.06 line {-11.226 -2.680 1.777} (chain='A' and resno=7 and atomname='O') color red
draw site1_b4 width 0.06 line {-11.226 -2.680 1.777} (chain='A' and resno=4 and atomname='OD1') color red
set echo site1_label {-11.226 -2.680 1.777}
echo bva 0.234
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.307 A) ----
select (resno=17 or resno=19 or resno=39 or resno=40) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=17 or resno=19 or resno=39 or resno=40) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {2.048 10.971 -1.065} color blue
draw site2_b1 width 0.06 line {2.048 10.971 -1.065} (chain='A' and resno=17 and atomname='O') color blue
draw site2_b2 width 0.06 line {2.048 10.971 -1.065} (chain='A' and resno=40 and atomname='O') color blue
draw site2_b3 width 0.06 line {2.048 10.971 -1.065} (chain='A' and resno=19 and atomname='OD1') color blue
draw site2_b4 width 0.06 line {2.048 10.971 -1.065} (chain='A' and resno=39 and atomname='O') color blue
set echo site2_label {2.048 10.971 -1.065}
