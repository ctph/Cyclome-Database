# 1BUN_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.256 A | donors B:ASN45:OD1;B:GLY44:O;B:HIS4:ND1;B:ASP6:O | metals: cobalt,copper,manganese,nickel

load "1BUN_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.256 A) ----
select (resno=4 or resno=6 or resno=44 or resno=45) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=6 or resno=44 or resno=45) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {54.527 18.355 18.723} color red
draw site1_b1 width 0.06 line {54.527 18.355 18.723} (chain='B' and resno=45 and atomname='OD1') color red
draw site1_b2 width 0.06 line {54.527 18.355 18.723} (chain='B' and resno=44 and atomname='O') color red
draw site1_b3 width 0.06 line {54.527 18.355 18.723} (chain='B' and resno=4 and atomname='ND1') color red
draw site1_b4 width 0.06 line {54.527 18.355 18.723} (chain='B' and resno=6 and atomname='O') color red
set echo site1_label {54.527 18.355 18.723}
echo bvp 0.256
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
