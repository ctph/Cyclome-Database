# 1BAH_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): spl RMSD 0.340 A | donors A:HIS21:O;A:ARG19:O;A:GLN18:O;A:LEU20:O | metals: cobalt,copper,europium,manganese,nickel

load "1BAH_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.340 A) ----
select (resno=18 or resno=19 or resno=20 or resno=21) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=18 or resno=19 or resno=20 or resno=21) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-10.646 -1.520 -3.209} color red
draw site1_b1 width 0.06 line {-10.646 -1.520 -3.209} (chain='A' and resno=21 and atomname='O') color red
draw site1_b2 width 0.06 line {-10.646 -1.520 -3.209} (chain='A' and resno=19 and atomname='O') color red
draw site1_b3 width 0.06 line {-10.646 -1.520 -3.209} (chain='A' and resno=18 and atomname='O') color red
draw site1_b4 width 0.06 line {-10.646 -1.520 -3.209} (chain='A' and resno=20 and atomname='O') color red
set echo site1_label {-10.646 -1.520 -3.209}
echo spl 0.340
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
