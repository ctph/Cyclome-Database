# 2JUR_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.294 A | donors A:CYS8:O;A:CYS3:O;A:GLU5:O;A:CYS2:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2JUR_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.294 A) ----
select (resno=2 or resno=3 or resno=5 or resno=8) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=3 or resno=5 or resno=8) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-0.803 -1.041 -0.985} color red
draw site1_b1 width 0.06 line {-0.803 -1.041 -0.985} (chain='A' and resno=8 and atomname='O') color red
draw site1_b2 width 0.06 line {-0.803 -1.041 -0.985} (chain='A' and resno=3 and atomname='O') color red
draw site1_b3 width 0.06 line {-0.803 -1.041 -0.985} (chain='A' and resno=5 and atomname='O') color red
draw site1_b4 width 0.06 line {-0.803 -1.041 -0.985} (chain='A' and resno=2 and atomname='O') color red
set echo site1_label {-0.803 -1.041 -0.985}
echo bva 0.294
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
