# 3UIR_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.178 A | donors B:HIS729:O;B:THR734:O;B:THR734:OG1;B:GLY732:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.244 A | donors B:ASP646:OD2;B:SER760:O;B:SER741:OG;B:THR759:O | metals: cobalt,copper,manganese,nickel

load "3UIR_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.178 A) ----
select (resno=729 or resno=732 or resno=734) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=729 or resno=732 or resno=734) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {75.146 40.076 4.899} color red
draw site1_b1 width 0.06 line {75.146 40.076 4.899} (chain='B' and resno=729 and atomname='O') color red
draw site1_b2 width 0.06 line {75.146 40.076 4.899} (chain='B' and resno=734 and atomname='O') color red
draw site1_b3 width 0.06 line {75.146 40.076 4.899} (chain='B' and resno=734 and atomname='OG1') color red
draw site1_b4 width 0.06 line {75.146 40.076 4.899} (chain='B' and resno=732 and atomname='O') color red
set echo site1_label {75.146 40.076 4.899}
echo bvp 0.178
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.244 A) ----
select (resno=646 or resno=741 or resno=759 or resno=760) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=646 or resno=741 or resno=759 or resno=760) and chain='B' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {77.464 27.508 18.625} color blue
draw site2_b1 width 0.06 line {77.464 27.508 18.625} (chain='B' and resno=646 and atomname='OD2') color blue
draw site2_b2 width 0.06 line {77.464 27.508 18.625} (chain='B' and resno=760 and atomname='O') color blue
draw site2_b3 width 0.06 line {77.464 27.508 18.625} (chain='B' and resno=741 and atomname='OG') color blue
draw site2_b4 width 0.06 line {77.464 27.508 18.625} (chain='B' and resno=759 and atomname='O') color blue
set echo site2_label {77.464 27.508 18.625}
echo pyv 0.244
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
