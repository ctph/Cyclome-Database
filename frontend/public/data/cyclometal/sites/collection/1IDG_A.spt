draw site3_b1 width 0.06 line {-4.770 5.809 -8.238} (chain='A' and resno=4 and atomname='NE2') color green
draw site3_b2 width 0.06 line {-4.770 5.809 -8.238} (chain='A' and resno=64 and atomname='O') color green
draw site3_b3 width 0.06 line {-4.770 5.809 -8.238} (chain='A' and resno=66 and atomname='O') color green
