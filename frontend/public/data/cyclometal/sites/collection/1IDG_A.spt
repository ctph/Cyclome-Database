# 1IDG_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 3 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.142 A | donors A:LYS64:O;A:ASN66:O;A:HIS4:ND1;A:ASN66:OD1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.402 A | donors A:HIS4:NE2;A:LYS64:O;A:ASN66:O;A:ASN66:OD1 | metals: cobalt,copper,manganese,nickel,samarium
# Site 3 (green): bva RMSD 0.458 A | donors A:HIS4:NE2;A:LYS64:O;A:ASN66:O;A:ASN66:OD1 | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1IDG_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.142 A) ----
select (resno=4 or resno=64 or resno=66) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=64 or resno=66) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.189 6.231 -7.822} color red
draw site1_b1 width 0.06 line {-5.189 6.231 -7.822} (chain='A' and resno=64 and atomname='O') color red
draw site1_b2 width 0.06 line {-5.189 6.231 -7.822} (chain='A' and resno=66 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.189 6.231 -7.822} (chain='A' and resno=4 and atomname='ND1') color red
draw site1_b4 width 0.06 line {-5.189 6.231 -7.822} (chain='A' and resno=66 and atomname='OD1') color red
set echo site1_label {-5.189 6.231 -7.822}
echo pyv 0.142
color echo black
font echo 18

