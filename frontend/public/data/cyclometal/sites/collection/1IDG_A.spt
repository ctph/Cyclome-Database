draw site2_b1 width 0.06 line {-4.573 6.040 -7.479} (chain='A' and resno=4 and atomname='NE2') color blue
draw site2_b2 width 0.06 line {-4.573 6.040 -7.479} (chain='A' and resno=64 and atomname='O') color blue
draw site2_b3 width 0.06 line {-4.573 6.040 -7.479} (chain='A' and resno=66 and atomname='O') color blue
draw site2_b4 width 0.06 line {-4.573 6.040 -7.479} (chain='A' and resno=66 and atomname='OD1') color blue
set echo site2_label {-4.573 6.040 -7.479}
echo tet 0.402
color echo black
