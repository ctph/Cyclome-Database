# ---- Site 3: bva (RMSD 0.458 A) ----
select (resno=4 or resno=64 or resno=66) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=4 or resno=64 or resno=66) and chain='A' and carbon
