load "1GIB_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: spl (RMSD 0.320 A) ----
select (resno=15 or resno=16 or resno=18 or resno=22) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=15 or resno=16 or resno=18 or resno=22) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-11.784 -1.198 -13.749} color red
draw site1_b1 width 0.06 line {-11.784 -1.198 -13.749} (chain='A' and resno=15 and atomname='O') color red
draw site1_b2 width 0.06 line {-11.784 -1.198 -13.749} (chain='A' and resno=22 and atomname='O') color red
draw site1_b3 width 0.06 line {-11.784 -1.198 -13.749} (chain='A' and resno=18 and atomname='O') color red
draw site1_b4 width 0.06 line {-11.784 -1.198 -13.749} (chain='A' and resno=16 and atomname='O') color red
set echo site1_label {-11.784 -1.198 -13.749}
