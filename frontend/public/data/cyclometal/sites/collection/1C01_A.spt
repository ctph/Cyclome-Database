# 1C01_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.231 A | donors A:CYS23:O;A:SER24:O;A:SER71:OG;A:TYR44:OH | metals: cobalt,copper,manganese,nickel

load "1C01_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.231 A) ----
select (resno=23 or resno=24 or resno=44 or resno=71) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=23 or resno=24 or resno=44 or resno=71) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.450 2.939 9.043} color red
draw site1_b1 width 0.06 line {1.450 2.939 9.043} (chain='A' and resno=23 and atomname='O') color red
draw site1_b2 width 0.06 line {1.450 2.939 9.043} (chain='A' and resno=24 and atomname='O') color red
draw site1_b3 width 0.06 line {1.450 2.939 9.043} (chain='A' and resno=71 and atomname='OG') color red
draw site1_b4 width 0.06 line {1.450 2.939 9.043} (chain='A' and resno=44 and atomname='OH') color red
set echo site1_label {1.450 2.939 9.043}
echo pyv 0.231
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
