# 2MD6_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.258 A | donors A:CYS3:O;A:ASP18:OD1;A:PRO14:O;A:ARG10:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): pyv RMSD 0.424 A | donors A:PRO14:O;A:HIS13:NE2;A:CYS3:O;A:ARG10:O | metals: cobalt,copper,manganese,nickel

load "2MD6_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.258 A) ----
select (resno=3 or resno=10 or resno=14 or resno=18) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=10 or resno=14 or resno=18) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {21.157 17.747 18.429} color red
draw site1_b1 width 0.06 line {21.157 17.747 18.429} (chain='A' and resno=3 and atomname='O') color red
draw site1_b2 width 0.06 line {21.157 17.747 18.429} (chain='A' and resno=18 and atomname='OD1') color red
draw site1_b3 width 0.06 line {21.157 17.747 18.429} (chain='A' and resno=14 and atomname='O') color red
draw site1_b4 width 0.06 line {21.157 17.747 18.429} (chain='A' and resno=10 and atomname='O') color red
set echo site1_label {21.157 17.747 18.429}
echo bvp 0.258
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.424 A) ----
select (resno=3 or resno=10 or resno=13 or resno=14) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=3 or resno=10 or resno=13 or resno=14) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {21.098 17.694 18.153} color blue
draw site2_b1 width 0.06 line {21.098 17.694 18.153} (chain='A' and resno=14 and atomname='O') color blue
draw site2_b2 width 0.06 line {21.098 17.694 18.153} (chain='A' and resno=13 and atomname='NE2') color blue
draw site2_b3 width 0.06 line {21.098 17.694 18.153} (chain='A' and resno=3 and atomname='O') color blue
draw site2_b4 width 0.06 line {21.098 17.694 18.153} (chain='A' and resno=10 and atomname='O') color blue
set echo site2_label {21.098 17.694 18.153}
echo pyv 0.424
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
