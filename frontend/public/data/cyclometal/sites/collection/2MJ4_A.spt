# 2MJ4_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.298 A | donors A:CYS23:O;A:THR21:O;A:GLU2:O;A:THR56:OG1 | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): pyv RMSD 0.368 A | donors A:GLN6:OE1;A:PRO11:O;A:ASN5:OD1;A:GLN6:O | metals: cobalt,copper,manganese,nickel

load "2MJ4_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.298 A) ----
select (resno=2 or resno=21 or resno=23 or resno=56) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=21 or resno=23 or resno=56) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-6.703 -8.762 -2.695} color red
draw site1_b1 width 0.06 line {-6.703 -8.762 -2.695} (chain='A' and resno=23 and atomname='O') color red
draw site1_b2 width 0.06 line {-6.703 -8.762 -2.695} (chain='A' and resno=21 and atomname='O') color red
draw site1_b3 width 0.06 line {-6.703 -8.762 -2.695} (chain='A' and resno=2 and atomname='O') color red
draw site1_b4 width 0.06 line {-6.703 -8.762 -2.695} (chain='A' and resno=56 and atomname='OG1') color red
set echo site1_label {-6.703 -8.762 -2.695}
echo tet 0.298
color echo black
font echo 18

# ---- Site 2: pyv (RMSD 0.368 A) ----
select (resno=5 or resno=6 or resno=11) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=6 or resno=11) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {4.818 -5.286 0.494} color blue
draw site2_b1 width 0.06 line {4.818 -5.286 0.494} (chain='A' and resno=6 and atomname='OE1') color blue
draw site2_b2 width 0.06 line {4.818 -5.286 0.494} (chain='A' and resno=11 and atomname='O') color blue
draw site2_b3 width 0.06 line {4.818 -5.286 0.494} (chain='A' and resno=5 and atomname='OD1') color blue
draw site2_b4 width 0.06 line {4.818 -5.286 0.494} (chain='A' and resno=6 and atomname='O') color blue
set echo site2_label {4.818 -5.286 0.494}
echo pyv 0.368
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
