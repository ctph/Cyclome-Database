# 1IMT_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.131 A | donors A:GLU8:O;A:CYS19:O;A:ALA20:O;A:CYS7:O | metals: cobalt,copper,manganese,nickel

load "1IMT_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.131 A) ----
select (resno=7 or resno=8 or resno=19 or resno=20) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=7 or resno=8 or resno=19 or resno=20) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {8.332 -2.253 1.005} color red
draw site1_b1 width 0.06 line {8.332 -2.253 1.005} (chain='A' and resno=8 and atomname='O') color red
draw site1_b2 width 0.06 line {8.332 -2.253 1.005} (chain='A' and resno=19 and atomname='O') color red
draw site1_b3 width 0.06 line {8.332 -2.253 1.005} (chain='A' and resno=20 and atomname='O') color red
draw site1_b4 width 0.06 line {8.332 -2.253 1.005} (chain='A' and resno=7 and atomname='O') color red
set echo site1_label {8.332 -2.253 1.005}
echo bvp 0.131
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
