# 2JQP_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.434 A | donors A:GLY41:O;A:CYS58:O;A:SER45:O;A:ALA43:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2JQP_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.434 A) ----
select (resno=41 or resno=43 or resno=45 or resno=58) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=41 or resno=43 or resno=45 or resno=58) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {9.570 -7.078 1.203} color red
draw site1_b1 width 0.06 line {9.570 -7.078 1.203} (chain='A' and resno=41 and atomname='O') color red
draw site1_b2 width 0.06 line {9.570 -7.078 1.203} (chain='A' and resno=58 and atomname='O') color red
draw site1_b3 width 0.06 line {9.570 -7.078 1.203} (chain='A' and resno=45 and atomname='O') color red
draw site1_b4 width 0.06 line {9.570 -7.078 1.203} (chain='A' and resno=43 and atomname='O') color red
set echo site1_label {9.570 -7.078 1.203}
echo bva 0.434
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
