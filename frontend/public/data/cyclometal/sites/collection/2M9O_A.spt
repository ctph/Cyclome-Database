# 2M9O_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.323 A | donors A:CYS21:O;A:THR20:O;A:THR20:OG1;A:SER22:OG | metals: cobalt,copper,manganese,nickel

load "2M9O_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.323 A) ----
select (resno=20 or resno=21 or resno=22) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=20 or resno=21 or resno=22) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-2.948 3.031 4.130} color red
draw site1_b1 width 0.06 line {-2.948 3.031 4.130} (chain='A' and resno=21 and atomname='O') color red
draw site1_b2 width 0.06 line {-2.948 3.031 4.130} (chain='A' and resno=20 and atomname='O') color red
draw site1_b3 width 0.06 line {-2.948 3.031 4.130} (chain='A' and resno=20 and atomname='OG1') color red
draw site1_b4 width 0.06 line {-2.948 3.031 4.130} (chain='A' and resno=22 and atomname='OG') color red
set echo site1_label {-2.948 3.031 4.130}
echo pyv 0.323
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
