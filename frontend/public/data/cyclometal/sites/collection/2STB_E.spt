# 2STB_E: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.067 A | donors E:ASN72:O;E:VAL75:O;E:GLU80:OE2;E:GLU77:OE1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tbp RMSD 0.320 A | donors E:ASN72:O;E:GLU77:OE1;E:GLU70:OE1;E:VAL75:O;E:GLU80:OE2 | metals: cobalt,copper,manganese,nickel

load "2STB_E.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.067 A) ----
select (resno=72 or resno=75 or resno=77 or resno=80) and chain='E'
wireframe 0.18
color wireframe cpk
select (resno=72 or resno=75 or resno=77 or resno=80) and chain='E' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {9.866 40.044 22.490} color red
draw site1_b1 width 0.06 line {9.866 40.044 22.490} (chain='E' and resno=72 and atomname='O') color red
draw site1_b2 width 0.06 line {9.866 40.044 22.490} (chain='E' and resno=75 and atomname='O') color red
draw site1_b3 width 0.06 line {9.866 40.044 22.490} (chain='E' and resno=80 and atomname='OE2') color red
draw site1_b4 width 0.06 line {9.866 40.044 22.490} (chain='E' and resno=77 and atomname='OE1') color red
set echo site1_label {9.866 40.044 22.490}
echo bvp 0.067
color echo black
font echo 18

# ---- Site 2: tbp (RMSD 0.320 A) ----
select (resno=70 or resno=72 or resno=75 or resno=77 or resno=80) and chain='E'
wireframe 0.18
color wireframe cpk
select (resno=70 or resno=72 or resno=75 or resno=77 or resno=80) and chain='E' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {9.907 40.142 22.665} color blue
draw site2_b1 width 0.06 line {9.907 40.142 22.665} (chain='E' and resno=72 and atomname='O') color blue
draw site2_b2 width 0.06 line {9.907 40.142 22.665} (chain='E' and resno=77 and atomname='OE1') color blue
draw site2_b3 width 0.06 line {9.907 40.142 22.665} (chain='E' and resno=70 and atomname='OE1') color blue
draw site2_b4 width 0.06 line {9.907 40.142 22.665} (chain='E' and resno=75 and atomname='O') color blue
draw site2_b5 width 0.06 line {9.907 40.142 22.665} (chain='E' and resno=80 and atomname='OE2') color blue
set echo site2_label {9.907 40.142 22.665}
echo tbp 0.320
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
