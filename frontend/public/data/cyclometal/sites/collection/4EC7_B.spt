# 4EC7_B: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.207 A | donors B:THR25:OG1;B:ALA26:O;B:THR27:OG1;B:THR33:OG1 | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bva RMSD 0.331 A | donors B:MET90:SD;B:THR35:O;B:VAL36:O;B:THR35:OG1 | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "4EC7_B.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.207 A) ----
select (resno=25 or resno=26 or resno=27 or resno=33) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=25 or resno=26 or resno=27 or resno=33) and chain='B' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {16.240 40.465 27.215} color red
draw site1_b1 width 0.06 line {16.240 40.465 27.215} (chain='B' and resno=25 and atomname='OG1') color red
draw site1_b2 width 0.06 line {16.240 40.465 27.215} (chain='B' and resno=26 and atomname='O') color red
draw site1_b3 width 0.06 line {16.240 40.465 27.215} (chain='B' and resno=27 and atomname='OG1') color red
draw site1_b4 width 0.06 line {16.240 40.465 27.215} (chain='B' and resno=33 and atomname='OG1') color red
set echo site1_label {16.240 40.465 27.215}
echo pyv 0.207
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.331 A) ----
select (resno=35 or resno=36 or resno=90) and chain='B'
wireframe 0.18
color wireframe cpk
select (resno=35 or resno=36 or resno=90) and chain='B' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {24.376 44.605 21.649} color blue
draw site2_b1 width 0.06 line {24.376 44.605 21.649} (chain='B' and resno=90 and atomname='SD') color blue
draw site2_b2 width 0.06 line {24.376 44.605 21.649} (chain='B' and resno=35 and atomname='O') color blue
draw site2_b3 width 0.06 line {24.376 44.605 21.649} (chain='B' and resno=36 and atomname='O') color blue
draw site2_b4 width 0.06 line {24.376 44.605 21.649} (chain='B' and resno=35 and atomname='OG1') color blue
set echo site2_label {24.376 44.605 21.649}
echo bva 0.331
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
