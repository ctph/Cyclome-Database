# 3C05_C: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.320 A | donors C:GLY44:O;C:ASN46:O;C:ASP48:OD1;C:ALA42:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): bva RMSD 0.469 A | donors C:ASN46:O;C:ARG43:O;C:ALA42:O;C:GLY44:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "3C05_C.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.320 A) ----
select (resno=42 or resno=44 or resno=46 or resno=48) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=42 or resno=44 or resno=46 or resno=48) and chain='C' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {61.598 74.240 55.531} color red
draw site1_b1 width 0.06 line {61.598 74.240 55.531} (chain='C' and resno=44 and atomname='O') color red
draw site1_b2 width 0.06 line {61.598 74.240 55.531} (chain='C' and resno=46 and atomname='O') color red
draw site1_b3 width 0.06 line {61.598 74.240 55.531} (chain='C' and resno=48 and atomname='OD1') color red
draw site1_b4 width 0.06 line {61.598 74.240 55.531} (chain='C' and resno=42 and atomname='O') color red
set echo site1_label {61.598 74.240 55.531}
echo pyv 0.320
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.469 A) ----
select (resno=42 or resno=43 or resno=44 or resno=46) and chain='C'
wireframe 0.18
color wireframe cpk
select (resno=42 or resno=43 or resno=44 or resno=46) and chain='C' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {61.847 75.019 53.139} color blue
draw site2_b1 width 0.06 line {61.847 75.019 53.139} (chain='C' and resno=46 and atomname='O') color blue
draw site2_b2 width 0.06 line {61.847 75.019 53.139} (chain='C' and resno=43 and atomname='O') color blue
draw site2_b3 width 0.06 line {61.847 75.019 53.139} (chain='C' and resno=42 and atomname='O') color blue
draw site2_b4 width 0.06 line {61.847 75.019 53.139} (chain='C' and resno=44 and atomname='O') color blue
set echo site2_label {61.847 75.019 53.139}
