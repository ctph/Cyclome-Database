# 1WM7_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.335 A | donors A:GLU4:O;A:ASP5:OD2;A:THR2:O;A:GLU4:OE2 | metals: cobalt,copper,manganese,nickel,samarium
# Site 2 (blue): bva RMSD 0.439 A | donors A:THR2:O;A:ASP5:OD2;A:GLU4:OE2;A:GLU4:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "1WM7_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.335 A) ----
select (resno=2 or resno=4 or resno=5) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=4 or resno=5) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-8.667 -2.778 -3.140} color red
draw site1_b1 width 0.06 line {-8.667 -2.778 -3.140} (chain='A' and resno=4 and atomname='O') color red
draw site1_b2 width 0.06 line {-8.667 -2.778 -3.140} (chain='A' and resno=5 and atomname='OD2') color red
draw site1_b3 width 0.06 line {-8.667 -2.778 -3.140} (chain='A' and resno=2 and atomname='O') color red
draw site1_b4 width 0.06 line {-8.667 -2.778 -3.140} (chain='A' and resno=4 and atomname='OE2') color red
set echo site1_label {-8.667 -2.778 -3.140}
echo tet 0.335
color echo black
font echo 18

# ---- Site 2: bva (RMSD 0.439 A) ----
select (resno=2 or resno=4 or resno=5) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=2 or resno=4 or resno=5) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {-9.275 -3.201 -2.928} color blue
draw site2_b1 width 0.06 line {-9.275 -3.201 -2.928} (chain='A' and resno=2 and atomname='O') color blue
draw site2_b2 width 0.06 line {-9.275 -3.201 -2.928} (chain='A' and resno=5 and atomname='OD2') color blue
draw site2_b3 width 0.06 line {-9.275 -3.201 -2.928} (chain='A' and resno=4 and atomname='OE2') color blue
draw site2_b4 width 0.06 line {-9.275 -3.201 -2.928} (chain='A' and resno=4 and atomname='O') color blue
set echo site2_label {-9.275 -3.201 -2.928}
echo bva 0.439
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
