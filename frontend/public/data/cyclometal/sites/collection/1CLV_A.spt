# 1CLV_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bvp RMSD 0.217 A | donors A:GLN41:O;A:HIS15:NE2;A:SER43:OG;A:LEU16:O | metals: cobalt,copper,manganese,nickel
# Site 2 (blue): tet RMSD 0.242 A | donors A:LEU454:O;A:ASP460:O;A:SER456:O;A:THR406:O | metals: cobalt,copper,manganese,nickel,samarium

load "1CLV_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bvp (RMSD 0.217 A) ----
select (resno=15 or resno=16 or resno=41 or resno=43) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=15 or resno=16 or resno=41 or resno=43) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {36.752 27.267 6.137} color red
draw site1_b1 width 0.06 line {36.752 27.267 6.137} (chain='A' and resno=41 and atomname='O') color red
draw site1_b2 width 0.06 line {36.752 27.267 6.137} (chain='A' and resno=15 and atomname='NE2') color red
draw site1_b3 width 0.06 line {36.752 27.267 6.137} (chain='A' and resno=43 and atomname='OG') color red
draw site1_b4 width 0.06 line {36.752 27.267 6.137} (chain='A' and resno=16 and atomname='O') color red
set echo site1_label {36.752 27.267 6.137}
echo bvp 0.217
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.242 A) ----
select (resno=406 or resno=454 or resno=456 or resno=460) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=406 or resno=454 or resno=456 or resno=460) and chain='A' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {37.139 26.473 -26.491} color blue
draw site2_b1 width 0.06 line {37.139 26.473 -26.491} (chain='A' and resno=454 and atomname='O') color blue
draw site2_b2 width 0.06 line {37.139 26.473 -26.491} (chain='A' and resno=460 and atomname='O') color blue
draw site2_b3 width 0.06 line {37.139 26.473 -26.491} (chain='A' and resno=456 and atomname='O') color blue
draw site2_b4 width 0.06 line {37.139 26.473 -26.491} (chain='A' and resno=406 and atomname='O') color blue
set echo site2_label {37.139 26.473 -26.491}
echo tet 0.242
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
