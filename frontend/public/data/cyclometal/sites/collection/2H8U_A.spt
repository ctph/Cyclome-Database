# 2H8U_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): tet RMSD 0.347 A | donors A:GLU29:O;A:GLU37:O;A:GLU29:OE2;A:GLY35:O | metals: cobalt,copper,manganese,nickel,samarium

load "2H8U_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: tet (RMSD 0.347 A) ----
select (resno=29 or resno=35 or resno=37) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=29 or resno=35 or resno=37) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {1.833 19.093 14.293} color red
draw site1_b1 width 0.06 line {1.833 19.093 14.293} (chain='A' and resno=29 and atomname='O') color red
draw site1_b2 width 0.06 line {1.833 19.093 14.293} (chain='A' and resno=37 and atomname='O') color red
draw site1_b3 width 0.06 line {1.833 19.093 14.293} (chain='A' and resno=29 and atomname='OE2') color red
draw site1_b4 width 0.06 line {1.833 19.093 14.293} (chain='A' and resno=35 and atomname='O') color red
set echo site1_label {1.833 19.093 14.293}
echo tet 0.347
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
