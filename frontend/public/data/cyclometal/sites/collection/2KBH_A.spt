# 2KBH_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.392 A | donors A:ASN19:OD1;A:ASN19:O;A:ASP23:OD1;A:GLY34:O | metals: cobalt,copper,manganese,nickel

load "2KBH_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.392 A) ----
select (resno=19 or resno=23 or resno=34) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=19 or resno=23 or resno=34) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {3.868 -6.344 -18.423} color red
draw site1_b1 width 0.06 line {3.868 -6.344 -18.423} (chain='A' and resno=19 and atomname='OD1') color red
draw site1_b2 width 0.06 line {3.868 -6.344 -18.423} (chain='A' and resno=19 and atomname='O') color red
draw site1_b3 width 0.06 line {3.868 -6.344 -18.423} (chain='A' and resno=23 and atomname='OD1') color red
draw site1_b4 width 0.06 line {3.868 -6.344 -18.423} (chain='A' and resno=34 and atomname='O') color red
set echo site1_label {3.868 -6.344 -18.423}
echo pyv 0.392
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
