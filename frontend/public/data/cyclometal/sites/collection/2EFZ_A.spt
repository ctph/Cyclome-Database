# 2EFZ_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.297 A | donors A:HIS9:NE2;A:PHE5:O;A:GLY7:O;A:CYS8:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium

load "2EFZ_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.297 A) ----
select (resno=5 or resno=7 or resno=8 or resno=9) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=5 or resno=7 or resno=8 or resno=9) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-5.248 1.647 -1.541} color red
draw site1_b1 width 0.06 line {-5.248 1.647 -1.541} (chain='A' and resno=9 and atomname='NE2') color red
draw site1_b2 width 0.06 line {-5.248 1.647 -1.541} (chain='A' and resno=5 and atomname='O') color red
draw site1_b3 width 0.06 line {-5.248 1.647 -1.541} (chain='A' and resno=7 and atomname='O') color red
draw site1_b4 width 0.06 line {-5.248 1.647 -1.541} (chain='A' and resno=8 and atomname='O') color red
set echo site1_label {-5.248 1.647 -1.541}
echo bva 0.297
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
