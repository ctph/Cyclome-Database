# 1MAH_A: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.265 A | donors A:ASN100:OD1;A:TYR98:O;A:ASN150:OD1;A:SER148:O | metals: cobalt,copper,manganese,nickel

load "1MAH_A.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.265 A) ----
select (resno=98 or resno=100 or resno=148 or resno=150) and chain='A'
wireframe 0.18
color wireframe cpk
select (resno=98 or resno=100 or resno=148 or resno=150) and chain='A' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {33.212 18.294 184.622} color red
draw site1_b1 width 0.06 line {33.212 18.294 184.622} (chain='A' and resno=100 and atomname='OD1') color red
draw site1_b2 width 0.06 line {33.212 18.294 184.622} (chain='A' and resno=98 and atomname='O') color red
draw site1_b3 width 0.06 line {33.212 18.294 184.622} (chain='A' and resno=150 and atomname='OD1') color red
draw site1_b4 width 0.06 line {33.212 18.294 184.622} (chain='A' and resno=148 and atomname='O') color red
set echo site1_label {33.212 18.294 184.622}
echo pyv 0.265
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
