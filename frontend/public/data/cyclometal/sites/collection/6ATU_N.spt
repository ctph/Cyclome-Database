# 6ATU_N: CycloMetal-Geo accepted sites (CN >= 4, RMSD < 0.5 A)
# 2 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): bva RMSD 0.355 A | donors N:PRO8:O;N:SER10:OG;N:CYS44:O;N:VAL9:O | metals: cobalt,copper,europium,gadolinium,manganese,nickel,praseodymium,samarium,ytterbium
# Site 2 (blue): tet RMSD 0.375 A | donors N:GLY40:O;N:LYS42:O;N:CYS38:O;N:PRO39:O | metals: cobalt,copper,manganese,nickel,samarium

load "6ATU_N.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: bva (RMSD 0.355 A) ----
select (resno=8 or resno=9 or resno=10 or resno=44) and chain='N'
wireframe 0.18
color wireframe cpk
select (resno=8 or resno=9 or resno=10 or resno=44) and chain='N' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {-4.439 68.813 -23.288} color red
draw site1_b1 width 0.06 line {-4.439 68.813 -23.288} (chain='N' and resno=8 and atomname='O') color red
draw site1_b2 width 0.06 line {-4.439 68.813 -23.288} (chain='N' and resno=10 and atomname='OG') color red
draw site1_b3 width 0.06 line {-4.439 68.813 -23.288} (chain='N' and resno=44 and atomname='O') color red
draw site1_b4 width 0.06 line {-4.439 68.813 -23.288} (chain='N' and resno=9 and atomname='O') color red
set echo site1_label {-4.439 68.813 -23.288}
echo bva 0.355
color echo black
font echo 18

# ---- Site 2: tet (RMSD 0.375 A) ----
select (resno=38 or resno=39 or resno=40 or resno=42) and chain='N'
wireframe 0.18
color wireframe cpk
select (resno=38 or resno=39 or resno=40 or resno=42) and chain='N' and carbon
color wireframe blue
draw site2_center sphere diameter 1.4 {2.880 65.048 -31.210} color blue
draw site2_b1 width 0.06 line {2.880 65.048 -31.210} (chain='N' and resno=40 and atomname='O') color blue
draw site2_b2 width 0.06 line {2.880 65.048 -31.210} (chain='N' and resno=42 and atomname='O') color blue
draw site2_b3 width 0.06 line {2.880 65.048 -31.210} (chain='N' and resno=38 and atomname='O') color blue
draw site2_b4 width 0.06 line {2.880 65.048 -31.210} (chain='N' and resno=39 and atomname='O') color blue
set echo site2_label {2.880 65.048 -31.210}
echo tet 0.375
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
