# 1 unique site(s). Generated by make_jmol_scripts.py
#
# Site 1 (red): pyv RMSD 0.461 A | donors D:SER90:O;D:MET91:SD;D:MET108:SD;D:MET89:SD | metals: cobalt,copper,manganese,nickel

load "1S4Y_D.pdb"

background white
select all
spacefill off
wireframe off
cartoon only
color cartoon translucent [x999999]

# ---- Site 1: pyv (RMSD 0.461 A) ----
select (resno=89 or resno=90 or resno=91 or resno=108) and chain='D'
wireframe 0.18
color wireframe cpk
select (resno=89 or resno=90 or resno=91 or resno=108) and chain='D' and carbon
color wireframe red
draw site1_center sphere diameter 1.4 {20.089 52.228 28.022} color red
draw site1_b1 width 0.06 line {20.089 52.228 28.022} (chain='D' and resno=90 and atomname='O') color red
draw site1_b2 width 0.06 line {20.089 52.228 28.022} (chain='D' and resno=91 and atomname='SD') color red
draw site1_b3 width 0.06 line {20.089 52.228 28.022} (chain='D' and resno=108 and atomname='SD') color red
draw site1_b4 width 0.06 line {20.089 52.228 28.022} (chain='D' and resno=89 and atomname='SD') color red
set echo site1_label {20.089 52.228 28.022}
echo pyv 0.461
color echo black
font echo 18

select all
center all
zoom 110
set antialiasDisplay true
